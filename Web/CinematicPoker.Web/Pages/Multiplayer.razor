@page "/multiplayer"
@using System.Text.Json.Serialization
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Dead Man's Hand — Multiplayer</PageTitle>

<div class="multiplayer-page">
    <canvas id="multiplayer-canvas"></canvas>
    <header class="multiplayer-header">
        <a class="multiplayer-back" href="/">← SALOON</a>
        <div class="brand">DEAD MAN'S <span>HAND</span></div>
        <div class="multiplayer-header-actions">
            <span class="multiplayer-room">TABLE @_roomCode</span>
            <button class="chip-btn" @onclick="TextAnotherFriend">TEXT FRIEND</button>
            <button class="chip-btn" @onclick="EmailAnotherFriend">EMAIL FRIEND</button>
        </div>
    </header>

    @if (!_nameSubmitted)
    {
        <div class="multiplayer-name-card">
            <div class="overlay-title">WHO'S DEALING?</div>
            <p>Enter your name before taking your seat at the table.</p>
            <input class="name-input" maxlength="16" placeholder="Your name"
                   @bind="_nameDraft" @bind:event="oninput" />
            <button class="act call" disabled="@string.IsNullOrWhiteSpace(_nameDraft)"
                    @onclick="JoinTable">TAKE YOUR SEAT</button>
        </div>
    }
    else if (_error != null)
    {
        <div class="multiplayer-message error">@_error</div>
    }
    else if (_state == null)
    {
        <div class="multiplayer-message">CONNECTING TO THE TABLE…</div>
    }
    else
    {
        <main class="multiplayer-table">
            <div class="multiplayer-status">@_state.Status</div>
            <div class="multiplayer-pot">POT <b>$@_state.Pot</b></div>
            <div class="multiplayer-board">
                @if (_state.Board.Length == 0)
                {
                    <span class="card-back">DEALING</span>
                }
                @foreach (string card in _state.Board)
                {
                    <span class="playing-card">@card</span>
                }
            </div>
            <div class="multiplayer-seats">
                @foreach (PlayerView player in _state.Players)
                {
                    <div class="multiplayer-seat @(player.Seat == _state.CurrentSeat ? "acting" : "")">
                        <div class="seat-name">@player.Name @if (player.IsHuman) { <span class="human-mark">HUMAN</span> }</div>
                        <div class="seat-meta">@((player.Connected) ? "ONLINE" : "WAITING") · $@player.Stack</div>
                        @if (player.Bet > 0) { <div class="seat-bet">BET $@player.Bet</div> }
                    </div>
                }
            </div>
            <div class="multiplayer-hand">
                <div class="hand-label">YOUR HAND</div>
                <div class="hand-cards">
                    @foreach (string card in _state.Hole)
                    {
                        <span class="playing-card large">@card</span>
                    }
                </div>
            </div>
            @if (_state.Legal != null)
            {
                <div class="multiplayer-actions">
                    @if (_state.Legal.Fold) { <button class="act fold" @onclick="FoldAction">FOLD</button> }
                    @if (_state.Legal.Check) { <button class="act check" @onclick="CheckAction">CHECK</button> }
                    @if (_state.Legal.Call) { <button class="act call" @onclick="CallAction">CALL $@_state.Legal.CallAmount</button> }
                    @if (_state.Legal.Bet || _state.Legal.Raise)
                    {
                        <button class="act bet" @onclick="AggressiveAction">@( _state.Legal.Bet ? "BET" : "RAISE") $@_state.Legal.Min</button>
                    }
                    @if (_state.Legal.AllIn) { <button class="act allin" @onclick="AllInAction">ALL-IN</button> }
                </div>
            }
            <p class="multiplayer-note">Beta table · up to five humans · NPCs fill the remaining seats</p>
        </main>
    }
    @if (!string.IsNullOrEmpty(_inviteNote))
    {
        <div class="multiplayer-invite-note" role="status">@_inviteNote</div>
    }
</div>

@code {
    private string _roomCode = "";
    private string _nameDraft = "";
    private string _error;
    private TableView _state;
    private DotNetObjectReference<Multiplayer> _callback;
    private bool _nameSubmitted;
    private bool _sceneReady;
    private string _inviteNote;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _roomCode = await JS.InvokeAsync<string>("pokerInvite.roomFromUrl");
        if (string.IsNullOrWhiteSpace(_roomCode))
        {
            _error = "This table needs an invite link with a room code.";
            StateHasChanged();
            return;
        }
        _callback = DotNetObjectReference.Create(this);
        StateHasChanged();
    }

    private async Task JoinTable()
    {
        if (string.IsNullOrWhiteSpace(_nameDraft)) return;
        _nameSubmitted = true;
        try
        {
            string playerName = await JS.InvokeAsync<string>("pokerProfile.loadName");
            playerName = _nameDraft.Trim();
            _state = await JS.InvokeAsync<TableView>(
                "pokerRealtime.start", _roomCode,
                string.IsNullOrWhiteSpace(playerName) ? "Friend" : playerName, _callback);
            await JS.InvokeVoidAsync("pokerScene.setPlayerSeat", _state.YourSeat);
            _sceneReady = await JS.InvokeAsync<bool>("pokerScene.init", "multiplayer-canvas");
            await JS.InvokeVoidAsync("pokerScene.focusSeat", _state.YourSeat);
            await PushScene();
        }
        catch (JSException ex)
        {
            _error = $"Could not connect to the multiplayer table: {ex.Message}";
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task ReceiveState(TableView state)
    {
        _state = state;
        _ = InvokeAsync(PushScene);
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private async Task PushScene()
    {
        if (!_sceneReady || _state == null) return;
        var seats = _state.Players.Select(player => new
        {
            seat = player.Seat,
            name = player.Name,
            stack = player.Stack,
            bet = player.Bet,
            folded = player.Folded,
            @out = false,
            active = !player.Folded,
            actor = player.Seat == _state.CurrentSeat,
            heat = 0.15,
            dealer = false,
            sb = false,
            bb = false,
            reveal = (string[])null,
            status = player.Connected ? "" : "waiting"
        }).ToArray();
        await JS.InvokeVoidAsync("pokerScene.update", new
        {
            pot = _state.Pot,
            actorSeat = _state.CurrentSeat,
            board = _state.Board.Select(CardPath).ToArray(),
            hole = _state.Hole.Select(CardPath).ToArray(),
            seats
        });
    }

    private static string CardPath(string card)
    {
        if (string.IsNullOrWhiteSpace(card) || card.Length < 2) return "img/cards/back.png";
        string rank = card[..^1] switch { "T" => "10", _ => card[..^1] };
        string suit = card[^1] switch
        {
            '♣' => "clubs", '♦' => "diamonds", '♥' => "hearts", '♠' => "spades",
            _ => "spades"
        };
        return $"img/cards/{suit}_{rank}.png";
    }

    private async Task Act(string action, long amount = 0)
    {
        try { await JS.InvokeVoidAsync("pokerRealtime.act", _roomCode, action, amount); }
        catch (JSException ex) { _error = ex.Message; }
    }

    private async Task TextAnotherFriend()
    {
        string url = await JS.InvokeAsync<string>("pokerInvite.url", _roomCode);
        string result = await JS.InvokeAsync<string>(
            "pokerInvite.text", url, "Your friend");
        _inviteNote = result == "opened"
            ? "Messages opened with this table link. Your friend will choose their own seat."
            : "Could not open Messages. Share this table URL manually.";
    }

    private async Task EmailAnotherFriend()
    {
        string url = await JS.InvokeAsync<string>("pokerInvite.url", _roomCode);
        string result = await JS.InvokeAsync<string>(
            "pokerInvite.email", url, "Your friend");
        _inviteNote = result == "opened"
            ? "Email composer opened with this table link."
            : "Could not open email. Copy the table URL manually.";
    }

    private Task AggressiveAction() =>
        Act(_state.Legal.Bet ? "bet" : "raise", _state.Legal.Min);

    private Task FoldAction() => Act("fold");
    private Task CheckAction() => Act("check");
    private Task CallAction() => Act("call");
    private Task AllInAction() => Act("allin");

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pokerRealtime.stop"); } catch (JSException) { }
        _callback?.Dispose();
    }

    public sealed class TableView
    {
        public string Room { get; set; } = "";
        public int YourSeat { get; set; }
        public int CurrentSeat { get; set; }
        public long Pot { get; set; }
        public string[] Board { get; set; } = Array.Empty<string>();
        public string[] Hole { get; set; } = Array.Empty<string>();
        public PlayerView[] Players { get; set; } = Array.Empty<PlayerView>();
        public LegalView Legal { get; set; }
        public string Status { get; set; } = "";
    }

    public sealed class PlayerView
    {
        public int Seat { get; set; }
        public string Name { get; set; } = "";
        public bool IsHuman { get; set; }
        public bool Connected { get; set; }
        public long Stack { get; set; }
        public long Bet { get; set; }
        public bool Folded { get; set; }
    }

    public sealed class LegalView
    {
        public bool Fold { get; set; }
        public bool Check { get; set; }
        public bool Call { get; set; }
        public long CallAmount { get; set; }
        public bool Bet { get; set; }
        public bool Raise { get; set; }
        public bool AllIn { get; set; }
        public long Min { get; set; }
    }
}
