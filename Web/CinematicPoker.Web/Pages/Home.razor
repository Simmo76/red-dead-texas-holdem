@page "/"
@using CinematicPoker.Engine.AI
@using CinematicPoker.Engine.Players
@using CinematicPoker.Engine.Poker
@using CinematicPoker.Engine.Simulation
@inject IJSRuntime JS

<PageTitle>Cinematic Poker</PageTitle>

<div class="game3d">

    <canvas id="poker-canvas"></canvas>

    @if (!_introStarted)
    {
        <div class="intro-overlay" @onclick="StartIntro">
            <div class="intro-title">CINEMATIC <span>POKER</span></div>
            <div class="intro-tap">TAP TO PLAY</div>
        </div>
    }
    <header class="topbar">
        <div class="brand">CINEMATIC <span>POKER</span></div>
        <div class="topbar-right">
            <button class="chip-btn" @onclick="CycleBackdrop">@_backdropName</button>
            <button class="chip-btn @(_muted ? "" : "active")" @onclick="ToggleMute">
                @(_muted ? "SOUND OFF" : "SOUND ON")
            </button>
            <button class="chip-btn @(_quickMode ? "active" : "")" @onclick="ToggleMode">
                @(_quickMode ? "QUICK PLAY" : "CINEMATIC")
            </button>
            <button class="chip-btn" @onclick="CycleDifficulty">@DifficultyNames[_difficulty]</button>
            <button class="chip-btn" @onclick="OpenExportPanel">EXPORT</button>
            <button class="chip-btn" @onclick="StartSession">RESTART</button>
        </div>
    </header>

    @if (Round != null)
    {
        <div class="hud-pot">POT&nbsp;<b>$@Round.PotTotal</b> <span class="hud-stack">· YOU&nbsp;<b>$@ShownStack(0)</b></span></div>

        <div class="hud-board @(_hudBoardExpanded ? "expanded" : "")"
             @onclick="ToggleHudBoard">
            <div class="hud-row">
                @* Dealt cards fill from the right so they hug the border,
                   aligned above the player's pair. *@
                @for (int i = 0; i < 5; i++)
                {
                    var dealt = i - (5 - _shownBoard.Count);
                    if (dealt >= 0)
                    {
                        <img class="hud-card" src="@CardImage(_shownBoard[dealt])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
            <div class="hud-row hud-hole">
                @{ IReadOnlyList<Card> hudHole = SeatOf(0) is { Folded: true } ? Array.Empty<Card>() : HoleCardsOf(0); }
                @for (int i = 0; i < 2; i++)
                {
                    if (i < hudHole.Count)
                    {
                        <img class="hud-card" src="@CardImage(hudHole[i])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
        </div>
    }

    @if (_banner != null)
    {
        <div class="banner">@_banner</div>
    }

    <aside class="log">
        @foreach (string line in _log)
        {
            <div class="log-line @(line.StartsWith("—") ? "hand-marker" : "")">@line</div>
        }
    </aside>

    <div class="actionbar">
        @if (_awaitingHuman && _legal != null && !_showSlider)
        {
            @if (_legal.CanFold)  { <button class="act fold" @onclick="() => Act(PlayerAction.Fold())">FOLD</button> }
            @if (_legal.CanCheck) { <button class="act check" @onclick="() => Act(PlayerAction.Check())">CHECK</button> }
            @if (_legal.CanCall)  { <button class="act call" @onclick="() => Act(PlayerAction.Call())">CALL $@_legal.CallAmount</button> }
            @if (_legal.CanBet)   { <button class="act bet" @onclick="OpenSlider">BET</button> }
            @if (_legal.CanRaise) { <button class="act bet" @onclick="OpenSlider">RAISE</button> }
            @if (_legal.CanAllIn) { <button class="act allin" @onclick="() => Act(PlayerAction.AllIn())">ALL-IN</button> }
        }
        else if (_awaitingHuman && _legal != null && _showSlider)
        {
            <div class="slider-panel">
                <input type="range" min="@_legal.MinBetOrRaiseTo" max="@_legal.MaxBetOrRaiseTo" step="5"
                       @bind="_sliderValue" @bind:event="oninput" />
                <div class="slider-row">
                    <span class="slider-amount">$@_sliderValue</span>
                    <button class="act small" @onclick="() => SetSlider(PotNow / 2)">½ POT</button>
                    <button class="act small" @onclick="() => SetSlider(PotNow)">POT</button>
                    <button class="act small" @onclick="() => SetSlider(_legal.MaxBetOrRaiseTo)">MAX</button>
                    <button class="act call" @onclick="ConfirmSlider">CONFIRM</button>
                    <button class="act small" @onclick="() => _showSlider = false">BACK</button>
                </div>
            </div>
        }
        else if (_game != null && !_sessionOver)
        {
            <div class="waiting">@_statusLine</div>
            @if (CanFastForward)
            {
                <button class="act ff" @onclick="FastForward" title="Skip to the next action">SKIP &#187;</button>
            }
        }
    </div>

    @if (_sessionOver)
    {
        <div class="overlay">
            <div class="overlay-box">
                <div class="overlay-title">@_sessionOverMessage</div>
                <div class="overlay-actions">
                    <button class="act call big" @onclick="OpenExportPanel">EXPORT STATS</button>
                    <button class="act call big" @onclick="StartSession">PLAY AGAIN</button>
                </div>
            </div>
        </div>
    }

    @if (_exportOpen)
    {
        <div class="overlay" @onclick="CloseExportPanel">
            <div class="overlay-box export-box" @onclick:stopPropagation="true">
                <div class="overlay-title">EXPORT STATS</div>
                <p class="export-blurb">
                    Send your session history and coaching notes as a .csv file via email or text
                    @if (_handLog.CompletedHandCount > 0)
                    {
                        <text> · @_handLog.CompletedHandCount hand@(_handLog.CompletedHandCount == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text> · no hands yet</text>
                    }
                </p>
                @if (!string.IsNullOrEmpty(_exportNote))
                {
                    <p class="export-note">@_exportNote</p>
                }
                <div class="export-actions">
                    <button class="act call" @onclick="ExportViaEmail" disabled="@(_handLog.CompletedHandCount == 0)">EMAIL CSV</button>
                    <button class="act bet" @onclick="ExportViaText" disabled="@(_handLog.CompletedHandCount == 0)">TEXT CSV</button>
                    <button class="act small" @onclick="ExportDownload" disabled="@(_handLog.CompletedHandCount == 0)">DOWNLOAD</button>
                    <button class="act small" @onclick="CloseExportPanel">CLOSE</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly (string Name, Func<AIProfile> Profile)[] Roster =
    {
        ("Davo", AIProfile.Maniac),
        ("Mick", AIProfile.Regular),
        ("Shazza", AIProfile.Rock),
        ("Bluey", AIProfile.CallingStation),
        ("Kev", AIProfile.Professional)
    };

    // ---------------------------------------------------------- difficulty

    private static readonly string[] DifficultyNames = { "AI EASY", "AI NORMAL", "AI HARD" };
    private int _difficulty = 1; // NORMAL

    private void CycleDifficulty()
    {
        _difficulty = (_difficulty + 1) % DifficultyNames.Length;
        if (_game == null) return;
        // Retune the live NPCs in place, mid-session: rebuild each personality
        // preset at the new difficulty and write it into the existing profile.
        for (int i = 0; i < Roster.Length; i++)
        {
            if (_game.GetPlayer(i + 1) is AIPlayer ai)
                CopyProfile(WithDifficulty(Roster[i].Profile()), ai.Profile);
        }
    }

    // Scales each personality's competence up or down without erasing what
    // makes them distinct: aggression and tightness stay untouched, only the
    // "how well do they actually play" parameters move.
    private AIProfile WithDifficulty(AIProfile p)
    {
        if (_difficulty == 0) // EASY: sloppier reads, more mistakes, tilts easily
        {
            p.Skill *= 0.45;
            p.PotOddsAccuracy *= 0.45;
            p.HandReadingAbility *= 0.45;
            p.PositionAwareness *= 0.5;
            p.OpponentAwareness *= 0.5;
            p.BluffFrequency *= 0.7;
            p.DecisionNoise = Math.Min(1, p.DecisionNoise + 0.15);
            p.TiltSensitivity = Math.Min(1, p.TiltSensitivity + 0.2);
        }
        else if (_difficulty == 2) // HARD: sharper reads, fewer mistakes, cool heads
        {
            p.Skill += (1 - p.Skill) * 0.55;
            p.PotOddsAccuracy += (1 - p.PotOddsAccuracy) * 0.55;
            p.HandReadingAbility += (1 - p.HandReadingAbility) * 0.55;
            p.PositionAwareness += (1 - p.PositionAwareness) * 0.5;
            p.OpponentAwareness += (1 - p.OpponentAwareness) * 0.5;
            p.DecisionNoise *= 0.35;
            p.TiltSensitivity *= 0.5;
        }
        return p;
    }

    private static void CopyProfile(AIProfile from, AIProfile into)
    {
        into.Skill = from.Skill;
        into.Aggression = from.Aggression;
        into.Tightness = from.Tightness;
        into.BluffFrequency = from.BluffFrequency;
        into.RiskTolerance = from.RiskTolerance;
        into.TiltSensitivity = from.TiltSensitivity;
        into.PositionAwareness = from.PositionAwareness;
        into.OpponentAwareness = from.OpponentAwareness;
        into.PotOddsAccuracy = from.PotOddsAccuracy;
        into.HandReadingAbility = from.HandReadingAbility;
        into.DecisionNoise = from.DecisionNoise;
        into.EmotionalBias = from.EmotionalBias;
    }

    private PokerGame _game;
    private HandSequenceLog _handLog = new();
    private readonly Random _rng = new();
    private readonly Dictionary<int, IReadOnlyList<Card>> _revealed = new();
    private int _showdownHandCount; // hands compared at the current showdown
    private int _streetAggression;   // 0 none, 1 a bet, 2 a raise — picks "raise" vs "re-raise"
    private bool _dealerOpened;      // "texas hold'em" once per session, not every hand
    private readonly List<string> _log = new();

    // The engine resolves a hand synchronously (a call on the turn can deal
    // the river, reveal hands and award the pot in one burst), so its events
    // are queued here and presented one at a time with dwell pauses. These
    // hold what the table currently SHOWS, which can lag the engine state.
    private readonly Queue<PokerEvent> _pending = new();
    private readonly List<Card> _shownBoard = new();

    private LegalActions _legal;
    private bool _awaitingHuman;
    private bool _showSlider;
    private long _sliderValue;
    private bool _quickMode;
    private bool _sessionOver;
    private bool _hudBoardExpanded;
    private bool _exportOpen;
    private string _exportNote = "";
    private string _sessionOverMessage = "";
    private string _banner;
    private string _statusLine = "";
    private int _loopToken;

    private PokerRound Round => _game?.CurrentRound;
    private long PotNow => Round?.PotTotal ?? 0;

    // ------------------------------------------------------- fast forward

    // Once the player has folded they're only spectating, so a SKIP button
    // appears: each tap cuts short one pacing wait (an NPC's think time, or
    // a dwell pause before a street / showdown / pot award), stepping through
    // the rest of the hand action by action as fast as the player taps.
    private bool _skipRequested;

    private bool CanFastForward =>
        _game != null && !_sessionOver && !_awaitingHuman
        && SeatOf(0) is { Folded: true }
        && (_game.Phase == GamePhase.HandInProgress || _pending.Count > 0);

    private void FastForward() => _skipRequested = true;

    // A pacing wait the fast-forward button can cut short. Each tap skips at
    // most one wait, so skipped actions still land on the table one by one.
    private async Task PacedDelay(int ms, int token)
    {
        const int sliceMs = 50;
        for (int elapsed = 0; elapsed < ms; elapsed += sliceMs)
        {
            if (token != _loopToken) return;
            if (_skipRequested && CanFastForward)
            {
                _skipRequested = false;
                return;
            }
            await Task.Delay(sliceMs);
        }
        // The wait ran its course: drop any tap that was aimed at it so it
        // can't accidentally swallow the NEXT wait as well.
        _skipRequested = false;
    }

    // NPC turns are always at least 1 second apart so the table stays readable.
    private int ThinkTimeMs => _quickMode ? 1000 : _rng.Next(1000, 2200);
    private int NextHandDelayMs => _quickMode ? 700 : 2600;
    private const int EquityIterations = 200;

    protected override void OnInitialized() => StartSession();

    // -------------------------------------------------------- tap to play

    private bool _introStarted;
    private bool _introRequested;

    private async Task StartIntro()
    {
        if (_introRequested) return;
        _introRequested = true; // the tap doubles as the audio-unlock gesture
        // If the scene is still loading, keep the title card up until it's in.
        for (int i = 0; i < 24 && !_sceneReady; i++) await Task.Delay(250);
        _introStarted = true;
        // No opening camera sweep — go straight to the seated arcade view.
        try
        {
            await JS.InvokeVoidAsync("pokerScene.skipIntro");
        }
        catch (JSException)
        {
            // Scene module still loading; gameplay HUD is already live.
        }
    }

    // ------------------------------------------------------------- 3D scene

    private bool _sceneReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The scene module loads asynchronously; retry until it's there.
            for (int i = 0; i < 60 && !_sceneReady; i++)
            {
                try
                {
                    _sceneReady = await JS.InvokeAsync<bool>("pokerScene.init", "poker-canvas");
                }
                catch (JSException)
                {
                    await Task.Delay(250);
                }
            }
        }
        if (_sceneReady) await PushSceneState();
    }

    private async Task PushSceneState()
    {
        if (_game == null) return;

        var seats = _game.Players.Select(p =>
        {
            SeatState s = SeatOf(p.Seat);
            bool folded = s != null && s.Folded;
            bool eliminated = p.Status == PlayerStatus.Eliminated;
            bool acting = _game.CurrentSeat == p.Seat;
            string status =
                folded ? "folded"
                : s != null && s.AllIn ? "ALL-IN"
                : s != null && s.CommittedThisStreet > 0 ? $"bet ${s.CommittedThisStreet}"
                : acting && !p.IsHuman ? "thinking…"
                : "";
            return new
            {
                seat = p.Seat,
                name = p.Name,
                stack = ShownStack(p.Seat),
                bet = s?.CommittedThisStreet ?? 0,
                folded,
                @out = eliminated,
                actor = acting,
                active = s != null && !folded && !eliminated,
                heat = SeatHeat(p.Seat),
                dealer = Round != null && p.Seat == Round.DealerSeat,
                sb = Round != null && p.Seat == Round.SmallBlindSeat,
                bb = Round != null && p.Seat == Round.BigBlindSeat,
                reveal = p.Seat != 0 && _revealed.TryGetValue(p.Seat, out var shown)
                    ? shown.Select(CardImage).ToArray()
                    : null,
                status
            };
        }).ToArray();

        var snapshot = new
        {
            pot = Round?.PotTotal ?? 0,
            board = _shownBoard.Select(CardImage).ToArray(),
            // Folding mucks your cards: they leave your hand immediately.
            hole = SeatOf(0) is { Folded: true }
                ? Array.Empty<string>()
                : HoleCardsOf(0).Select(CardImage).ToArray(),
            seats
        };

        try { await JS.InvokeVoidAsync("pokerScene.update", snapshot); }
        catch (JSException) { /* scene not available; HUD still works */ }
    }

    private void SceneEmotion(int seat, string mood, double intensity)
    {
        if (!_sceneReady) return;
        _ = JS.InvokeVoidAsync("pokerScene.emotion", seat, mood, intensity);
    }

    // 0 = settled, 1 = steaming. Read from the NPC's tilt after each hand.
    private double SeatHeat(int seat)
    {
        if (_game?.GetPlayer(seat) is not AIPlayer ai) return 0.2;
        return Math.Clamp(
            ai.Tilt.Tilt * 0.55 + ai.Tilt.Frustration * 0.45 + (1 - ai.Tilt.Confidence) * 0.2,
            0, 1);
    }

    private double PotHeat(long amount)
    {
        long bb = Math.Max(1, _game?.Rules.BigBlind ?? 10);
        return Math.Clamp(amount / (double)(bb * 28), 0, 1);
    }

    // Anyone still in the hand, other than the actor, feels the bet.
    private void NudgeWaiting(int actorSeat, double intensity)
    {
        if (_game == null) return;
        foreach (PokerPlayer p in _game.Players)
        {
            if (p.IsHuman || p.Seat == actorSeat) continue;
            SeatState s = SeatOf(p.Seat);
            if (s == null || s.Folded || p.Status == PlayerStatus.Eliminated) continue;
            SceneEmotion(p.Seat, "wait", Math.Clamp(Math.Max(intensity, SeatHeat(p.Seat)), 0, 1));
        }
    }

    private void RememberHand(HandCompleted completed)
    {
        int biggest = -1;
        long best = long.MinValue;
        foreach (var kv in completed.StackChanges)
            if (kv.Value > best) { best = kv.Value; biggest = kv.Key; }
        long bb = Math.Max(1, _game.Rules.BigBlind);
        foreach (var kv in completed.StackChanges)
            if (_game.GetPlayer(kv.Key) is AIPlayer ai)
                ai.OnHandCompleted(kv.Value, bb, biggest);
    }

    // Unlike reactions, action gestures also play on the player's own body
    // (visible from the over-the-shoulder camera).
    private void SceneAction(int seat, string kind)
    {
        if (!_sceneReady) return;
        _ = JS.InvokeVoidAsync("pokerScene.action", seat, kind);
    }

    private void StartSession()
    {
        var rules = TableRules.Default;
        var players = new List<PokerPlayer> { new HumanPlayer("human", "You", seat: 0, stack: rules.StartingStack) };
        for (int i = 0; i < Roster.Length; i++)
        {
            players.Add(new AIPlayer($"npc{i}", Roster[i].Name, seat: i + 1, stack: rules.StartingStack,
                profile: WithDifficulty(Roster[i].Profile()), seed: _rng.Next()));
        }

        _game = new PokerGame(rules, players, seed: _rng.Next());
        _game.EventEmitted += OnEngineEvent;

        _handLog = new HandSequenceLog();
        _handLog.BeginSession(0, rules, players);

        _log.Clear();
        _revealed.Clear();
        _pending.Clear();
        _shownBoard.Clear();
        _banner = null;
        _sessionOver = false;
        _awaitingHuman = false;
        _showSlider = false;
        _skipRequested = false;
        _streetAggression = 0;
        _dealerOpened = false;
        _exportOpen = false;
        _exportNote = "";
        try { _ = JS.InvokeVoidAsync("pokerAudio.clearDealer"); }
        catch (InvalidOperationException) { /* first start, before the page can reach JS */ }
        catch (JSException) { }

        _ = RunLoop(++_loopToken);
    }

    /// <summary>
    /// Drives the session: NPC turns with think-time pacing, pauses for human
    /// input, auto-deals the next hand. Cancelled by token when restarting.
    /// </summary>
    private async Task RunLoop(int token)
    {
        while (token == _loopToken)
        {
            if (_game.IsSessionOver)
            {
                var winner = _game.AlivePlayers.Count > 0 ? _game.AlivePlayers[0].Name : "Nobody";
                _sessionOverMessage = winner == "You"
                    ? "You cleaned out the whole table!"
                    : $"{winner} takes the table. Rough night.";
                _sessionOver = true;
                StateHasChanged();
                return;
            }

            if (_game.Phase == GamePhase.WaitingForHand)
            {
                _statusLine = "Next hand…";
                StateHasChanged();
                await Task.Delay(NextHandDelayMs);
                if (token != _loopToken) return;
                _game.StartHand();
                await DrainEvents(token);
                continue;
            }

            PokerPlayer actor = _game.CurrentPlayer;
            if (actor == null) { await Task.Delay(50); continue; }

            if (actor.IsHuman)
            {
                _legal = _game.GetLegalActions();
                _sliderValue = _legal.MinBetOrRaiseTo;
                _awaitingHuman = true;
                StateHasChanged();
                return; // resumes via Act()
            }

            _statusLine = $"{actor.Name} is thinking…";
            StateHasChanged();
            await PacedDelay(ThinkTimeMs, token);
            if (token != _loopToken) return;

            var npc = (AIPlayer)actor;
            DecisionContext context = DecisionContext.ForCurrentActor(_game, EquityIterations);
            _game.SubmitAction(npc.DecideAction(context));
            await DrainEvents(token);
        }
    }

    private async Task Act(PlayerAction action)
    {
        if (!_awaitingHuman) return;
        try
        {
            _game.SubmitAction(action);
            _awaitingHuman = false;
            _showSlider = false;
        }
        catch (IllegalActionException)
        {
            return; // engine rejected it; keep waiting for a legal choice
        }
        StateHasChanged();
        await DrainEvents(_loopToken);
        await RunLoop(_loopToken);
    }

    private void OpenSlider()
    {
        _showSlider = true;
        _sliderValue = _legal.MinBetOrRaiseTo;
    }

    private void SetSlider(long amount) =>
        _sliderValue = Math.Clamp(amount, _legal.MinBetOrRaiseTo, _legal.MaxBetOrRaiseTo);

    private async Task ConfirmSlider()
    {
        long amount = _sliderValue;
        if (amount >= _legal.MaxBetOrRaiseTo) await Act(PlayerAction.AllIn());
        else if (_legal.CanBet) await Act(PlayerAction.Bet(amount));
        else await Act(PlayerAction.Raise(amount));
    }

    private void ToggleMode() => _quickMode = !_quickMode;

    // Tapping the community-cards window also brings the camera home to the
    // over-the-shoulder view, so it doubles as a "back to my seat" button.
    private async Task ToggleHudBoard()
    {
        _hudBoardExpanded = !_hudBoardExpanded;
        if (!_sceneReady) return;
        try { await JS.InvokeVoidAsync("pokerScene.resetCamera"); }
        catch (JSException) { /* scene not available; HUD still works */ }
    }

    // ------------------------------------------------------------- export CSV

    private void OpenExportPanel()
    {
        _exportNote = "";
        _exportOpen = true;
    }

    private void CloseExportPanel()
    {
        _exportOpen = false;
        _exportNote = "";
    }

    private string BuildExportCsv()
    {
        long currentStack = _game?.GetPlayer(0)?.Stack ?? TableRules.Default.StartingStack;
        return _handLog.BuildPlayerCsv(humanSeat: 0, new HandSequenceLog.PlayerExportMeta
        {
            StartingStack = TableRules.Default.StartingStack,
            CurrentStack = currentStack,
            Difficulty = DifficultyNames[_difficulty],
            PlayMode = _quickMode ? "QUICK PLAY" : "CINEMATIC",
            Backdrop = _backdropName
        });
    }

    private async Task ExportViaEmail()
    {
        if (_handLog.CompletedHandCount == 0) return;
        try
        {
            var result = await JS.InvokeAsync<ExportShareResult>(
                "pokerExport.emailCsv", BuildExportCsv(), "Cinematic Poker stats");
            _exportNote = ShareNote(result, "email");
        }
        catch (JSException)
        {
            _exportNote = "Could not open email. Try Download instead.";
        }
    }

    private async Task ExportViaText()
    {
        if (_handLog.CompletedHandCount == 0) return;
        try
        {
            var result = await JS.InvokeAsync<ExportShareResult>(
                "pokerExport.textCsv", BuildExportCsv());
            _exportNote = ShareNote(result, "message");
        }
        catch (JSException)
        {
            _exportNote = "Could not open messages. Try Download instead.";
        }
    }

    private static string ShareNote(ExportShareResult result, string channel) =>
        result == null ? "Something went wrong — try Download instead."
        : result.Aborted ? "Share cancelled — nothing was sent."
        : result.Shared ? "Share sheet opened — pick an app to send the .csv file."
        : $"CSV file downloaded — attach it to the {channel} that just opened.";

    private async Task ExportDownload()
    {
        if (_handLog.CompletedHandCount == 0) return;
        try
        {
            await JS.InvokeVoidAsync("pokerExport.downloadCsv", "cinematic-poker-stats.csv", BuildExportCsv());
            _exportNote = "CSV downloaded.";
        }
        catch (JSException)
        {
            _exportNote = "Download failed in this browser.";
        }
    }

    private sealed class ExportShareResult
    {
        public bool Ok { get; set; }
        public bool Shared { get; set; }
        public bool Aborted { get; set; }
        public bool Downloaded { get; set; }
    }

    // ------------------------------------------------------------- engine events

    // Events are only queued here; ApplyEvent presents them via DrainEvents.
    // The hand log records every event immediately so exports stay complete
    // even while the table is still animating a prior street.
    private void OnEngineEvent(PokerEvent evt)
    {
        _handLog.OnEvent(evt);
        _pending.Enqueue(evt);
    }

    /// <summary>
    /// Presents queued engine events in order, pausing before the dramatic
    /// ones (a dealt street, the showdown reveal, the pot award) — so the
    /// river card is on the table and readable BEFORE the winner is
    /// announced, instead of everything landing in one frame.
    /// </summary>
    private async Task DrainEvents(int token)
    {
        while (_pending.Count > 0)
        {
            if (token != _loopToken) return; // session restarted; new loop owns the queue
            ApplyEvent(_pending.Dequeue());
            int pause = PauseBefore(_pending.Count > 0 ? _pending.Peek() : null);
            if (pause > 0)
            {
                StateHasChanged();
                await PacedDelay(pause, token);
            }
        }
        StateHasChanged();
    }

    // Dwell time BEFORE presenting the given queued event: let the current
    // street sink in before hands are revealed, and the reveal sink in
    // before the pot is pushed.
    private int PauseBefore(PokerEvent next) => next switch
    {
        FlopDealt or TurnDealt or RiverDealt => _quickMode ? 900 : 1400,
        ShowdownStarted => _quickMode ? 1100 : 1800,
        PotAwarded => _quickMode ? 900 : 1500,
        _ => 0
    };

    // Stack as the table currently shows it: winnings (and returned uncalled
    // bets) that are still queued behind the reveal pauses are hidden, so
    // nobody's chip count gives away the result before it is announced.
    private long ShownStack(int seat)
    {
        long stack = SeatOf(seat)?.Stack ?? _game.GetPlayer(seat).Stack;
        foreach (PokerEvent evt in _pending)
        {
            if (evt is PotAwarded award && award.Payouts != null && award.Payouts.TryGetValue(seat, out long paid))
                stack -= paid;
            else if (evt is UncalledBetReturned ret && ret.Seat == seat)
                stack -= ret.Amount;
        }
        return stack;
    }

    private void ApplyEvent(PokerEvent evt)
    {
        PlaySoundFor(evt);
        Announce(evt);

        switch (evt)
        {
            case HandStarted started:
                _revealed.Clear();
                _shownBoard.Clear();
                _showdownHandCount = 0;
                _banner = null;
                AddLog($"— Hand {started.HandNumber} —");
                break;

            case FlopDealt flop:
                _shownBoard.Add(flop.Card1);
                _shownBoard.Add(flop.Card2);
                _shownBoard.Add(flop.Card3);
                AddLog(Describe(evt));
                break;

            case TurnDealt turn:
                _shownBoard.Add(turn.Card);
                AddLog(Describe(evt));
                break;

            case RiverDealt river:
                _shownBoard.Add(river.Card);
                AddLog(Describe(evt));
                break;

            case ShowdownStarted showdown:
                _showdownHandCount = showdown.RevealedHands.Count;
                foreach (var kv in showdown.RevealedHands)
                {
                    _revealed[kv.Key] = kv.Value;
                    if (kv.Key != 0)
                        AddLog($"{NameOf(kv.Key)} shows {string.Join(" ", kv.Value)}");
                }
                break;

            case PlayerChecked checkedEvt:
                SceneAction(checkedEvt.Seat, "check");
                AddLog($"{NameOf(checkedEvt.Seat)} checks");
                break;

            case PlayerFolded foldedEvt:
                SceneAction(foldedEvt.Seat, "fold");
                // Letting a big pot go stings. The fold plays first; the
                // disappointment follows when that gesture lets go.
                if (foldedEvt.Seat != 0 && Round != null && Round.PotTotal > _game.Rules.BigBlind * 16)
                    SceneEmotion(foldedEvt.Seat, "lose", 0.4);
                AddLog($"{NameOf(foldedEvt.Seat)} folds");
                break;

            case PotAwarded award:
            {
                double potHeat = PotHeat(award.Amount);
                foreach (int seatIdx in award.WinnerSeats)
                    SceneEmotion(seatIdx, "win", potHeat);
                if (award.WinningHand.HasValue)
                {
                    foreach (int seatIdx in _revealed.Keys)
                        if (!award.WinnerSeats.Contains(seatIdx))
                            SceneEmotion(seatIdx, "lose", Math.Max(0.5, potHeat));
                }
                // A heads-up showdown (exactly two hands compared) gets a
                // victory fanfare for whoever comes out on top.
                if (_showdownHandCount == 2 && !_muted)
                {
                    _ = JS.InvokeVoidAsync("pokerAudio.victory");
                    _showdownHandCount = 0; // once per showdown (side pots re-award)
                }
                // The player's own win gets the full show: fireworks + sparklers.
                if (award.WinnerSeats.Contains(0) && _sceneReady)
                {
                    _ = JS.InvokeVoidAsync("pokerScene.celebrate");
                }
                string winners = string.Join(" & ", award.WinnerSeats.Select(NameOf));
                _banner = award.WinningHand.HasValue
                    ? $"{winners} win{(award.WinnerSeats.Count == 1 ? "s" : "")} ${award.Amount} — {Pretty(award.WinningHand.Value.Category)}"
                    : $"{winners} take{(award.WinnerSeats.Count == 1 ? "s" : "")} ${award.Amount}";
                AddLog(_banner);
                break;
            }

            default:
                // Chip-toss gesture whenever someone puts chips in the middle.
                switch (evt)
                {
                    case PlayerCalled pc: SceneAction(pc.Seat, "call"); break;
                    case BetPlaced bp: SceneAction(bp.Seat, "bet"); break;
                    case PlayerRaised pr:
                        SceneAction(pr.Seat, "raise");
                        NudgeWaiting(pr.Seat, 0.5);
                        break;
                    case PlayerAllIn pa:
                        SceneAction(pa.Seat, "allin");
                        NudgeWaiting(pa.Seat, 0.85);
                        break;
                    case HandCompleted completed:
                        RememberHand(completed);
                        break;
                }
                string line = Describe(evt);
                if (line != null) AddLog(line);
                break;
        }
    }

    // Dealer calls from the owner-supplied voice pack. Dry takes, one clip
    // per thing a hold'em dealer would actually say at this table.
    private void Announce(PokerEvent evt)
    {
        switch (evt)
        {
            case HandStarted:
                _streetAggression = 0;
                if (!_dealerOpened)
                {
                    _dealerOpened = true;
                    PlayDealer("texas-hold-em");
                }
                break;
            case BlindPosted blind:
                PlayDealer(blind.IsAllIn ? "all-in" : blind.IsBigBlind ? "big-blind" : "small-blind");
                break;
            case PlayerChecked:
                PlayDealer("check");
                break;
            case PlayerCalled:
                PlayDealer("call");
                break;
            case BetPlaced:
                PlayDealer("bet");
                _streetAggression = 1;
                break;
            case PlayerRaised:
                // A raise of a raise is a re-raise. A raise after an opening
                // bet is still just a raise.
                PlayDealer(_streetAggression >= 2 ? "re-raise" : "raise");
                _streetAggression = 2;
                break;
            case PlayerFolded:
                PlayDealer("fold");
                break;
            case PlayerAllIn:
                PlayDealer("all-in");
                break;
            case FlopDealt:
                _streetAggression = 0;
                PlayDealer("flop");
                break;
            case TurnDealt:
                _streetAggression = 0;
                PlayDealer("turn");
                break;
            case RiverDealt:
                _streetAggression = 0;
                PlayDealer("river");
                break;
            case ShowdownStarted:
                PlayDealer("showdown");
                break;
            case PotAwarded award:
                if (award.PotIndex > 0) PlayDealer("side-pot");
                if (award.WinningHand.HasValue)
                    PlayDealer(HandClip(award.WinningHand.Value.Category));
                if (award.WinnerSeats.Count > 1)
                    PlayDealer("split");
                else if (award.WinnerSeats.Contains(0))
                    PlayDealer("you-win-the-pot");
                break;
        }
    }

    private static string HandClip(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high-card",
        HandCategory.Pair => "pair",
        HandCategory.TwoPair => "two-pair",
        HandCategory.ThreeOfAKind => "three-of-a-kind",
        HandCategory.Straight => "straight",
        HandCategory.Flush => "flush",
        HandCategory.FullHouse => "full-house",
        HandCategory.FourOfAKind => "four-of-a-kind",
        HandCategory.StraightFlush => "straight-flush",
        HandCategory.RoyalFlush => "royal-flush",
        _ => null
    };

    private void PlayDealer(string clip)
    {
        if (_muted || string.IsNullOrEmpty(clip)) return;
        try { _ = JS.InvokeVoidAsync("pokerAudio.dealer", clip); }
        catch (JSException) { }
    }

    private string Describe(PokerEvent evt) => evt switch
    {
        BlindPosted b => $"{NameOf(b.Seat)} posts {(b.IsBigBlind ? "big blind" : "small blind")} ${b.Amount}",
        PlayerChecked c => $"{NameOf(c.Seat)} checks",
        PlayerCalled c => $"{NameOf(c.Seat)} calls ${c.AddedAmount}",
        BetPlaced b => $"{NameOf(b.Seat)} bets ${b.ToAmount}",
        PlayerRaised r => $"{NameOf(r.Seat)} raises to ${r.ToAmount}",
        PlayerFolded f => $"{NameOf(f.Seat)} folds",
        PlayerAllIn a => $"{NameOf(a.Seat)} is ALL-IN (${a.ToAmount})",
        UncalledBetReturned u => $"${u.Amount} returned to {NameOf(u.Seat)}",
        FlopDealt f => $"Flop: {f.Card1} {f.Card2} {f.Card3}",
        TurnDealt t => $"Turn: {t.Card}",
        RiverDealt r => $"River: {r.Card}",
        PlayerEliminated e => $"{NameOf(e.Seat)} is eliminated!",
        _ => null
    };

    private void AddLog(string line)
    {
        _log.Insert(0, line);
        while (_log.Count > 60) _log.RemoveAt(_log.Count - 1);
    }

    // ------------------------------------------------------------------ helpers

    private string NameOf(int seat) => _game.GetPlayer(seat).Name;

    private static string Pretty(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high card",
        HandCategory.Pair => "a pair",
        HandCategory.TwoPair => "two pair",
        HandCategory.ThreeOfAKind => "three of a kind",
        HandCategory.Straight => "a straight",
        HandCategory.Flush => "a flush",
        HandCategory.FullHouse => "a full house",
        HandCategory.FourOfAKind => "four of a kind",
        HandCategory.StraightFlush => "a straight flush",
        HandCategory.RoyalFlush => "a ROYAL FLUSH",
        _ => category.ToString()
    };

    private SeatState SeatOf(int seat)
    {
        if (Round == null) return null;
        foreach (SeatState s in Round.Seats)
            if (s.Seat == seat) return s;
        return null;
    }

    private IReadOnlyList<Card> HoleCardsOf(int seat) =>
        SeatOf(seat)?.HoleCards ?? (IReadOnlyList<Card>)Array.Empty<Card>();

    // Kenney boardgame pack card faces (CC0) — see ASSET_LICENSES.md.
    private static string CardImage(Card card)
    {
        string rank = card.Rank == Rank.Ten ? "10" : Card.RankSymbol(card.Rank);
        return $"img/cards/{card.Suit.ToString().ToLowerInvariant()}_{rank}.png";
    }

    // -------------------------------------------------------------- backdrop

    private string _backdropName = "ARCADE";

    private async Task CycleBackdrop()
    {
        _backdropName = await JS.InvokeAsync<string>("pokerScene.cycleBackdrop");
        // Each backdrop brings its own music bed (beach/western/disco/saloon).
        await JS.InvokeVoidAsync("pokerAudio.setScene", _backdropName);
    }

    // -------------------------------------------------------------- sounds

    private bool _muted;

    private void ToggleMute()
    {
        _muted = !_muted;
        _ = JS.InvokeVoidAsync("pokerAudio.setMuted", _muted);
    }

    private static readonly Dictionary<string, string[]> SoundGroups = new()
    {
        ["shuffle"] = new[] { "card-shuffle" },
        ["deal"] = new[] { "card-slide-1", "card-slide-2", "card-slide-3" },
        ["place"] = new[] { "card-place-1", "card-place-2" },
        ["fold"] = new[] { "card-shove-1" },
        ["chips"] = new[] { "chips-stack-1", "chips-stack-2", "chips-stack-3" },
        ["raise"] = new[] { "chips-handle-1", "chips-handle-2" },
        ["allin"] = new[] { "chips-collide-1", "chips-collide-2" }
    };

    private int _dealSoundIndex;

    private void PlaySound(string group, int delayMs = 0)
    {
        if (_muted) return;
        string[] variants = SoundGroups[group];
        _ = JS.InvokeVoidAsync("pokerAudio.play", variants[_rng.Next(variants.Length)], delayMs);
    }

    private void PlaySoundFor(PokerEvent evt)
    {
        // Your two cards land audibly after the shuffle, not on top of it.
        if (evt is HandStarted) _dealSoundIndex = 0;
        if (evt is CardDealt dealtCard && dealtCard.Seat == 0)
        {
            PlaySound("place", 700 + _dealSoundIndex++ * 280);
            return;
        }

        string group = evt switch
        {
            HandStarted _ => "shuffle",
            FlopDealt _ => "deal",
            TurnDealt _ => "deal",
            RiverDealt _ => "deal",
            BetPlaced _ => "chips",
            PlayerCalled _ => "chips",
            PlayerRaised _ => "raise",
            PlayerAllIn _ => "allin",
            PlayerFolded _ => "fold",
            PotAwarded _ => "allin", // big pile of chips pushed to the winner
            _ => null
        };
        if (group != null) PlaySound(group);
    }
}
