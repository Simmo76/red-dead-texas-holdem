    // ------------------------------------------------------------- engine events

    // Events are only queued here; ApplyEvent presents them via DrainEvents.
    // The hand log records every event immediately so exports stay complete
    // even while the table is still animating a prior street.
    private void OnEngineEvent(PokerEvent evt)
    {
        GameLog.Info("game", GameLog.Describe(evt));
        _handLog.OnEvent(evt);
        // Fold the settled hand into the durable archive right away so the
        // export history survives restarts, reloads, and new tables.
        if (evt is HandCompleted) ArchiveStatsHistory();
        ObserveCoach(evt);
        _pending.Enqueue(evt);
    }

    /// <summary>
    /// Presents queued engine events in order, pausing before the dramatic
    /// ones (a dealt street, the showdown reveal, the pot award) — so the
    /// river card is on the table and readable BEFORE the winner is
    /// announced, instead of everything landing in one frame.
    /// </summary>
    private async Task DrainEvents(int token)
    {
        while (_pending.Count > 0)
        {
            if (token != _loopToken) return; // session restarted; new loop owns the queue
            PokerEvent evt = _pending.Dequeue();
            ApplyEvent(evt);
            StateHasChanged();
            int after = PauseAfter(evt);
            if (after > 0)
                await PacedDelay(after, token);
            if (token != _loopToken) return;
            PokerEvent next = _pending.Count > 0 ? _pending.Peek() : null;
            int before = PauseBefore(next);
            if (before > 0)
            {
                string beat = PendingBeatStatus(next);
                if (beat != null)
                {
                    _statusLine = beat;
                    StateHasChanged();
                }
                await PacedDelay(before, token);
            }
        }
        StateHasChanged();
    }

    // The hand-compare strip (every seat still in the hand, including the
    // player's) is what is on screen from the reveal until the pot banner
    // replaces it. Three seats wrap, so the third hand sits below the fold
    // and has to be scrolled into view. That whole beat — the reveal dwell,
    // the breath before the pot is pushed, and the pot push itself while
    // the strip is still up — stays readable for ShowdownReadScale times
    // the original pacing. Fold-wins never show that strip, so they keep
    // the shorter pot timing.
    private const int ShowdownReadScale = 2;

    // Dwell time BEFORE presenting the given queued event: let the current
    // street sink in before hands are revealed, and the reveal sink in
    // before the pot is pushed. DrainEvents narrates these in the status
    // line so the pause reads as pacing, not as the game stalling while it
    // "works out the winner".
    private int PauseBefore(PokerEvent next) => next switch
    {
        FlopDealt or TurnDealt or RiverDealt => _quickMode ? 900 : 1400,
        ShowdownStarted => _quickMode ? 800 : 1200,
        PotAwarded when _showdownView.Count > 0 => (_quickMode ? 500 : 800) * ShowdownReadScale,
        PotAwarded => _quickMode ? 500 : 800,
        _ => 0
    };

    // Extra dwell AFTER the current event is on screen. ShowdownStarted is
    // the time to read every revealed hand. A showdown pot award keeps that
    // same strip up (winners marked) until HandCompleted brings the result
    // banner, which hides the strip; both of those dwells are scaled.
    // The banner itself then holds until NEXT HAND is tapped.
    private int PauseAfter(PokerEvent evt) => evt switch
    {
        ShowdownStarted => (_quickMode ? 1400 : 2200) * ShowdownReadScale,
        PotAwarded award when award.WinningHand.HasValue => (award.WinnerSeats.Contains(0)
            ? (_quickMode ? 1600 : 2400)
            : (_quickMode ? 1200 : 1800)) * ShowdownReadScale,
        PotAwarded award => award.WinnerSeats.Contains(0)
            ? (_quickMode ? 1600 : 2400)
            : (_quickMode ? 1200 : 1800),
        _ => 0
    };

    // What the status line says while the table holds its breath before a
    // dramatic beat. Without this the line still shows the last actor's
    // "thinking…" through the dwells, which looks like the game has
    // stalled computing the result.
    private static string PendingBeatStatus(PokerEvent next) => next switch
    {
        FlopDealt or TurnDealt or RiverDealt => "Dealing…",
        ShowdownStarted => "Showdown!",
        PotAwarded => "And the pot goes to…",
        _ => null
    };

    // Stack as the table currently shows it: winnings (and returned uncalled
    // bets) that are still queued behind the reveal pauses are hidden, so
    // nobody's chip count gives away the result before it is announced.
    private long ShownStack(int seat)
    {
        long stack = SeatOf(seat)?.Stack ?? _game.GetPlayer(seat).Stack;
        foreach (PokerEvent evt in _pending)
        {
            if (evt is PotAwarded award && award.Payouts != null && award.Payouts.TryGetValue(seat, out long paid))
                stack -= paid;
            else if (evt is UncalledBetReturned ret && ret.Seat == seat)
                stack -= ret.Amount;
        }
        return stack;
    }

    // Eliminations are applied in the engine as soon as the pot is awarded,
    // which is before this table has shown the hole cards or the dollar
    // amount. Hide OUT until those events have been presented.
    private bool ShownOut(int seat)
    {
        if (_game.GetPlayer(seat).Status != PlayerStatus.Eliminated) return false;
        foreach (PokerEvent evt in _pending)
        {
            if (evt is PotAwarded or HandCompleted or PlayerEliminated)
                return false;
        }
        return true;
    }

    private void ApplyEvent(PokerEvent evt)
    {
        PlaySoundFor(evt);

        switch (evt)
        {
            case HandStarted started:
                _revealed.Clear();
                _shownBoard.Clear();
                _showdownView.Clear();
                _awardsThisHand.Clear();
                _victoryPlayedThisHand = false;
                _playerLossPlayedThisHand = false;
                _banner = null;
                _bannerReason = null;
                _bannerAmount = null;
                _playerWonPot = false;
                _shotBusy = false;
                _shotStatus = null;
                _pendingFocusSeat = -1;
                _handHasCompleted = false;
                if (_sceneReady)
                {
                    try { _ = JS.InvokeVoidAsync("pokerScene.resetCamera"); }
                    catch (JSException) { }
                }
                break;

            case FlopDealt flop:
                _shownBoard.Add(flop.Card1);
                _shownBoard.Add(flop.Card2);
                _shownBoard.Add(flop.Card3);
                break;

            case TurnDealt turn:
                _shownBoard.Add(turn.Card);
                break;

            case RiverDealt river:
                _shownBoard.Add(river.Card);
                break;

            case ShowdownStarted showdown:
                _statusLine = "Showdown — read their cards";
                _showdownView.Clear();
                foreach (var kv in showdown.RevealedHands.OrderBy(h => h.Key))
                    RememberShownHand(kv.Key, kv.Value, winner: false);
                _pendingFocusSeat = FirstOpponentRevealSeat();
                break;

            case PlayerChecked checkedEvt:
                SceneAction(checkedEvt.Seat, "check");
                break;

            case PlayerFolded foldedEvt:
                SceneAction(foldedEvt.Seat, "fold");
                // Letting a big pot go stings. The fold plays first; the
                // disappointment follows when that gesture lets go.
                // Don't fire a second voice — the fold line already spoke.
                if (foldedEvt.Seat != 0 && Round != null && Round.PotTotal > _game.Rules.BigBlind * 16)
                    SceneEmotion(foldedEvt.Seat, "lose", 0.4, speak: false);
                break;

            case PotAwarded award:
            {
                _awardsThisHand.Add(award);
                // Session-best pot for the table-win overlay's stat line.
                if (award.Payouts != null && award.Payouts.TryGetValue(0, out long playerCut))
                    _biggestPotWon = Math.Max(_biggestPotWon, playerCut);
                double potHeat = PotHeat(award.Amount);
                // Body takes on every winner/loser; only one NPC speaks so the
                // table doesn't stack the same sayings on top of each other.
                bool spoken = false;
                foreach (int seatIdx in award.WinnerSeats)
                {
                    // Opponent win lines can be addressed to the player
                    // ("you win"), so keep them silent when the player lost.
                    // The opponent still gets the full visual win reaction.
                    bool speak = !spoken && seatIdx != 0 && award.WinnerSeats.Contains(0);
                    SceneEmotion(seatIdx, "win", potHeat, speak);
                    if (speak) spoken = true;
                }
                if (award.WinningHand.HasValue)
                {
                    foreach (int seatIdx in _revealed.Keys)
                    {
                        if (award.WinnerSeats.Contains(seatIdx)) continue;
                        bool speak = !spoken && seatIdx != 0;
                        SceneEmotion(seatIdx, "lose", Math.Max(0.5, potHeat), speak);
                        if (speak) spoken = true;
                    }
                }
                // The player's own win gets the full show: fireworks + sparklers,
                // and the dealer names the winning hand (full house, straight, …).
                // Stay on the table camera so opponent hole cards remain in view.
                if (award.WinnerSeats.Contains(0))
                {
                    // Play once for any player win, including multiway/all-in
                    // pots and wins by fold. Previously this was gated on
                    // exactly two revealed hands, which silently omitted the
                    // first-hand all-in path when the engine revealed more
                    // than two players (and all fold-wins).
                    PlayVictory();
                    if (_sceneReady)
                        _ = JS.InvokeVoidAsync("pokerScene.celebrate");
                    if (award.WinningHand.HasValue)
                        PlayDealer(HandClip(award.WinningHand.Value.Category));
                }
                foreach (ShowdownRow row in _showdownView)
                    row.Winner = award.WinnerSeats.Contains(row.Seat);
                // Fold-wins never emit ShowdownStarted, so the winner's hole
                // cards were never put on the felt or in the HUD. Show them
                // anyway — this is a single-player table, and "someone else
                // won" is exactly when you need to see what they held.
                if (_showdownView.Count == 0)
                {
                    foreach (int seatIdx in award.WinnerSeats)
                        RememberShownHand(seatIdx, HoleCardsOf(seatIdx), winner: true);
                }
                if (!award.WinnerSeats.Contains(0))
                    _pendingFocusSeat = FirstOpponentRevealSeat(award.WinnerSeats);
                break;
            }

            default:
                // Chip-toss gesture whenever someone puts chips in the middle.
                switch (evt)
                {
                    case PlayerCalled pc: SceneAction(pc.Seat, "call"); break;
                    case BetPlaced bp: SceneAction(bp.Seat, "bet"); break;
                    case PlayerRaised pr:
                        SceneAction(pr.Seat, "raise");
                        NudgeWaiting(pr.Seat, 0.5);
                        break;
                    case PlayerAllIn pa:
                        SceneAction(pa.Seat, "allin");
                        NudgeWaiting(pa.Seat, 0.85);
                        break;
                    case HandCompleted completed:
                        RememberHand(completed);
                        PresentHandResult(completed);
                        _handHasCompleted = true;
                        NoteCoachHandReady();
                        break;
                }
                break;
        }
    }

    // ------------------------------------------------------------------ helpers

    private void PresentHandResult(HandCompleted completed)
    {
        long stackChange = completed.StackChanges != null
            && completed.StackChanges.TryGetValue(0, out long change)
            ? change
            : 0;
        _playerWonPot = stackChange > 0;
        if (stackChange < 0)
            PlayPlayerLoss();

        PotAwarded mainAward = _awardsThisHand.FirstOrDefault(a => a.PotIndex == 0)
            ?? _awardsThisHand.LastOrDefault();
        HandValue? winningHand = mainAward?.WinningHand;
        var winners = _awardsThisHand
            .SelectMany(a => a.WinnerSeats ?? Array.Empty<int>())
            .Distinct()
            .ToList();
        string winnerNames = string.Join(" & ", winners.Select(s => s == 0 ? "You" : NameOf(s)));
        long humanPayout = _awardsThisHand
            .Where(a => a.Payouts != null)
            .Sum(a => a.Payouts.TryGetValue(0, out long paid) ? paid : 0);
        long totalAwarded = _awardsThisHand.Sum(a => a.Amount);

        _bannerAmount = _playerWonPot && humanPayout > 0
            ? humanPayout
            : totalAwarded > 0 ? totalAwarded : null;

        if (_playerWonPot)
        {
            _banner = winningHand.HasValue
                ? $"YOU WON with {Pretty(winningHand.Value.Category)}"
                : "YOU WON — everyone folded";
            _bannerReason = null;
        }
        // "Broke even" is only a split when the player actually shared the
        // pot. A player who folded without paying anything also ends the
        // hand at +/- 0, and that hand belongs to whoever took the pot.
        else if (stackChange == 0 && winners.Contains(0))
        {
            _banner = "POT SPLIT";
            _bannerReason = winningHand.HasValue
                ? $"Split with {Pretty(winningHand.Value.Category)}"
                : null;
        }
        else
        {
            // The engine only sets WinningHand at showdown, so a null hand
            // means everyone else folded — the other way a pot can be won.
            _banner = $"{winnerNames} take{(winners.Count == 1 ? "s" : "")} the pot";
            _bannerReason = winningHand.HasValue
                ? $"Won with {Pretty(winningHand.Value.Category)}"
                : "Everyone else folded";
        }

        string statusResult = string.IsNullOrEmpty(_bannerReason)
            ? _banner
            : $"{_banner} — {_bannerReason.ToLowerInvariant()}";
        _statusLine = _bannerAmount.HasValue
            ? $"{statusResult}  ·  ${_bannerAmount.Value}"
            : statusResult;

        if (_playerWonPot)
            RecordPlayerVictory(humanPayout);
    }

    // The overlay may only rename a seat a connected friend actually holds
    // (guests trust it for every seat — their local engine players are
    // placeholders). On a host or solo table, NPC seats always show the
    // engine's name: those are unique by construction, so a stale overlay
    // entry left by an earlier friends table can never dress a second seat
    // in a name the fresh shuffle dealt to someone else.
    private string NameOf(int seat)
    {
        if (_game == null) return "Player";
        if (seat > 0 && !_isGuest && !IsRemote(seat))
        {
            string mapped = NpcDisplayName(seat);
            if (!string.IsNullOrEmpty(mapped))
                return mapped;
        }
        if (_seatNames.TryGetValue(seat, out string shown) && !string.IsNullOrEmpty(shown)
            && (_isGuest || IsRemote(seat)))
            return shown;
        return _game.GetPlayer(seat).Name;
    }

    // The engine's player record is immutable, so a mid-session rename from
    // the settings panel only changes what this HUD shows for the human seat.
    private string DisplayName(PokerPlayer p) => p.IsHuman ? PlayerName : NameOf(p.Seat);

    private PokerPlayer HudActor =>
        _game == null || _sessionOver ? null : _game.CurrentPlayer;

    // The current actor's window has two homes: the top-right hand rail
    // (under the card panel) while collapsed, and the top-left meter column
    // (under the pot pill) while the enlarged close-up owns the right edge.
    private RenderFragment ActorCardFragment => __builder =>
    {
        PokerPlayer actor = HudActor;
        string roleChip = HudActorRoleChip;
        string roleLabel = HudActorRoleLabel;
        string status = HudActorStatusLine;
        <div class="actor-card @(actor.IsHuman ? "you" : "") @(ShownOut(actor.Seat) ? "out" : "")">
            <div class="actor-name" style="color:@SeatColor(actor.Seat)">
                @DisplayName(actor)
                @if (!string.IsNullOrEmpty(roleChip))
                {
                    <img class="actor-role" src="@roleChip" alt="@roleLabel" />
                }
            </div>
            <div class="actor-stack">
                @(ShownOut(actor.Seat) ? "OUT" : $"${ShownStack(actor.Seat)}")
            </div>
            @if (!string.IsNullOrEmpty(status) && !ShownOut(actor.Seat))
            {
                <div class="actor-status">@status</div>
            }
        </div>
    };

    private string HudActorRoleChip
    {
        get
        {
            if (HudActor == null || Round == null) return null;
            int seat = HudActor.Seat;
            if (seat == Round.DealerSeat) return "img/ui/chip-dealer.png";
            if (seat == Round.SmallBlindSeat) return "img/ui/chip-small-blind.png";
            if (seat == Round.BigBlindSeat) return "img/ui/chip-big-blind.png";
            return null;
        }
    }

    private string HudActorRoleLabel =>
        HudActorRoleChip switch
        {
            "img/ui/chip-dealer.png" => "Dealer",
            "img/ui/chip-small-blind.png" => "Small blind",
            "img/ui/chip-big-blind.png" => "Big blind",
            _ => ""
        };

    private string HudActorStatusLine
    {
        get
        {
            PokerPlayer actor = HudActor;
            if (actor == null) return null;
            SeatState s = SeatOf(actor.Seat);
            if (s != null && s.AllIn) return "ALL-IN";
            if (s != null && s.CommittedThisStreet > 0) return $"bet ${s.CommittedThisStreet}";
            if (actor.IsHuman) return null;
            return "thinking…";
        }
    }

    private static string HandClip(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high-card",
        HandCategory.Pair => "pair",
        HandCategory.TwoPair => "two-pair",
        HandCategory.ThreeOfAKind => "three-of-a-kind",
        HandCategory.Straight => "straight",
        HandCategory.Flush => "flush",
        HandCategory.FullHouse => "full-house",
        HandCategory.FourOfAKind => "four-of-a-kind",
        HandCategory.StraightFlush => "straight-flush",
        HandCategory.RoyalFlush => "royal-flush",
        _ => null
    };

