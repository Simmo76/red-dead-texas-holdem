    private void TryRestoreWebSession(string json)
    {
        try
        {
            WebSessionSnapshot saved = JsonSerializer.Deserialize<WebSessionSnapshot>(json, SnapshotJson);
            if (saved == null || saved.version != 1 || saved.seats is not { Count: >= 2 })
                return;

            _playerName = SanitizeName(saved.playerName, allowEmpty: true);
            _difficulty = Math.Clamp(saved.difficulty, 0, DifficultyNames.Length - 1);
            _quickMode = saved.quickMode;
            _musicOn = !(saved.musicOff || saved.muted || saved.musicMuted);
            // Older saves stored voices/effects/ambience separately; they now
            // share the single BACKGROUND switch. Bias to keeping sound on:
            // only an all-off save restores as background off.
            _backgroundOn = !((saved.voicesOff && saved.effectsOff && saved.ambienceOff) || saved.muted);

            // Restores are solo-only; no multiplayer name overlay applies.
            _seatNames.Clear();

            var players = new List<PokerPlayer>();
            // A session saved by an older build may carry retired roster
            // names. Keep a saved name only when it is still in the pool
            // (and not already taken); anything else is remapped to a fresh
            // pool name so retired names never resurface mid-session.
            if (saved.tableScene == "street" || saved.tableScene == "saloon")
                _tableScene = saved.tableScene;
            string savedScene = string.IsNullOrEmpty(saved.tableScene) ? "saloon" : saved.tableScene;
            ClearSceneNpcNameMaps();
            if (saved.saloonNpcNames is { Length: 5 } && saved.streetNpcNames is { Length: 5 })
            {
                Array.Copy(saved.saloonNpcNames, _saloonNpcNames, 5);
                Array.Copy(saved.streetNpcNames, _streetNpcNames, 5);
            }
            else
                RebuildSceneNpcNameMapsFromSeats(saved.seats, savedScene);
            if (!string.IsNullOrEmpty(saved.saloonCoachId)
                && SaloonCoachRoster.Any(c => c.Id == saved.saloonCoachId))
                _saloonCoachId = saved.saloonCoachId;
            if (!string.IsNullOrEmpty(saved.octagonCoachId)
                && OctagonCoachRoster.Any(c => c.Id == saved.octagonCoachId))
                _octagonCoachId = saved.octagonCoachId;
            if (string.IsNullOrEmpty(saved.saloonCoachId) && string.IsNullOrEmpty(saved.octagonCoachId))
                PickCoachesForNewGame();
            else if (string.IsNullOrEmpty(saved.octagonCoachId))
                _octagonCoachId = OctagonCoachRoster[_rng.Next(OctagonCoachRoster.Length)].Id;
            else if (string.IsNullOrEmpty(saved.saloonCoachId))
                _saloonCoachId = SaloonCoachRoster[_rng.Next(SaloonCoachRoster.Length)].Id;
            foreach (WebSeatSnapshot seat in saved.seats.OrderBy(s => s.seat))
            {
                if (seat.seat == 0)
                {
                    var human = new HumanPlayer("human", PlayerName, 0, Math.Max(0, seat.stack));
                    human.Status = seat.eliminated ? PlayerStatus.Eliminated : PlayerStatus.Active;
                    players.Add(human);
                    continue;
                }

                int idx = seat.seat - 1;
                string npcName = idx >= 0 && idx < Roster.Length
                    ? NpcNamesForScene(savedScene)[idx]
                    : seat.name ?? $"Player {seat.seat}";

                AIProfile profile = WithDifficulty(Roster[seat.seat - 1]());
                var npc = new AIPlayer(
                    string.IsNullOrEmpty(seat.id) ? $"npc{seat.seat - 1}" : seat.id,
                    npcName,
                    seat.seat, Math.Max(0, seat.stack), profile, _rng.Next());
                npc.Status = seat.eliminated ? PlayerStatus.Eliminated : PlayerStatus.Active;
                npc.Tilt.Tilt = seat.tilt;
                npc.Tilt.Confidence = seat.confidence;
                players.Add(npc);
            }

            if (players.Count < 2) return;
            _game = new PokerGame(TableRules.Default, players, _rng.Next());
            _game.EventEmitted += OnEngineEvent;
            _game.RestoreProgress(saved.handNumber, saved.dealerSeat);
            if (saved.round != null && saved.round.phase != HandPhase.Complete)
            {
                _game.RestoreRound(saved.round);
                _shownBoard.AddRange(_game.CurrentRound.Board);
            }
            _handLog = NewHandLog();
            _handLog.BeginSession(0, TableRules.Default, players);
            _statusLine = saved.round == null || saved.round.phase == HandPhase.Complete ? "Dealing…" : "Resuming your hand…";
            EnsureCoachRecorder();
            _restoredAwaitingLoop = true;
        }
        catch (Exception ex) when (ex is JsonException || ex is ArgumentException || ex is InvalidOperationException)
        {
            ClearWebSession();
        }
    }

    private async Task PersistWebSession()
    {
        if (_game == null) return;
        var saved = new WebSessionSnapshot
        {
            playerName = PlayerName,
            difficulty = _difficulty,
            quickMode = _quickMode,
            // The BACKGROUND switch still writes the three legacy flags so
            // saves stay readable by builds with the four-channel menu.
            musicOff = !_musicOn,
            voicesOff = !_backgroundOn,
            effectsOff = !_backgroundOn,
            ambienceOff = !_backgroundOn,
            tableScene = _tableScene,
            saloonNpcNames = _saloonNpcNames.ToArray(),
            streetNpcNames = _streetNpcNames.ToArray(),
            saloonCoachId = _saloonCoachId,
            octagonCoachId = _octagonCoachId,
            handNumber = _game.HandNumber,
            dealerSeat = _game.DealerSeat,
            // A finished hand has nothing left to resume; the saved stacks
            // already include its result, so the next deal simply follows.
            round = Round is { IsComplete: false } ? Round.Capture() : null
        };
        foreach (PokerPlayer player in _game.Players)
        {
            SeatState roundSeat = SeatOf(player.Seat);
            saved.seats.Add(new WebSeatSnapshot
            {
                seat = player.Seat,
                id = player.Id,
                name = player.Seat == 0 ? player.Name : NameOf(player.Seat),
                stack = roundSeat?.Stack ?? player.Stack,
                eliminated = player.Status == PlayerStatus.Eliminated,
                tilt = player is AIPlayer ai ? ai.Tilt.Tilt : 0.2,
                confidence = player is AIPlayer ai2 ? ai2.Tilt.Confidence : 0.5
            });
        }
        try
        {
            string json = JsonSerializer.Serialize(saved, SnapshotJson);
            await JS.InvokeVoidAsync("pokerSession.save", json);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void StartSession() => StartSessionCore(run: true);

    private void StartSessionCore(bool run)
    {
        int token = ++_loopToken;
        GameLog.Info("session", $"new solo table (run={run}, difficulty={DifficultyNames[_difficulty]}, scene={_tableScene}, quickMode={_quickMode})");
        if (_game != null)
        {
            try { _game.EventEmitted -= OnEngineEvent; }
            catch (InvalidOperationException) { }
        }
        if (!_isGuest) ClearWebSession();
        // A name overlay left over from an earlier friends table must not
        // shadow this roster: a stale entry on one seat can duplicate a name
        // the fresh shuffle deals to another seat. Live multiplayer tables
        // repopulate the overlay themselves.
        if (!_hosting && !_isGuest) _seatNames.Clear();
        var rules = TableRules.Default;
        var players = new List<PokerPlayer> { new HumanPlayer("human", PlayerName, seat: 0, stack: rules.StartingStack) };
        DealDualSceneNpcNames();
        string[] npcNames = NpcNamesForScene(_tableScene);
        for (int i = 0; i < Roster.Length; i++)
        {
            players.Add(new AIPlayer($"npc{i}", npcNames[i], seat: i + 1, stack: rules.StartingStack,
                profile: WithDifficulty(Roster[i]()), seed: _rng.Next()));
        }

        _game = new PokerGame(rules, players, seed: _rng.Next());
        _game.EventEmitted += OnEngineEvent;
        BeginCoachSession();

        _handLog = NewHandLog();
        _handLog.BeginSession(0, rules, players);

        _revealed.Clear();
        _pending.Clear();
        _shownBoard.Clear();
        _showdownView.Clear();
        _banner = null;
        _bannerReason = null;
        _bannerAmount = null;
        _playerWonPot = false;
        _shotBusy = false;
        _shotStatus = null;
        _haulAnimToken++;
        _haulShown = 0;
        _biggestPotWon = 0;
        _pendingFocusSeat = -1;
        _sessionOver = false;
        _humanLost = false;
        _humanWon = false;
        _awaitingHuman = false;
        _showSlider = false;
        _advice = null;
        _skipRequested = false;
        _skipToNextHand = false;
        _awaitingNextHand = false;
        _handHasCompleted = false;
        _ = EndBetPreview(); // RESTART mid-sizing: drop the preview close-up
        _exportOpen = false;
        _exportNote = "";
        _settingsOpen = false;
        ReleaseHandsZoom();
        _handRankingsOpen = false;
        _rulesOpen = false;
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        try { _ = JS.InvokeVoidAsync("pokerVictorySwipe.reset"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }

        if (_winPreview) ShowWinPreview();
        _tableCastLocked = false;
        if (run) _ = RunLoop(token);
        // Solo (and host-table restarts) never emit a hub "started" line on
        // their own — ping /usage so Render still sees who sat down. Guests
        // are covered by JoinRoom logs.
        if (!_isGuest) _ = ReportUsageAsync(_hosting ? "host_table" : "solo");
    }

