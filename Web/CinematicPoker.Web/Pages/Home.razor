        public int Seat { get; set; }
        public string Error { get; set; }
    }

    private sealed class MpMessage
    {
        public string t;          // state | hand | act | over | sync
        public int seat;          // act: acting seat, in the receiver's numbering
        public string a;          // act: action type
        public long amt;          // act: bet/raise-to amount
        public int rot;           // state: seat shift applied for this guest
        public int dealer = -1;
        public int handNumber;
        public int[] deck;
        public long[] stacks;
        public bool[] outs;
        public string[] names;
        public bool[] humans;
        public PokerRoundSnapshot round;
        public string text;
        public string scene;      // state | hand: the host's table scene, which friends follow
        public string who;        // chat: speaker name; rename: the friend's new name
    }

    private static readonly JsonSerializerOptions MpJson = new JsonSerializerOptions
    {
        IncludeFields = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    private static readonly JsonSerializerOptions MpRead = new JsonSerializerOptions
    {
        IncludeFields = true,
        PropertyNameCaseInsensitive = true
    };

    private readonly Dictionary<int, RemoteSeat> _remote = new();
    private readonly Dictionary<int, PlayerAction> _remoteActions = new();
    private readonly Dictionary<int, string> _seatNames = new();
    private readonly HashSet<int> _guestHumanSeats = new();
    private bool _tableLinkDown;

    // --------------------------------------------------------------- table chat
    //
    // Words ride the same host relay as bets: a guest tells the host, the
    // host keeps a copy and forwards it to every other friend. The hub still
    // never reads the text. The panel is absent while one human is the whole
    // table — NPCs don't talk here, and a friend who has dropped doesn't
    // count. Someone who busted but stayed connected still can.

    private const int ChatMaxLength = 180;
    private const int ChatMaxLines = 80;

    private sealed class ChatLine
    {
        public int Id;
        public string Name;
        public string Text;
        public int Seat;
        public bool Mine;
        public bool System;
    }

    private readonly List<ChatLine> _chat = new();
    private readonly Dictionary<int, DateTime> _chatHeardAt = new();
    private string _chatDraft = "";
    private bool _chatCollapsed = true;
    private bool _chatPendingScroll;
    private int _chatUnread;
    private int _chatSeq;
    private DateTime _chatLastSent = DateTime.MinValue;

    // Connected humans still seated. Link-down (host gone, guest reconnecting)
    // leaves you as the only person who can hear a message, so the box hides.
    private int ActiveHumanCount =>
        _isGuest
            ? (_tableLinkDown ? 1 : 1 + _guestHumanSeats.Count)
            : 1 + _remote.Count;

    private bool ShowChat => _introStarted && ActiveHumanCount >= 2;

    // Steady "who's here" copy moved into the chat header. Transient link
    // status (joining, host away, reconnecting) still uses the top-left pill,
    // and that pill only exists while the chat itself is hidden.
    private bool ShowFriendPill => !string.IsNullOrEmpty(_mpPill) && !ShowChat;

    private bool CanSendChat => ShowChat && SanitizeChat(_chatDraft).Length > 0
        && (DateTime.UtcNow - _chatLastSent).TotalMilliseconds >= 400;

    private string ChatRosterLabel
    {
        get
        {
            IEnumerable<string> names = _isGuest
                ? _guestHumanSeats.OrderBy(s => s).Select(SeatLabel)
                : _remote.OrderBy(r => r.Key).Select(r => r.Value.Name);
            return string.Join(" · ", names.Where(n => !string.IsNullOrWhiteSpace(n)));
        }
    }

    // Caught up: who else is here. Unread: the latest line, so a collapsed
    // bar tells you why it's pulsing without covering the felt.
    private string ChatBarHint
    {
        get
        {
            if (_chatCollapsed && _chatUnread > 0 && _chat.Count > 0)
            {
                ChatLine last = _chat[^1];
                return last.System || string.IsNullOrEmpty(last.Name) ? last.Text : $"{last.Name}: {last.Text}";
            }
            return ChatRosterLabel;
        }
    }

    private string SeatLabel(int seat)
    {
        if (_seatNames.TryGetValue(seat, out string shown) && !string.IsNullOrEmpty(shown))
            return shown;
        return _game?.GetPlayer(seat)?.Name ?? "Friend";
    }
    private readonly Queue<MpMessage> _guestInbox = new();
    private List<Card> _guestDeck = new();

    private static int Rot(int seat, int by) =>
        seat < 0 ? seat : ((seat - by) % TableSeats + TableSeats) % TableSeats;

    private bool IsRemote(int seat) => _remote.ContainsKey(seat);

    private bool IsHumanSeat(int seat) =>
        _isGuest ? _guestHumanSeats.Contains(seat) : seat == 0 || _remote.ContainsKey(seat);

    private void ReadInviteRoomFromUrl()
    {
        if (JS is not IJSInProcessRuntime sync) return;
        try
        {
            string raw = sync.Invoke<string>("pokerInvite.roomFromUrl");
            string code = new string((raw ?? "").Where(char.IsLetterOrDigit).Take(12).ToArray()).ToUpperInvariant();
            if (code.Length >= 4)
            {
                _roomCode = code;
                _isGuest = true;
            }
        }
        catch (JSException) { }
    }

    private static string Encode(MpMessage m) => JsonSerializer.Serialize(m, MpJson);

    private static MpMessage Decode(string payload)
    {
        try { return JsonSerializer.Deserialize<MpMessage>(payload, MpRead); }
        catch (JsonException) { return null; }
    }

    private static bool TryDecodeAction(MpMessage m, out PlayerAction action)
    {
        action = default;
        if (!Enum.TryParse(m.a, out ActionType type)) return false;
        switch (type)
        {
            case ActionType.Fold: action = PlayerAction.Fold(); return true;
            case ActionType.Check: action = PlayerAction.Check(); return true;
            case ActionType.Call: action = PlayerAction.Call(); return true;
            case ActionType.Bet: action = PlayerAction.Bet(m.amt); return true;
            case ActionType.Raise: action = PlayerAction.Raise(m.amt); return true;
            case ActionType.AllIn: action = PlayerAction.AllIn(); return true;
            default: return false;
        }
    }

    private async Task SafeInvoke(string identifier, params object[] args)
    {
        try { await JS.InvokeVoidAsync(identifier, args); }
        catch (JSException ex) { Console.Error.WriteLine($"{identifier} failed: {ex.Message}"); }
        catch (InvalidOperationException) { }
    }

    // ------------------------------------------------------------------ host

    private async Task OpenInvite()
    {
        _roomCode = await JS.InvokeAsync<string>("pokerInvite.ensureRoom");
        _inviteUrl = await JS.InvokeAsync<string>("pokerInvite.url", _roomCode);
        _inviteNote = _hosting ? "" : "Opening your table to friends…";
        _inviteOpen = true;
        StateHasChanged();
        if (!_hosting)
        {
            try
            {
                await EnsureHosting();
                _inviteNote = "";
            }
            catch (JSException ex)
            {
                _inviteNote = $"Couldn't reach the multiplayer service: {ex.Message}";
            }
        }
    }

    private async Task EnsureHosting()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        string json = await JS.InvokeAsync<string>("pokerRealtime.host", _roomCode, PlayerName, _selfRef);
        _hosting = true;
        await SafeInvoke("pokerInvite.markHosting");
        ApplyGuestRoster(json);
    }

    // A reload (e.g. switching the table scene) drops the host's connection;
    // reopen the same room straight away so friends are not left waiting.
    private bool _restoredAwaitingLoop;

    // A restored table must not start dealing until friends are seated again,
    // or the NPC logic would play their hands during the reload.
    private async Task ResumeThenRunLoop()
    {
        try
        {
            Task resume = ResumeHostingAfterReload();
            await Task.WhenAny(resume, Task.Delay(8000));
        }
        finally
        {
            if (_restoredAwaitingLoop && _game != null)
            {
                _restoredAwaitingLoop = false;
                _ = RunLoop(++_loopToken);
            }
        }
    }

    private async Task ResumeHostingAfterReload()
    {
        if (_isGuest || _hosting || _game == null) return;
        try
        {
            string room = await JS.InvokeAsync<string>("pokerInvite.hostedRoom");
            if (string.IsNullOrEmpty(room)) return;
            _roomCode = room;
            _inviteUrl = await JS.InvokeAsync<string>("pokerInvite.url", _roomCode);
            await EnsureHosting();
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"Could not resume hosting: {ex.Message}");
        }
    }

    private void ApplyGuestRoster(string json)
    {
        List<GuestRow> rows;
        try { rows = JsonSerializer.Deserialize<List<GuestRow>>(json, MpRead) ?? new(); }
        catch (JsonException) { return; }
        foreach (GuestRow row in rows)
            if (row.Connected) AddRemote(row.Seat, row.Name, row.PlayerId);
    }

    private void AddRemote(int seat, string name, string playerId)
    {
        if (seat < 1 || seat >= TableSeats) return;
        string shown = SanitizeName(name, allowEmpty: true);
        if (shown.Length == 0) shown = "Friend";
        bool already = _remote.ContainsKey(seat);
        _remote[seat] = new RemoteSeat { PlayerId = playerId, Name = shown };
        _seatNames[seat] = shown;
        _remoteActions.Remove(seat);
        RefreshHostPill();
        SendState(seat);
        BroadcastRoster();
        if (!already)
        {
            // Everyone else hears who sat down. The new player gets a
            // welcome instead of a line about their own name.
            Announce($"{shown} joined the table.", skipSeat: seat);
            SendToGuest(seat, new MpMessage { t = "chat", a = "sys", text = "You're in. Say howdy." });
        }
        SuppressAdviceForCompany();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RemoveRemote(int seat)
    {
        if (!_remote.TryGetValue(seat, out RemoteSeat remote)) return;
        string name = remote.Name;
        _remote.Remove(seat);
        _seatNames.Remove(seat);
        _remoteActions.Remove(seat);
        _chatHeardAt.Remove(seat);
        RefreshHostPill();
        BroadcastRoster();
        Announce($"{name} left the table.");
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshHostPill()
    {
        _mpPill = _remote.Count == 0
            ? ""
            : "AT THE TABLE: " + string.Join(", ", _remote.OrderBy(r => r.Key)
                .Select(r => r.Value.Name.ToUpperInvariant()));
    }

    [JSInvokable]
    public void OnGuestJoined(int seat, string name, string playerId) => AddRemote(seat, name, playerId);

    [JSInvokable]
    public void OnGuestLeft(int seat, bool permanent) => RemoveRemote(seat);

    [JSInvokable]
    public void OnHostReattached(string guestsJson)
    {
        _hosting = true;
        ApplyGuestRoster(guestsJson);
    }

    [JSInvokable]
    public void OnGuestMessage(int seat, string payload)
    {
        if (_isGuest) return;
        MpMessage m = Decode(payload);
        if (m == null) return;
        if (m.t == "chat")
        {
            ReceiveGuestChat(seat, m);
            return;
        }
        if (m.t == "rename")
        {
            ApplyRemoteRename(seat, m.who);
            return;
        }
        if (_game == null || !IsRemote(seat)) return;
        if (m.t == "act")
        {
            if (_game.Phase == GamePhase.HandInProgress && _game.CurrentSeat == seat
                && TryDecodeAction(m, out PlayerAction action))
                _remoteActions[seat] = action;
            else
                SendState(seat);
        }
        else if (m.t == "sync")
        {
            SendState(seat);
        }
    }

    private void SendToGuest(int seat, MpMessage message) =>
        _ = SafeInvoke("pokerRealtime.toGuest", seat, Encode(message));

    private void BroadcastToAll(MpMessage message)
    {
        foreach (int seat in _remote.Keys) SendToGuest(seat, message);
    }

    private void SubmitAndBroadcast(PlayerAction action)
    {
        int seat = _game.CurrentSeat;
        _game.SubmitAction(action);
        foreach (int guest in _remote.Keys)
        {
            SendToGuest(guest, new MpMessage
            {
                t = "act",
                seat = Rot(seat, guest),
                a = action.Type.ToString(),
                amt = action.Amount,
                handNumber = _game.HandNumber
            });
        }
    }

    private void FillTable(MpMessage m, int guest, bool atHandStart)
    {
        m.stacks = new long[TableSeats];
        m.outs = new bool[TableSeats];
        m.names = new string[TableSeats];
        m.humans = new bool[TableSeats];
        foreach (PokerPlayer p in _game.Players)
        {
            int j = Rot(p.Seat, guest);
            SeatState inHand = SeatOf(p.Seat);
            m.stacks[j] = atHandStart && inHand != null ? inHand.StackAtHandStart : p.Stack;
            m.outs[j] = p.Status == PlayerStatus.Eliminated && inHand == null;
            m.names[j] = p.Seat == 0 ? PlayerName : NameOf(p.Seat);
            m.humans[j] = IsHumanSeat(p.Seat);
        }
    }

    private void BroadcastHand()
    {
        if (_game?.CurrentRound == null) return;
        List<int> deck = Round.Capture().deck;
        foreach (int guest in _remote.Keys)
        {
            var m = new MpMessage
            {
                t = "hand",
                scene = _tableScene,
                handNumber = _game.HandNumber,
                dealer = Rot(_game.DealerSeat, guest),
                deck = deck.ToArray()
            };
            FillTable(m, guest, atHandStart: true);
            SendToGuest(guest, m);
        }
    }

    private void SendState(int guest)
    {
        if (_game == null || !IsRemote(guest)) return;
        var m = new MpMessage
        {
            t = "state",
            scene = _tableScene,
            rot = guest,
            handNumber = _game.HandNumber,
            dealer = Rot(_game.DealerSeat, guest)
        };
        FillTable(m, guest, atHandStart: false);
        if (_game.Phase == GamePhase.HandInProgress && Round != null && !Round.IsComplete)
            m.round = Round.Capture().RotateSeats(guest);
        SendToGuest(guest, m);
    }

    private async Task RunRemoteTurn(PokerPlayer actor, int token)
    {
        int seat = actor.Seat;
        _statusLine = $"{NameOf(seat)} is thinking…";
        StateHasChanged();
        _remoteActions.Remove(seat);
        DateTime started = DateTime.UtcNow;
        while (token == _loopToken && IsRemote(seat) && !_remoteActions.ContainsKey(seat))
        {
            if ((DateTime.UtcNow - started).TotalSeconds > RemoteTurnTimeoutSeconds)
            {
                // An away friend must not stall the table: check if free, else fold.
                LegalActions legal = _game.GetLegalActions();
                _remoteActions[seat] = legal.CanCheck ? PlayerAction.Check() : PlayerAction.Fold();
                break;
            }
            await Task.Delay(50);
        }
        if (token != _loopToken) return;
        if (!_remoteActions.Remove(seat, out PlayerAction action)) return; // seat is an NPC again

        try { SubmitAndBroadcast(action); }
        catch (IllegalActionException)
        {
            SendState(seat);
            return;
        }
        await DrainEvents(token);
    }

    // ----------------------------------------------------------------- guest

    private async Task ConnectGuestAsync()
    {
        if (_guestConnecting || _guestJoined) return;
        _guestConnecting = true;
        _mpPill = "JOINING THE TABLE…";
        _statusLine = "Joining the table…";
        StateHasChanged();
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            string json = await JS.InvokeAsync<string>("pokerRealtime.join", _roomCode, PlayerName, _selfRef);
            JoinRow result = JsonSerializer.Deserialize<JoinRow>(json, MpRead);
            if (result == null || !result.Ok)
            {
                _mpPill = "";
                _guestConnecting = false;
                _guestError = string.IsNullOrEmpty(result?.Error) ? "Couldn't join this table." : result.Error;
            }
            else
            {
                _guestJoined = true;
                _mpPill = "JOINED — WAITING FOR THE DEAL";
                _statusLine = "Waiting for the host to deal you in…";
            }
        }
        catch (JSException ex)
        {
            _mpPill = "";
            _guestError = $"Couldn't reach the table ({ex.Message}). Check the link and try again.";
        }
        _guestConnecting = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnHostMessage(string payload)
    {
        if (!_isGuest) return;
        MpMessage m = Decode(payload);
        if (m == null) return;
        // Chat and the seating roster are not hands. They must never enter
        // the replay inbox, and they have to work before the first deal.
        if (m.t == "chat")
        {
            ReceiveRelayedChat(m);
            return;
        }
        if (m.t == "roster")
        {
            ApplyRoster(m);
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        if (_game == null) return;
        if (!string.IsNullOrEmpty(m.scene) && m.scene != _tableScene)
            _ = FollowHostScene(m.scene);
        if (m.t == "state")
        {
            _guestInbox.Clear();
            ApplyGuestState(m);
        }
        else
        {
            _guestInbox.Enqueue(m);
        }
    }

