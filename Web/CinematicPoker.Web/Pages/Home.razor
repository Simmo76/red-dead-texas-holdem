    /// <summary>
    /// Keep James in the game when he still has chips or can buy back in.
    /// A bust rebies against the same opponents; a table win seats a new
    /// table and he keeps his stack.
    /// </summary>
    private void ContinueGame()
    {
        DismissCoachPresentation();
        if (_game == null) return;
        try
        {
            if (_game.HasHumanLost)
            {
                _game.RebuyHuman();
            }
            else if (_game.HasHumanWon
                     || (_game.Human != null
                         && _game.Human.Status != PlayerStatus.Eliminated
                         && _game.Human.Stack >= _game.Rules.BigBlind))
            {
                _game.ContinueWithNewOpponents(CreateNpcRoster());
            }
            else
            {
                return;
            }
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch (ArgumentException)
        {
            return;
        }

        _sessionOver = false;
        _humanLost = false;
        _humanWon = false;
        _awaitingHuman = false;
        _showSlider = false;
        _advice = null;
        _skipRequested = false;
        _skipToNextHand = false;
        _awaitingNextHand = false;
        _handHasCompleted = false;
        _exportOpen = false;
        _banner = null;
        _bannerAmount = null;
        _playerWonPot = false;
        _shotBusy = false;
        _shotStatus = null;
        _pendingFocusSeat = -1;
        _showdownView.Clear();
        _statusLine = "Dealing…";
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        _ = EndBetPreview();
        _ = RunLoop(++_loopToken);
    }

    private List<PokerPlayer> CreateNpcRoster()
    {
        var npcs = new List<PokerPlayer>();
        string[] npcNames = ShuffledNpcNames();
        for (int i = 0; i < Roster.Length; i++)
        {
            npcs.Add(new AIPlayer($"npc{i}", npcNames[i], seat: i + 1, stack: TableRules.Default.StartingStack,
                profile: WithDifficulty(Roster[i]()), seed: _rng.Next()));
        }
        return npcs;
    }

    /// <summary>
    /// Table is down to one player, or James is busted. Losing shows GAME
    /// OVER; winning offers Continue Game so he can sit a new table with
    /// the chips he still has.
    /// </summary>
    private void FinishSession()
    {
        _humanLost = _game.HasHumanLost;
        _humanWon = _game.HasHumanWon;
        if (_humanLost)
        {
            _sessionOverMessage = "GAME OVER";
        }
        else if (_humanWon)
        {
            _sessionOverMessage = $"{PlayerName} takes the table!";
        }
        else
        {
            var winner = _game.AlivePlayers.Count > 0 ? _game.AlivePlayers[0] : null;
            _sessionOverMessage = winner == null
                ? "Nobody takes the table."
                : winner.IsHuman
                ? $"{PlayerName} cleaned out the whole table!"
                : $"{NameOf(winner.Seat)} takes the table. Rough night.";
        }
        _sessionOver = true;
        _awaitingHuman = false;
        _awaitingNextHand = false;
        _showSlider = false;
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        if (!_isGuest && _remote.Count > 0)
            BroadcastToAll(new MpMessage { t = "over", text = $"{_sessionOverMessage} Waiting for the host…" });
        StateHasChanged();
    }

    /// <summary>
    /// Drives the session: NPC turns with think-time pacing, pauses for human
    /// input, and waits for NEXT HAND after a result is shown. Cancelled by
    /// token when restarting.
    /// </summary>
    // A friend who takes over a busted opponent's seat must not sit down
    // with nothing: give that seat a fresh buy-in before the next deal.
    private void SeatFriendsWithChips()
    {
        if (_game == null || _game.Phase == GamePhase.HandInProgress) return;
        foreach (int seat in _remote.Keys.ToList())
        {
            try
            {
                if (_game.RebuySeatIfBroke(seat))
                    Announce($"{NameOf(seat)} bought back in.");
            }
            catch (InvalidOperationException) { }
        }
    }

    private async Task RunLoop(int token)
    {
        while (token == _loopToken)
        {
            SeatFriendsWithChips();
            // A finished table (James won, or only NPCs remain) still holds
            // on the result until NEXT HAND. Do not overlay immediately —
            // that skipped the banner and hid the action bar.
            bool tableSettled = _game.IsSessionOver || _game.HasHumanLost;
            if (tableSettled && !_handHasCompleted)
            {
                FinishSession();
                return;
            }

            if (_game.Phase == GamePhase.WaitingForHand || tableSettled)
            {
                if (_handHasCompleted && _skipToNextHand && !tableSettled)
                {
                    // The player asked for the next hand while spectating:
                    // don't hold on the result, deal straight away. A settled
                    // table (bust or table win) still holds below so the
                    // final result can never be skipped past.
                    _skipToNextHand = false;
                    _skipRequested = false;
                }
                else if (_handHasCompleted)
                {
                    // Hold on the win/lose banner until the player taps
                    // NEXT HAND. Ignore leftover SKIP taps from the just-
                    // finished hand so the result cannot be skipped by
                    // accident.
                    _skipRequested = false;
                    _skipToNextHand = false;
                    _awaitingNextHand = true;
                    _statusLine = HumanIsBusted
                        ? "Tap CONTINUE when you've seen the result"
                        : _game.HasHumanWon
                        ? "Tap NEXT HAND to keep your stack"
                        : "Tap NEXT HAND when you've seen the result";
                    StateHasChanged();
                    await OpenCoachAfterHand();
                    while (token == _loopToken && !_skipRequested)
                        await Task.Delay(50);
                    _skipRequested = false;
                    _awaitingNextHand = false;
                }
                else if (_game.Phase == GamePhase.WaitingForHand)
                {
                    _statusLine = "Dealing…";
                    StateHasChanged();
                    await Task.Delay(NextHandDelayMs);
                }
                if (token != _loopToken) return;
                SeatFriendsWithChips();

                // James still has chips and opponents remain: deal. Bust or
                // a table sweep goes to the overlay, where Continue Game
                // rebies or seats a new table with his stack.
                if (_game.HasHumanLost || _game.IsSessionOver)
                {
                    FinishSession();
                    return;
                }

                _handHasCompleted = false;
                _game.StartHand();
                if (_remote.Count > 0) BroadcastHand();
                await DrainEvents(token);
                continue;
            }

            PokerPlayer actor = _game.CurrentPlayer;
            if (actor == null) { await Task.Delay(50); continue; }

            if (actor.IsHuman)
            {
                PromptHuman();
                return; // resumes via Act()
            }

            if (IsRemote(actor.Seat))
            {
                await RunRemoteTurn(actor, token);
                continue;
            }

            _statusLine = $"{NameOf(actor.Seat)} is thinking…";
            StateHasChanged();
            await PacedDelay(ThinkTimeMs, token);
            if (token != _loopToken) return;
            if (IsRemote(actor.Seat)) continue; // a friend took this seat while the NPC was thinking

            var npc = (AIPlayer)actor;
            DecisionContext context = DecisionContext.ForCurrentActor(_game, EquityIterations);
            SubmitAndBroadcast(npc.DecideAction(context));
            await DrainEvents(token);
        }
    }

    private void PromptHuman()
    {
        if (_coachOpen && !_coachPreview)
            _ = CloseCoach(false);
        _legal = _game.GetLegalActions();
        _coachOffer = CaptureCoachOffer();
        _sliderValue = _legal.MinBetOrRaiseTo;
        _sliderPosition = BetAmountToSliderPosition(_sliderValue);
        _showSlider = false;
        _advice = null;           // computed on demand when the button is tapped
        _adviceCollapsed = true;  // every turn starts as just the button
        _awaitingHuman = true;
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", true); }
        catch (JSException) { }
        StateHasChanged();
    }

    private async Task Act(PlayerAction action)
    {
        if (!_awaitingHuman) return;
        if (_isGuest)
        {
            SendToHost(new MpMessage { t = "act", a = action.Type.ToString(), amt = action.Amount });
            _awaitingHuman = false;
            _showSlider = false;
            _advice = null;
            try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
            catch (JSException) { }
            StateHasChanged();
            return;
        }
        try
        {
            SubmitAndBroadcast(action);
            AcceptCoachAction(action);
            _awaitingHuman = false;
            _showSlider = false;
            _advice = null;
            try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
            catch (JSException) { }
        }
        catch (IllegalActionException)
        {
            return; // engine rejected it; keep waiting for a legal choice
        }
        StateHasChanged();
        await DrainEvents(_loopToken);
        await RunLoop(_loopToken);
    }

    // Opening the slider zooms the 3D camera in over the player's cards and
    // grows a preview chip stack at his bet spot; every slider change resizes
    // the stack, and CONFIRM/BACK release the close-up again.
    private async Task OpenSlider()
    {
        _showSlider = true;
        _sliderValue = _legal.MinBetOrRaiseTo;
        _sliderPosition = BetAmountToSliderPosition(_sliderValue);
        await PushBetPreview();
    }

    private async Task OnSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int position))
        {
            _sliderPosition = Math.Clamp(position, 0, BetSliderSteps);
            _sliderValue = SliderPositionToBetAmount(_sliderPosition);
        }
        await PushBetPreview();
    }

    private void BeginSliderInteraction() => _sliderInteracting = true;

    private void EndSliderInteraction() => _sliderInteracting = false;

    private async Task SetSlider(long amount)
    {
        _sliderValue = Math.Clamp(amount, _legal.MinBetOrRaiseTo, _legal.MaxBetOrRaiseTo);
        _sliderPosition = BetAmountToSliderPosition(_sliderValue);
        await PushBetPreview();
    }

    // Keep the slider position independent from the money amount. A
    // logarithmic scale makes $20-$100 easy to select even when the all-in
    // amount is several thousand dollars, while still allowing the full
    // range to be reached precisely at either end.
    private const int BetSliderSteps = 1000;

    // Keep the live tooltip centred over the thumb as the normalized slider
    // position changes. The range input re-renders on every pointer movement.
    private int SliderPercent => (int)Math.Round(
        Math.Clamp(_sliderPosition, 0, BetSliderSteps) / (double)BetSliderSteps * 100);

    // Native range thumbs travel between half-thumb-width inset endpoints,
    // rather than across the full input width. Keep overlays on that same path.
    private string SliderThumbPosition => 
        $"calc({SliderPercent}% + {30 - SliderPercent * 0.6:0.##}px)";

    private long SliderPositionToBetAmount(int position)
    {
        if (_legal == null) return 0;

        long min = _legal.MinBetOrRaiseTo;
        long max = _legal.MaxBetOrRaiseTo;
        if (max <= min) return min;

        double t = Math.Clamp(position, 0, BetSliderSteps) / (double)BetSliderSteps;
        double amount;
        if (min > 0)
        {
            amount = min * Math.Exp(Math.Log((double)max / min) * t);
        }
        else
        {
            // Logarithms cannot represent a zero lower bound. A power curve
            // gives the same low-end precision for that uncommon case.
            amount = min + (max - min) * Math.Pow(t, 2.2);
        }

        long snapped = (long)Math.Round(amount / 5.0) * 5;
        return Math.Clamp(snapped, min, max);
    }

    private int BetAmountToSliderPosition(long amount)
    {
        if (_legal == null) return 0;

        long min = _legal.MinBetOrRaiseTo;
        long max = _legal.MaxBetOrRaiseTo;
        if (max <= min) return 0;

        amount = Math.Clamp(amount, min, max);
        double t;
        if (min > 0)
        {
            t = Math.Log((double)amount / min) / Math.Log((double)max / min);
        }
        else
        {
            t = Math.Pow((double)(amount - min) / (max - min), 1.0 / 2.2);
        }

        return (int)Math.Round(Math.Clamp(t, 0, 1) * BetSliderSteps);
    }

    private async Task CloseSlider()
    {
        _showSlider = false;
        await EndBetPreview();
    }

    private async Task PushBetPreview()
    {
        if (!_sceneReady) return;
        try { await JS.InvokeVoidAsync("pokerScene.betPreview", _sliderValue); }
        catch (JSException) { /* scene not available; HUD still works */ }
    }

    private async Task EndBetPreview()
    {
        if (!_sceneReady) return;
        try { await JS.InvokeVoidAsync("pokerScene.endBetPreview"); }
        catch (JSException) { /* scene not available; HUD still works */ }
    }

    private async Task ConfirmSlider()
    {
        long amount = _sliderValue;
        await EndBetPreview();
        if (amount >= _legal.MaxBetOrRaiseTo) await Act(PlayerAction.AllIn());
        else if (_legal.CanBet) await Act(PlayerAction.Bet(amount));
        else await Act(PlayerAction.Raise(amount));
    }

    private void ToggleMode() => _quickMode = !_quickMode;

    // Any tap outside the enlarged close-up (wired on the root .game3d div)
    // puts the window back to its normal corner size. Taps on the window
    // itself stop propagation, so this never fights the toggle below. The
    // camera is left alone: this is a dismiss, not "back to my seat".
    private void CollapseHudBoard() => _hudBoardExpanded = false;

