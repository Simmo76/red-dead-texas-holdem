    private string _inviteUrl = "";
    private string _inviteNote = "";
    private string _mpPill = "";
    private string _guestError = "";
    private DotNetObjectReference<Home> _selfRef;

    private sealed class RemoteSeat
    {
        public string PlayerId;
        public string Name;
    }

    private sealed class GuestRow
    {
        public int Seat { get; set; }
        public string PlayerId { get; set; }
        public string Name { get; set; }
        public bool Connected { get; set; }
    }

    private sealed class JoinRow
    {
