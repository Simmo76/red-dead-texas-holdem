@page "/"
@using CinematicPoker.Engine.AI
@using CinematicPoker.Engine.Players
@using CinematicPoker.Engine.Poker
@inject IJSRuntime JS

<PageTitle>Cinematic Poker</PageTitle>

<div class="game3d">

    <canvas id="poker-canvas"></canvas>

    <header class="topbar">
        <div class="brand">CINEMATIC <span>POKER</span></div>
        <div class="topbar-right">
            <button class="chip-btn" @onclick="CycleBackdrop">@_backdropName</button>
            <button class="chip-btn @(_muted ? "" : "active")" @onclick="ToggleMute">
                @(_muted ? "SOUND OFF" : "SOUND ON")
            </button>
            <button class="chip-btn @(_quickMode ? "active" : "")" @onclick="ToggleMode">
                @(_quickMode ? "QUICK PLAY" : "CINEMATIC")
            </button>
            <button class="chip-btn" @onclick="CycleDifficulty">@DifficultyNames[_difficulty]</button>
            <button class="chip-btn" @onclick="StartSession">RESTART</button>
        </div>
    </header>

    @if (Round != null)
    {
        <div class="hud-pot">POT&nbsp;<b>$@Round.PotTotal</b> <span class="hud-stack">· YOU&nbsp;<b>$@(SeatOf(0)?.Stack ?? _game.GetPlayer(0).Stack)</b></span></div>

        <div class="hud-board @(_hudBoardExpanded ? "expanded" : "")"
             @onclick="() => _hudBoardExpanded = !_hudBoardExpanded">
            <div class="hud-row">
                @* Dealt cards fill from the right so they hug the border,
                   aligned above the player's pair. *@
                @for (int i = 0; i < 5; i++)
                {
                    var dealt = i - (5 - Round.Board.Count);
                    if (dealt >= 0)
                    {
                        <img class="hud-card" src="@CardImage(Round.Board[dealt])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
            <div class="hud-row hud-hole">
                @{ IReadOnlyList<Card> hudHole = SeatOf(0) is { Folded: true } ? Array.Empty<Card>() : HoleCardsOf(0); }
                @for (int i = 0; i < 2; i++)
                {
                    if (i < hudHole.Count)
                    {
                        <img class="hud-card" src="@CardImage(hudHole[i])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
        </div>
    }

    @if (_banner != null)
    {
        <div class="banner">@_banner</div>
    }

    <aside class="log">
        @foreach (string line in _log)
        {
            <div class="log-line @(line.StartsWith("—") ? "hand-marker" : "")">@line</div>
        }
    </aside>

    <div class="actionbar">
        @if (_awaitingHuman && _legal != null && !_showSlider)
        {
            @if (_legal.CanFold)  { <button class="act fold" @onclick="() => Act(PlayerAction.Fold())">FOLD</button> }
            @if (_legal.CanCheck) { <button class="act check" @onclick="() => Act(PlayerAction.Check())">CHECK</button> }
            @if (_legal.CanCall)  { <button class="act call" @onclick="() => Act(PlayerAction.Call())">CALL $@_legal.CallAmount</button> }
            @if (_legal.CanBet)   { <button class="act bet" @onclick="OpenSlider">BET</button> }
            @if (_legal.CanRaise) { <button class="act bet" @onclick="OpenSlider">RAISE</button> }
            @if (_legal.CanAllIn) { <button class="act allin" @onclick="() => Act(PlayerAction.AllIn())">ALL-IN</button> }
        }
        else if (_awaitingHuman && _legal != null && _showSlider)
        {
            <div class="slider-panel">
                <input type="range" min="@_legal.MinBetOrRaiseTo" max="@_legal.MaxBetOrRaiseTo" step="5"
                       @bind="_sliderValue" @bind:event="oninput" />
                <div class="slider-row">
                    <span class="slider-amount">$@_sliderValue</span>
                    <button class="act small" @onclick="() => SetSlider(PotNow / 2)">½ POT</button>
                    <button class="act small" @onclick="() => SetSlider(PotNow)">POT</button>
                    <button class="act small" @onclick="() => SetSlider(_legal.MaxBetOrRaiseTo)">MAX</button>
                    <button class="act call" @onclick="ConfirmSlider">CONFIRM</button>
                    <button class="act small" @onclick="() => _showSlider = false">BACK</button>
                </div>
            </div>
        }
        else if (_game != null && !_sessionOver)
        {
            <div class="waiting">@_statusLine</div>
        }
    </div>

    @if (_sessionOver)
    {
        <div class="overlay">
            <div class="overlay-box">
                <div class="overlay-title">@_sessionOverMessage</div>
                <button class="act call big" @onclick="StartSession">PLAY AGAIN</button>
            </div>
        </div>
    }
</div>

@code {
    private static readonly (string Name, Func<AIProfile> Profile)[] Roster =
    {
        ("Davo", AIProfile.Maniac),
        ("Mick", AIProfile.Regular),
        ("Shazza", AIProfile.Rock),
        ("Bluey", AIProfile.CallingStation),
        ("Kev", AIProfile.Professional)
    };

    // ---------------------------------------------------------- difficulty

    private static readonly string[] DifficultyNames = { "AI EASY", "AI NORMAL", "AI HARD" };
    private int _difficulty = 1; // NORMAL

    private void CycleDifficulty()
    {
        _difficulty = (_difficulty + 1) % DifficultyNames.Length;
        if (_game == null) return;
        // Retune the live NPCs in place, mid-session: rebuild each personality
        // preset at the new difficulty and write it into the existing profile.
        for (int i = 0; i < Roster.Length; i++)
        {
            if (_game.GetPlayer(i + 1) is AIPlayer ai)
                CopyProfile(WithDifficulty(Roster[i].Profile()), ai.Profile);
        }
    }

    // Scales each personality's competence up or down without erasing what
    // makes them distinct: aggression and tightness stay untouched, only the
    // "how well do they actually play" parameters move.
    private AIProfile WithDifficulty(AIProfile p)
    {
        if (_difficulty == 0) // EASY: sloppier reads, more mistakes, tilts easily
        {
            p.Skill *= 0.45;
            p.PotOddsAccuracy *= 0.45;
            p.HandReadingAbility *= 0.45;
            p.PositionAwareness *= 0.5;
            p.OpponentAwareness *= 0.5;
            p.BluffFrequency *= 0.7;
            p.DecisionNoise = Math.Min(1, p.DecisionNoise + 0.15);
            p.TiltSensitivity = Math.Min(1, p.TiltSensitivity + 0.2);
        }
        else if (_difficulty == 2) // HARD: sharper reads, fewer mistakes, cool heads
        {
            p.Skill += (1 - p.Skill) * 0.55;
            p.PotOddsAccuracy += (1 - p.PotOddsAccuracy) * 0.55;
            p.HandReadingAbility += (1 - p.HandReadingAbility) * 0.55;
            p.PositionAwareness += (1 - p.PositionAwareness) * 0.5;
            p.OpponentAwareness += (1 - p.OpponentAwareness) * 0.5;
            p.DecisionNoise *= 0.35;
            p.TiltSensitivity *= 0.5;
        }
        return p;
    }

    private static void CopyProfile(AIProfile from, AIProfile into)
    {
        into.Skill = from.Skill;
        into.Aggression = from.Aggression;
        into.Tightness = from.Tightness;
        into.BluffFrequency = from.BluffFrequency;
        into.RiskTolerance = from.RiskTolerance;
        into.TiltSensitivity = from.TiltSensitivity;
        into.PositionAwareness = from.PositionAwareness;
        into.OpponentAwareness = from.OpponentAwareness;
        into.PotOddsAccuracy = from.PotOddsAccuracy;
        into.HandReadingAbility = from.HandReadingAbility;
        into.DecisionNoise = from.DecisionNoise;
        into.EmotionalBias = from.EmotionalBias;
    }

    private PokerGame _game;
    private readonly Random _rng = new();
    private readonly Dictionary<int, IReadOnlyList<Card>> _revealed = new();
    private readonly List<string> _log = new();

    private LegalActions _legal;
    private bool _awaitingHuman;
    private bool _showSlider;
    private long _sliderValue;
    private bool _quickMode;
    private bool _sessionOver;
    private bool _hudBoardExpanded;
    private string _sessionOverMessage = "";
    private string _banner;
    private string _statusLine = "";
    private int _loopToken;

    private PokerRound Round => _game?.CurrentRound;
    private long PotNow => Round?.PotTotal ?? 0;

    // NPC turns are always at least 1 second apart so the table stays readable.
    private int ThinkTimeMs => _quickMode ? 1000 : _rng.Next(1000, 2200);
    private int NextHandDelayMs => _quickMode ? 700 : 2600;
    private const int EquityIterations = 200;

    protected override void OnInitialized() => StartSession();

    // ------------------------------------------------------------- 3D scene

    private bool _sceneReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The scene module loads asynchronously; retry until it's there.
            for (int i = 0; i < 60 && !_sceneReady; i++)
            {
                try
                {
                    _sceneReady = await JS.InvokeAsync<bool>("pokerScene.init", "poker-canvas");
                }
                catch (JSException)
                {
                    await Task.Delay(250);
                }
            }
        }
        if (_sceneReady) await PushSceneState();
    }

    private async Task PushSceneState()
    {
        if (_game == null) return;

        var seats = _game.Players.Select(p =>
        {
            SeatState s = SeatOf(p.Seat);
            bool folded = s != null && s.Folded;
            bool eliminated = p.Status == PlayerStatus.Eliminated;
            bool acting = _game.CurrentSeat == p.Seat;
            string status =
                folded ? "folded"
                : s != null && s.AllIn ? "ALL-IN"
                : s != null && s.CommittedThisStreet > 0 ? $"bet ${s.CommittedThisStreet}"
                : acting && !p.IsHuman ? "thinking…"
                : "";
            return new
            {
                seat = p.Seat,
                name = p.Name,
                stack = s?.Stack ?? p.Stack,
                bet = s?.CommittedThisStreet ?? 0,
                folded,
                @out = eliminated,
                actor = acting,
                active = s != null && !folded && !eliminated,
                dealer = Round != null && p.Seat == Round.DealerSeat,
                sb = Round != null && p.Seat == Round.SmallBlindSeat,
                bb = Round != null && p.Seat == Round.BigBlindSeat,
                reveal = p.Seat != 0 && _revealed.TryGetValue(p.Seat, out var shown)
                    ? shown.Select(CardImage).ToArray()
                    : null,
                status
            };
        }).ToArray();

        var snapshot = new
        {
            pot = Round?.PotTotal ?? 0,
            board = Round?.Board.Select(CardImage).ToArray() ?? Array.Empty<string>(),
            // Folding mucks your cards: they leave your hand immediately.
            hole = SeatOf(0) is { Folded: true }
                ? Array.Empty<string>()
                : HoleCardsOf(0).Select(CardImage).ToArray(),
            seats
        };

        try { await JS.InvokeVoidAsync("pokerScene.update", snapshot); }
        catch (JSException) { /* scene not available; HUD still works */ }
    }

    private void SceneReact(int seat, bool positive)
    {
        if (!_sceneReady || seat == 0) return;
        _ = JS.InvokeVoidAsync("pokerScene.react", seat, positive);
    }

    // Unlike reactions, action gestures also play on the player's own body
    // (visible from the over-the-shoulder camera).
    private void SceneAction(int seat, string kind)
    {
        if (!_sceneReady) return;
        _ = JS.InvokeVoidAsync("pokerScene.action", seat, kind);
    }

    private void StartSession()
    {
        var rules = TableRules.Default;
        var players = new List<PokerPlayer> { new HumanPlayer("human", "You", seat: 0, stack: rules.StartingStack) };
        for (int i = 0; i < Roster.Length; i++)
        {
            players.Add(new AIPlayer($"npc{i}", Roster[i].Name, seat: i + 1, stack: rules.StartingStack,
                profile: WithDifficulty(Roster[i].Profile()), seed: _rng.Next()));
        }

        _game = new PokerGame(rules, players, seed: _rng.Next());
        _game.EventEmitted += OnEngineEvent;

        _log.Clear();
        _revealed.Clear();
        _banner = null;
        _sessionOver = false;
        _awaitingHuman = false;
        _showSlider = false;

        _ = RunLoop(++_loopToken);
    }

    /// <summary>
    /// Drives the session: NPC turns with think-time pacing, pauses for human
    /// input, auto-deals the next hand. Cancelled by token when restarting.
    /// </summary>
    private async Task RunLoop(int token)
    {
        while (token == _loopToken)
        {
            if (_game.IsSessionOver)
            {
                var winner = _game.AlivePlayers.Count > 0 ? _game.AlivePlayers[0].Name : "Nobody";
                _sessionOverMessage = winner == "You"
                    ? "You cleaned out the whole table!"
                    : $"{winner} takes the table. Rough night.";
                _sessionOver = true;
                StateHasChanged();
                return;
            }

            if (_game.Phase == GamePhase.WaitingForHand)
            {
                _statusLine = "Next hand…";
                StateHasChanged();
                await Task.Delay(NextHandDelayMs);
                if (token != _loopToken) return;
                _game.StartHand();
                StateHasChanged();
                continue;
            }

            PokerPlayer actor = _game.CurrentPlayer;
            if (actor == null) { await Task.Delay(50); continue; }

            if (actor.IsHuman)
            {
                _legal = _game.GetLegalActions();
                _sliderValue = _legal.MinBetOrRaiseTo;
                _awaitingHuman = true;
                StateHasChanged();
                return; // resumes via Act()
            }

            _statusLine = $"{actor.Name} is thinking…";
            StateHasChanged();
            await Task.Delay(ThinkTimeMs);
            if (token != _loopToken) return;

            var npc = (AIPlayer)actor;
            DecisionContext context = DecisionContext.ForCurrentActor(_game, EquityIterations);
            _game.SubmitAction(npc.DecideAction(context));
            StateHasChanged();
        }
    }

    private async Task Act(PlayerAction action)
    {
        if (!_awaitingHuman) return;
        try
        {
            _game.SubmitAction(action);
            _awaitingHuman = false;
            _showSlider = false;
        }
        catch (IllegalActionException)
        {
            return; // engine rejected it; keep waiting for a legal choice
        }
        StateHasChanged();
        await RunLoop(_loopToken);
    }

    private void OpenSlider()
    {
        _showSlider = true;
        _sliderValue = _legal.MinBetOrRaiseTo;
    }

    private void SetSlider(long amount) =>
        _sliderValue = Math.Clamp(amount, _legal.MinBetOrRaiseTo, _legal.MaxBetOrRaiseTo);

    private async Task ConfirmSlider()
    {
        long amount = _sliderValue;
        if (amount >= _legal.MaxBetOrRaiseTo) await Act(PlayerAction.AllIn());
        else if (_legal.CanBet) await Act(PlayerAction.Bet(amount));
        else await Act(PlayerAction.Raise(amount));
    }

    private void ToggleMode() => _quickMode = !_quickMode;

    // ------------------------------------------------------------- engine events

    private void OnEngineEvent(PokerEvent evt)
    {
        PlaySoundFor(evt);

        switch (evt)
        {
            case HandStarted started:
                _revealed.Clear();
                _banner = null;
                AddLog($"— Hand {started.HandNumber} —");
                break;

            case ShowdownStarted showdown:
                foreach (var kv in showdown.RevealedHands)
                {
                    _revealed[kv.Key] = kv.Value;
                    if (kv.Key != 0)
                        AddLog($"{NameOf(kv.Key)} shows {string.Join(" ", kv.Value)}");
                }
                break;

            case PlayerChecked checkedEvt:
                SceneAction(checkedEvt.Seat, "check");
                AddLog($"{NameOf(checkedEvt.Seat)} checks");
                break;

            case PlayerFolded foldedEvt:
                SceneAction(foldedEvt.Seat, "fold");
                AddLog($"{NameOf(foldedEvt.Seat)} folds");
                break;

            case PotAwarded award:
                foreach (int seatIdx in award.WinnerSeats) SceneReact(seatIdx, positive: true);
                string winners = string.Join(" & ", award.WinnerSeats.Select(NameOf));
                _banner = award.WinningHand.HasValue
                    ? $"{winners} win{(award.WinnerSeats.Count == 1 ? "s" : "")} ${award.Amount} — {Pretty(award.WinningHand.Value.Category)}"
                    : $"{winners} take{(award.WinnerSeats.Count == 1 ? "s" : "")} ${award.Amount}";
                AddLog(_banner);
                break;

            default:
                // Chip-toss gesture whenever someone puts chips in the middle.
                switch (evt)
                {
                    case PlayerCalled pc: SceneAction(pc.Seat, "bet"); break;
                    case BetPlaced bp: SceneAction(bp.Seat, "bet"); break;
                    case PlayerRaised pr: SceneAction(pr.Seat, "bet"); break;
                    case PlayerAllIn pa: SceneAction(pa.Seat, "bet"); break;
                }
                string line = Describe(evt);
                if (line != null) AddLog(line);
                break;
        }
    }

    private string Describe(PokerEvent evt) => evt switch
    {
        BlindPosted b => $"{NameOf(b.Seat)} posts {(b.IsBigBlind ? "big blind" : "small blind")} ${b.Amount}",
        PlayerChecked c => $"{NameOf(c.Seat)} checks",
        PlayerCalled c => $"{NameOf(c.Seat)} calls ${c.AddedAmount}",
        BetPlaced b => $"{NameOf(b.Seat)} bets ${b.ToAmount}",
        PlayerRaised r => $"{NameOf(r.Seat)} raises to ${r.ToAmount}",
        PlayerFolded f => $"{NameOf(f.Seat)} folds",
        PlayerAllIn a => $"{NameOf(a.Seat)} is ALL-IN (${a.ToAmount})",
        UncalledBetReturned u => $"${u.Amount} returned to {NameOf(u.Seat)}",
        FlopDealt f => $"Flop: {f.Card1} {f.Card2} {f.Card3}",
        TurnDealt t => $"Turn: {t.Card}",
        RiverDealt r => $"River: {r.Card}",
        PlayerEliminated e => $"{NameOf(e.Seat)} is eliminated!",
        _ => null
    };

    private void AddLog(string line)
    {
        _log.Insert(0, line);
        while (_log.Count > 60) _log.RemoveAt(_log.Count - 1);
    }

    // ------------------------------------------------------------------ helpers

    private string NameOf(int seat) => _game.GetPlayer(seat).Name;

    private static string Pretty(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high card",
        HandCategory.Pair => "a pair",
        HandCategory.TwoPair => "two pair",
        HandCategory.ThreeOfAKind => "three of a kind",
        HandCategory.Straight => "a straight",
        HandCategory.Flush => "a flush",
        HandCategory.FullHouse => "a full house",
        HandCategory.FourOfAKind => "four of a kind",
        HandCategory.StraightFlush => "a straight flush",
        HandCategory.RoyalFlush => "a ROYAL FLUSH",
        _ => category.ToString()
    };

    private SeatState SeatOf(int seat)
    {
        if (Round == null) return null;
        foreach (SeatState s in Round.Seats)
            if (s.Seat == seat) return s;
        return null;
    }

    private IReadOnlyList<Card> HoleCardsOf(int seat) =>
        SeatOf(seat)?.HoleCards ?? (IReadOnlyList<Card>)Array.Empty<Card>();

    // Kenney boardgame pack card faces (CC0) — see ASSET_LICENSES.md.
    private static string CardImage(Card card)
    {
        string rank = card.Rank == Rank.Ten ? "10" : Card.RankSymbol(card.Rank);
        return $"img/cards/{card.Suit.ToString().ToLowerInvariant()}_{rank}.png";
    }

    // -------------------------------------------------------------- backdrop

    private string _backdropName = "ARCADE";

    private async Task CycleBackdrop()
    {
        _backdropName = await JS.InvokeAsync<string>("pokerScene.cycleBackdrop");
    }

    // -------------------------------------------------------------- sounds

    private bool _muted;

    private void ToggleMute()
    {
        _muted = !_muted;
        _ = JS.InvokeVoidAsync("pokerAudio.setMuted", _muted);
    }

    private static readonly Dictionary<string, string[]> SoundGroups = new()
    {
        ["shuffle"] = new[] { "card-shuffle" },
        ["deal"] = new[] { "card-slide-1", "card-slide-2", "card-slide-3" },
        ["place"] = new[] { "card-place-1", "card-place-2" },
        ["fold"] = new[] { "card-shove-1" },
        ["chips"] = new[] { "chips-stack-1", "chips-stack-2", "chips-stack-3" },
        ["raise"] = new[] { "chips-handle-1", "chips-handle-2" },
        ["allin"] = new[] { "chips-collide-1", "chips-collide-2" }
    };

    private int _dealSoundIndex;

    private void PlaySound(string group, int delayMs = 0)
    {
        if (_muted) return;
        string[] variants = SoundGroups[group];
        _ = JS.InvokeVoidAsync("pokerAudio.play", variants[_rng.Next(variants.Length)], delayMs);
    }

    private void PlaySoundFor(PokerEvent evt)
    {
        // Your two cards land audibly after the shuffle, not on top of it.
        if (evt is HandStarted) _dealSoundIndex = 0;
        if (evt is CardDealt dealtCard && dealtCard.Seat == 0)
        {
            PlaySound("place", 700 + _dealSoundIndex++ * 280);
            return;
        }

        string group = evt switch
        {
            HandStarted _ => "shuffle",
            FlopDealt _ => "deal",
            TurnDealt _ => "deal",
            RiverDealt _ => "deal",
            BetPlaced _ => "chips",
            PlayerCalled _ => "chips",
            PlayerRaised _ => "raise",
            PlayerAllIn _ => "allin",
            PlayerFolded _ => "fold",
            PotAwarded _ => "allin", // big pile of chips pushed to the winner
            _ => null
        };
        if (group != null) PlaySound(group);
    }
}
