@page "/"
@using CinematicPoker.Engine.AI
@using CinematicPoker.Engine.Players
@using CinematicPoker.Engine.Poker
@using CinematicPoker.Engine.Simulation
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>Dead Man's Hand</PageTitle>

@* Tapping anywhere outside the enlarged card close-up contracts it back
   to its corner size; the close-up itself stops propagation so its own
   tap still toggles (see ToggleHudBoard). *@
<div class="game3d @(_hudBoardExpanded ? "board-expanded" : "") @(_shotBusy ? "shot-busy" : "")"
     @onclick="CollapseHudBoard">

    <canvas id="poker-canvas"></canvas>

    @if (!_introStarted)
    {
        <div class="intro-overlay intro-splash @(_introFading ? "fading" : "") @(_namePromptOpen ? "prompting" : "")"
             @onclick="StartIntro" role="button" aria-label="Tap to play">
            @if (_namePromptOpen)
            {
                <div class="name-prompt" @onclick:stopPropagation="true">
                    <div class="intro-title">WHAT DO THEY <span>CALL YOU</span></div>
                    <p class="name-blurb">We’ll remember it on this device so you only enter it once.</p>
                    <div class="name-entry-row">
                        <input class="name-input" type="text" maxlength="16"
                               autocapitalize="words" autocomplete="nickname" autocorrect="off" spellcheck="false"
                               placeholder="Your name" @bind="_nameDraft" @bind:event="oninput"
                               @onkeydown="OnNameKeyDown" />
                        <button class="act call big" disabled="@(!CanConfirmName)" @onclick="ConfirmName">SIT DOWN</button>
                    </div>
                </div>
            }
            else if (_sceneLoading)
            {
                @* Play was tapped but the scene (saloon backdrop included) is
                   still downloading — say so instead of silently sitting on
                   the splash or, worse, revealing a background-less table. *@
                <div class="intro-loading" aria-live="polite">SETTING THE TABLE</div>
            }
            else
            {
                @* Title art + TAP TO PLAY live in the splash image; keep a
                   pulsing hotspot over the painted CTA so the cue still animates. *@
                <div class="intro-tap-pulse" aria-hidden="true"></div>
            }
        </div>
    }
    <header class="topbar">
        <div class="brand">DEAD MAN'S <span>HAND</span></div>
        <div class="topbar-right">
            <button class="chip-btn" @onclick="OpenHandRankings" title="Poker hand rankings">
                <span class="chip-gear" aria-hidden="true">♠</span> HANDS
            </button>
            <button class="chip-btn" @onclick="OpenSettings" title="Game settings">
                <span class="chip-gear" aria-hidden="true">⚙</span> SETTINGS
            </button>
        </div>
    </header>

    @if (Round != null)
    {
        <div class="hud-meters">
            <div class="hud-stack" title="Chips you have left">
                <span class="hud-stack-icon" aria-hidden="true"></span>
                <span class="hud-stack-name" style="color:@SeatColor(0)">@PlayerName.ToUpperInvariant()</span>
                <b>$@ShownStack(0)</b>
            </div>
            <div class="hud-pot">POT&nbsp;<b>$@Round.PotTotal</b></div>
            @* While the enlarged card close-up owns the right edge, the
               current actor's window joins this column under the pot pill
               so the big cards can never cover it. *@
            @if (_hudBoardExpanded && HudActor != null)
            {
                @ActorCardFragment
            }
        </div>

        <div class="hud-board @(_hudBoardExpanded ? "expanded" : "")"
             @onclick="ToggleHudBoard" @onclick:stopPropagation="true">
            <div class="hud-row">
                @* Dealt cards fill from the right so they hug the border,
                   aligned above the player's pair. *@
                @for (int i = 0; i < 5; i++)
                {
                    var dealt = i - (5 - _shownBoard.Count);
                    if (dealt >= 0)
                    {
                        <img class="hud-card" src="@CardImage(_shownBoard[dealt])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
            <div class="hud-row hud-hole">
                @{ IReadOnlyList<Card> hudHole = SeatOf(0) is { Folded: true } ? Array.Empty<Card>() : HoleCardsOf(0); }
                @for (int i = 0; i < 2; i++)
                {
                    if (i < hudHole.Count)
                    {
                        <img class="hud-card" src="@CardImage(hudHole[i])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
            @if (HudWinningHand is { } winHand)
            {
                <div class="hud-row hud-winner" title="@winHand.Name's winning hand">
                    <span class="hud-winner-name" style="color:@SeatColor(winHand.Seat)">@winHand.Name</span>
                    @foreach (var card in winHand.Cards)
                    {
                        <img class="hud-card" src="@CardImage(card)" alt="" />
                    }
                </div>
            }
            @* First-game-only tutorial callout (see MaybeShowBoardHint).
               It lives inside the panel so it follows the cards at every
               breakpoint, and a tap on it bubbles into ToggleHudBoard —
               doing exactly what it teaches, which also dismisses it. *@
            @if (_boardHintVisible && _introStarted && !_hudBoardExpanded)
            {
                <div class="board-hint" role="note">
                    <span class="board-hint-arrow" aria-hidden="true"></span>
                    TAP the community cards to see a close-up comparison
                </div>
            }
        </div>
    }

    @if (_banner != null)
    {
        @* While the result is announced, fade the table (3D cards, board
           HUD) behind a dim veil so the banner and the hand-compare strip
           are the only bright things on screen. Sits above the z:5 HUD
           layers but below .hud-bottom (8) and .banner (12). *@
        <div class="result-dim" aria-hidden="true"></div>
        <div class="banner @(_playerWonPot ? "banner-win" : "banner-result")">
            @if (_bannerAmount.HasValue)
            {
                <div class="banner-amount">$@_bannerAmount.Value</div>
            }
            @if (HudWinningHand is { } winHand)
            {
                <div class="banner-cards">
                    @foreach (var card in winHand.Cards)
                    {
                        <img class="hud-card" src="@CardImage(card)" alt="" />
                    }
                </div>
            }
            <div class="banner-line">@_banner</div>
            @if (_playerWonPot)
            {
                <button type="button" class="act victory-shot" disabled="@_shotBusy"
                        @onclick="TakeVictoryScreenshot" @onclick:stopPropagation="true">
                    Victory Screen-Shot!
                </button>
                @if (!string.IsNullOrEmpty(_shotStatus))
                {
                    <div class="victory-shot-status">@_shotStatus</div>
                }
            }
        </div>
    }

    @* Every window along the bottom edge shares one flow column: the
       showdown strip, Maximilian's advisor, the actor card and the action
       bar stack on top of each other instead of overlapping, whatever
       height each one happens to have. *@
    <div class="hud-bottom">

    @if (_showdownView.Count > 0)
    {
        <div class="showdown-strip">
            @foreach (var row in _showdownView)
            {
                <div class="showdown-seat @(row.Winner ? "winner" : "")">
                    <div class="showdown-name" style="color:@SeatColor(row.Seat)">@row.Name</div>
                    <div class="showdown-cards">
                        @foreach (var card in row.Cards)
                        {
                            <img class="hud-card" src="@CardImage(card)" alt="" />
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(row.HandName))
                    {
                        <div class="showdown-hand">@row.HandName</div>
                    }
                </div>
            }
        </div>
    }

    <div class="hud-bottom-row">

    @* Expanded close-up moves this window up under the pot pill instead
       (see the hud-meters block above). Round == null is a safety net so
       the card is never lost entirely when the meters aren't rendered. *@
    @if (HudActor != null && (!_hudBoardExpanded || Round == null))
    {
        @ActorCardFragment
    }

    @* "What would AI do?" — Maximilian, the card-counting pro. On your turn
       only the title button shows; his advice stays hidden until you tap it,
       so the read is never spoiled before you've asked for it. Tap again to
       put it away. It starts hidden again on every new turn. *@
    @if (_awaitingHuman)
    {
        <div class="ai-advice @(_adviceCollapsed ? "collapsed" : "")" @onclick="ToggleAdvice"
             title="Tap and Maximilian counts the cards and tells you what he'd do">
            <div class="ai-advice-title">WHAT WOULD <span>AI</span> DO?</div>
            @if (!_adviceCollapsed && _advice != null)
            {
                <div class="ai-advice-action">@_advice.ActionLabel</div>
                <div class="ai-advice-stats">
                    <span class="ai-stat">WIN <b>@_advice.WinPercent%</b></span>
                    @if (_advice.PotOddsPercent.HasValue)
                    {
                        <span class="ai-stat">POT ODDS <b>@_advice.PotOddsPercent%</b></span>
                    }
                    <span class="ai-stat">VS <b>@_advice.Opponents</b></span>
                </div>
                <div class="ai-advice-why">@_advice.Rationale</div>
                <div class="ai-advice-sig">— Maximilian, card counter</div>
            }
        </div>
    }

    </div>

    <div class="actionbar">
        @if (_awaitingHuman && _legal != null && !_showSlider)
        {
            <div class="actionbar-left">
                @if (_legal.CanFold) { <button class="act fold" @onclick="() => Act(PlayerAction.Fold())">FOLD</button> }
            </div>
            <div class="actionbar-right">
                @if (_legal.CanCheck) { <button class="act check" @onclick="() => Act(PlayerAction.Check())">CHECK</button> }
                @if (_legal.CanCall)  { <button class="act call" @onclick="() => Act(PlayerAction.Call())">CALL $@_legal.CallAmount</button> }
                @if (_legal.CanBet)   { <button class="act bet" @onclick="OpenSlider">BET</button> }
                @if (_legal.CanRaise) { <button class="act bet" @onclick="OpenSlider">RAISE</button> }
                @if (_legal.CanAllIn) { <button class="act allin" @onclick="() => Act(PlayerAction.AllIn())">ALL-IN</button> }
            </div>
        }
        else if (_awaitingHuman && _legal != null && _showSlider)
        {
            <div class="slider-panel">
                @* The thumb travels through a normalized scale. The displayed
                   amount is mapped logarithmically so small bets get much more
                   of the slider than they would on a linear $20-$4,000 range. *@
                <div class="slider-control">
                    <input type="range" min="0" max="@BetSliderSteps" step="1"
                           value="@_sliderPosition" aria-label="Bet amount"
                           aria-valuetext="$@_sliderValue"
                           @oninput="OnSliderInput"
                           @onpointerdown="BeginSliderInteraction"
                           @onpointerup="EndSliderInteraction"
                           @onpointercancel="EndSliderInteraction" />
                    <span class="slider-tooltip @(_sliderInteracting ? "visible" : "")" role="tooltip"
                          style="left: @SliderPercent%;">$@_sliderValue</span>
                </div>
                <div class="slider-row">
                    <span class="slider-amount">$@_sliderValue</span>
                    <button class="act small" @onclick="() => SetSlider(PotNow / 2)">½ POT</button>
                    <button class="act small" @onclick="() => SetSlider(PotNow)">POT</button>
                    <button class="act small" @onclick="() => SetSlider(_legal.MaxBetOrRaiseTo)">MAX</button>
                    <button class="act call" @onclick="ConfirmSlider">CONFIRM</button>
                    <button class="act small" @onclick="CloseSlider">BACK</button>
                </div>
            </div>
        }
        else if (_game != null && !_sessionOver)
        {
            <div class="waiting">@_statusLine</div>
            @if (CanFastForward)
            {
                @if (!_awaitingNextHand)
                {
                    @* Folded and spectating: step through the action one tap
                       at a time, or jump straight to the next hand. *@
                    <div class="actionbar-right">
                        <button class="act ff" @onclick="FastForward"
                                title="Skip to the next action">
                            SKIP »
                        </button>
                        <button class="act ff ff-next" @onclick="SkipToNextHand"
                                title="Fast-forward to the next hand">
                            NEXT HAND »
                        </button>
                    </div>
                }
                else
                {
                    <button class="act ff" @onclick="FastForward"
                            title="@NextHandButtonTitle">
                        @NextHandButtonLabel
                    </button>
                }
            }
        }
    </div>

    </div>

    @if (_sessionOver)
    {
        <div class="overlay" role="dialog" aria-label="@_sessionOverMessage">
            <div class="overlay-box @(_humanLost ? "game-over" : _humanWon ? "table-win" : "")">
                <div class="overlay-title">@_sessionOverMessage</div>
                <div class="overlay-actions">
                    @if (_humanLost || _humanWon)
                    {
                        @if (_humanWon)
                        {
                            <button type="button" class="act victory-shot" disabled="@_shotBusy"
                                    @onclick="TakeVictoryScreenshot" @onclick:stopPropagation="true">
                                Victory Screen-Shot!
                            </button>
                            @if (!string.IsNullOrEmpty(_shotStatus))
                            {
                                <div class="victory-shot-status">@_shotStatus</div>
                            }
                        }
                        <button class="act call big restart-btn" @onclick="ContinueGame">CONTINUE GAME</button>
                        <div class="overlay-blurb">@ContinueGameBlurb</div>
                        <button class="act allin big restart-btn" @onclick="StartSession">RESTART</button>
                        <button class="act small" @onclick="OpenExportPanel">EXPORT STATS</button>
                    }
                    else
                    {
                        <button class="act call big" @onclick="OpenExportPanel">EXPORT STATS</button>
                        <button class="act call big" @onclick="StartSession">PLAY AGAIN</button>
                    }
                </div>
            </div>
        </div>
    }

    @if (_settingsOpen)
    {
        <div class="overlay" @onclick="CloseSettings">
            <div class="overlay-box settings-box" @onclick:stopPropagation="true">
                <div class="overlay-title">SETTINGS</div>

                <div class="settings-name">
                    <label class="settings-label" for="settings-name-input">YOUR NAME</label>
                    <div class="settings-name-controls">
                        <input id="settings-name-input" class="name-input settings-name-input" type="text" maxlength="16"
                               autocapitalize="words" autocomplete="nickname" autocorrect="off" spellcheck="false"
                               placeholder="Your name" @bind="_settingsNameDraft" @bind:event="oninput"
                               @onkeydown="OnSettingsNameKeyDown" />
                        <button class="act call settings-save" disabled="@(!CanSaveSettingsName)" @onclick="SaveSettingsName">SAVE</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_settingsNameNote))
                    {
                        <p class="settings-note">@_settingsNameNote</p>
                    }
                </div>

                <div class="settings-rows">
                    <div class="settings-row">
                        <span class="settings-label">SOUND</span>
                        <button class="chip-btn @(_muted ? "" : "active")" @onclick="ToggleMute">
                            @(_muted ? "SOUND OFF" : "SOUND ON")
                        </button>
                    </div>
                    <div class="settings-row">
                        <span class="settings-label">PACE</span>
                        <button class="chip-btn @(_quickMode ? "active" : "")" @onclick="ToggleMode">
                            @(_quickMode ? "QUICK PLAY" : "CINEMATIC")
                        </button>
                    </div>
                    <div class="settings-row">
                        <span class="settings-label">DIFFICULTY</span>
                        <button class="chip-btn" @onclick="CycleDifficulty">@DifficultyNames[_difficulty]</button>
                    </div>
                    <div class="settings-row">
                        <label class="settings-label" for="settings-scene">SCENE</label>
                        <select id="settings-scene" class="chip-btn settings-select" @onchange="OnTableSceneChanged">
                            <option value="saloon" selected="@(_tableScene == "saloon")">SALOON</option>
                            <option value="street" selected="@(_tableScene == "street")">STREET FIGHTER</option>
                        </select>
                    </div>
                </div>

                <div class="overlay-actions">
                    <button class="act small" @onclick="ExportFromSettings">EXPORT STATS</button>
                    <button class="act allin settings-restart" @onclick="RestartFromSettings">RESTART</button>
                    <button class="act small" @onclick="CloseSettings">CLOSE</button>
                </div>
            </div>
        </div>
    }

    @if (_handRankingsOpen)
    {
        <div class="overlay" @onclick="CloseHandRankings">
            <div class="overlay-box hands-box" @onclick:stopPropagation="true">
                <img class="hands-chart" src="img/hand-rankings.jpg"
                     alt="Poker hand rankings from best to worst: royal flush, straight flush, four of a kind, full house, flush, straight, three of a kind, two pair, pair, high card" />
                <div class="overlay-actions">
                    <button class="act small" @onclick="CloseHandRankings">CLOSE</button>
                </div>
            </div>
        </div>
    }

    @if (_exportOpen)
    {
        <div class="overlay" @onclick="CloseExportPanel">
            <div class="overlay-box export-box" @onclick:stopPropagation="true">
                <div class="overlay-title">EXPORT STATS</div>
                <p class="export-blurb">
                    Send your session history and coaching notes as a .csv file via email or text
                    @if (_handLog.CompletedHandCount > 0)
                    {
                        <text> · @_handLog.CompletedHandCount hand@(_handLog.CompletedHandCount == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text> · no hands yet</text>
                    }
                </p>
                @if (!string.IsNullOrEmpty(_exportNote))
                {
                    <p class="export-note">@_exportNote</p>
                }
                <div class="export-actions">
                    <button class="act call" @onclick="ExportViaEmail" disabled="@(_handLog.CompletedHandCount == 0)">EMAIL CSV</button>
                    <button class="act bet" @onclick="ExportViaText" disabled="@(_handLog.CompletedHandCount == 0)">TEXT CSV</button>
                    <button class="act small" @onclick="ExportDownload" disabled="@(_handLog.CompletedHandCount == 0)">DOWNLOAD</button>
                    <button class="act small" @onclick="CloseExportPanel">CLOSE</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly Func<AIProfile>[] Roster =
    {
        AIProfile.Maniac,
        AIProfile.Regular,
        AIProfile.Rock,
        AIProfile.CallingStation,
        AIProfile.Professional
    };

    // Per-seat accent colours: every name in the HUD is painted with its
    // seat's colour, and the 3D scene tints that character's hat to match,
    // so a name always points at a hat around the table. Keep in sync with
    // SEAT_COLORS in wwwroot/js/poker-scene.js.
    private static readonly string[] SeatColors =
        { "#e0b84a", "#d87a6a", "#7aa5d8", "#8cc47e", "#c08ad8", "#5ec8b8" };

    private static string SeatColor(int seat) => SeatColors[seat % SeatColors.Length];

    // Table nicknames handed out at random each time a fresh roster sits down,
    // so any given personality can wear any of these names.
    private static readonly string[] NpcNamePool =
    {
        "Nickey 2-guns",
        "Tommy Gunn",
        "Stevie Wanders",
        "Jimmy two-hands",
        "Simmo Says"
    };

    private string[] ShuffledNpcNames()
    {
        var names = (string[])NpcNamePool.Clone();
        for (int i = names.Length - 1; i > 0; i--)
        {
            int j = _rng.Next(i + 1);
            (names[i], names[j]) = (names[j], names[i]);
        }
        return names;
    }

    // ---------------------------------------------------------- difficulty

    private static readonly string[] DifficultyNames = { "AI EASY", "AI NORMAL", "AI HARD" };
    private int _difficulty = 1; // NORMAL

    private void CycleDifficulty()
    {
        _difficulty = (_difficulty + 1) % DifficultyNames.Length;
        if (_game == null) return;
        // Retune the live NPCs in place, mid-session: rebuild each personality
        // preset at the new difficulty and write it into the existing profile.
        for (int i = 0; i < Roster.Length; i++)
        {
            if (_game.GetPlayer(i + 1) is AIPlayer ai)
                CopyProfile(WithDifficulty(Roster[i]()), ai.Profile);
        }
    }

    // Scales each personality's competence up or down without erasing what
    // makes them distinct: aggression and tightness stay untouched, only the
    // "how well do they actually play" parameters move.
    private AIProfile WithDifficulty(AIProfile p)
    {
        if (_difficulty == 0) // EASY: sloppier reads, more mistakes, tilts easily
        {
            p.Skill *= 0.45;
            p.PotOddsAccuracy *= 0.45;
            p.HandReadingAbility *= 0.45;
            p.PositionAwareness *= 0.5;
            p.OpponentAwareness *= 0.5;
            p.BluffFrequency *= 0.7;
            p.DecisionNoise = Math.Min(1, p.DecisionNoise + 0.15);
            p.TiltSensitivity = Math.Min(1, p.TiltSensitivity + 0.2);
        }
        else if (_difficulty == 2) // HARD: sharper reads, fewer mistakes, cool heads
        {
            p.Skill += (1 - p.Skill) * 0.55;
            p.PotOddsAccuracy += (1 - p.PotOddsAccuracy) * 0.55;
            p.HandReadingAbility += (1 - p.HandReadingAbility) * 0.55;
            p.PositionAwareness += (1 - p.PositionAwareness) * 0.5;
            p.OpponentAwareness += (1 - p.OpponentAwareness) * 0.5;
            p.DecisionNoise *= 0.35;
            p.TiltSensitivity *= 0.5;
        }
        return p;
    }

    private static void CopyProfile(AIProfile from, AIProfile into)
    {
        into.Skill = from.Skill;
        into.Aggression = from.Aggression;
        into.Tightness = from.Tightness;
        into.BluffFrequency = from.BluffFrequency;
        into.RiskTolerance = from.RiskTolerance;
        into.TiltSensitivity = from.TiltSensitivity;
        into.PositionAwareness = from.PositionAwareness;
        into.OpponentAwareness = from.OpponentAwareness;
        into.PotOddsAccuracy = from.PotOddsAccuracy;
        into.HandReadingAbility = from.HandReadingAbility;
        into.DecisionNoise = from.DecisionNoise;
        into.EmotionalBias = from.EmotionalBias;
    }

    private PokerGame _game;
    private HandSequenceLog _handLog = new();
    private readonly Random _rng = new();
    private bool _webSnapshotLoaded;
    private static readonly JsonSerializerOptions SnapshotJson =
        new JsonSerializerOptions { IncludeFields = true };

    private sealed class WebSeatSnapshot
    {
        public int seat;
        public string id;
        public string name;
        public long stack;
        public bool eliminated;
        public double tilt;
        public double confidence;
    }

    private sealed class WebSessionSnapshot
    {
        public int version = 1;
        public string playerName;
        public int difficulty;
        public bool quickMode;
        public bool muted;
        public string tableScene;
        public int handNumber;
        public int dealerSeat;
        public List<WebSeatSnapshot> seats = new();
        public PokerRoundSnapshot round;
    }
    private readonly Dictionary<int, IReadOnlyList<Card>> _revealed = new();
    // Result audio belongs to the hand outcome, not to the shape of the
    // showdown. This matters for an immediate all-in, where the engine can
    // reveal more than two hands or award a fold-win without a showdown.
    private bool _victoryPlayedThisHand;
    private bool _playerLossPlayedThisHand;

    // The engine resolves a hand synchronously (a call on the turn can deal
    // the river, reveal hands and award the pot in one burst), so its events
    // are queued here and presented one at a time with dwell pauses. These
    // hold what the table currently SHOWS, which can lag the engine state.
    private readonly Queue<PokerEvent> _pending = new();
    private readonly List<Card> _shownBoard = new();

    private LegalActions _legal;
    private bool _awaitingHuman;
    private bool _showSlider;
    private long _sliderValue;
    private int _sliderPosition;
    private bool _sliderInteracting;
    private bool _quickMode;
    private bool _sessionOver;
    private bool _humanLost;
    private bool _humanWon;
    private bool _hudBoardExpanded;
    private bool _exportOpen;
    private string _exportNote = "";
    private string _sessionOverMessage = "";
    private string _banner;
    private long? _bannerAmount;
    private bool _playerWonPot;
    private bool _shotBusy;
    private string _shotStatus;
    private readonly List<PotAwarded> _awardsThisHand = new();
    private int _pendingFocusSeat = -1;
    private readonly List<ShowdownRow> _showdownView = new();
    private string _statusLine = "";
    private int _loopToken;

    private sealed class ShowdownRow
    {
        public int Seat;
        public string Name;
        public IReadOnlyList<Card> Cards;
        public string HandName;
        public bool Winner;
    }

    private PokerRound Round => _game?.CurrentRound;
    private long PotNow => Round?.PotTotal ?? 0;

    // ------------------------------------------------------- fast forward

    // Once the player has folded they're only spectating, so two buttons
    // appear straight away:
    //  - SKIP: each tap cuts short one pacing wait (an NPC's think time, or
    //    a dwell pause before a street / showdown / pot award), stepping
    //    through the rest of the hand action by action as fast as the
    //    player taps.
    //  - NEXT HAND: one tap fast-forwards every remaining wait AND the
    //    result hold, going straight to the next deal.
    // After the pot is awarded (when the player didn't ask to jump ahead)
    // the SKIP control becomes NEXT HAND so the result stays on screen
    // until the player chooses to continue.
    private bool _skipRequested;
    private bool _skipToNextHand;
    private bool _awaitingNextHand;
    private bool _handHasCompleted;

    private bool HumanIsBusted => _game != null && _game.HasHumanLost;

    private bool CanFastForward =>
        _game != null && !_sessionOver && !_awaitingHuman
        && (_awaitingNextHand
            || (SeatOf(0) is { Folded: true }
                && (_game.Phase == GamePhase.HandInProgress || _pending.Count > 0)));

    // Labels for the single button shown while the result is on screen.
    private string NextHandButtonLabel => HumanIsBusted ? "CONTINUE" : "NEXT HAND";

    private string NextHandButtonTitle =>
        HumanIsBusted ? "See game over"
        : _game is { HasHumanWon: true } ? "Continue with your stack"
        : "Go to the next hand";

    private string ContinueGameBlurb =>
        _game == null ? ""
        : _humanLost
            ? $"Buy back in for ${_game.Rules.StartingStack}. Opponents keep their stacks."
            : $"Keep ${(_game.Human?.Stack ?? 0)} and sit a new table.";

    private void FastForward() => _skipRequested = true;

    // One tap, no more waits: every remaining pacing pause in this hand is
    // cut short and the result hold is bypassed, straight to the next deal.
    private void SkipToNextHand() => _skipToNextHand = true;

    // A pacing wait the fast-forward buttons can cut short. A SKIP tap skips
    // at most one wait, so skipped actions still land on the table one by
    // one; NEXT HAND stays latched and skips them all.
    private async Task PacedDelay(int ms, int token)
    {
        const int sliceMs = 50;
        for (int elapsed = 0; elapsed < ms; elapsed += sliceMs)
        {
            if (token != _loopToken) return;
            if (_skipToNextHand && CanFastForward) return;
            if (_skipRequested && CanFastForward)
            {
                _skipRequested = false;
                return;
            }
            await Task.Delay(sliceMs);
        }
        // The wait ran its course: drop any tap that was aimed at it so it
        // can't accidentally swallow the NEXT wait as well.
        _skipRequested = false;
    }

    // NPC turns are always at least 1 second apart so the table stays readable.
    private int ThinkTimeMs => _quickMode ? 1000 : _rng.Next(1000, 2200);
    private int NextHandDelayMs => _quickMode ? 700 : 2600;
    private const int EquityIterations = 200;
    private const int PlayerNameMaxLength = 16;

    private string _playerName = "";
    private string _nameDraft = "";
    private bool _namePromptOpen;
    private bool _settingsLoaded;

    private string PlayerName => string.IsNullOrEmpty(_playerName) ? "Player" : _playerName;
    private bool CanConfirmName => SanitizeName(_nameDraft, allowEmpty: true).Length > 0;

    // -------------------------------------------------------- tap to play

    private bool _introStarted;
    private bool _introRequested;
    private bool _introFading;

    /* Matches the .intro-overlay.fading transition in app.css. */
    private const int IntroFadeMs = 3000;

    private async Task StartIntro()
    {
        if (_namePromptOpen) return;
        // The first tap can arrive before the asynchronous profile read has
        // completed. Do not silently discard it; finish loading the profile
        // and continue the same tap through the normal name/play flow.
        if (!_settingsLoaded)
        {
            _playerName = await ReadCachedPlayerNameAsync();
            _settingsLoaded = true;
        }
        if (string.IsNullOrEmpty(_playerName))
        {
            _namePromptOpen = true;
            _nameDraft = "";
            return;
        }
        await BeginPlay();
    }

    private async Task OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmName();
    }

    private async Task ConfirmName()
    {
        if (!CanConfirmName) return;
        _playerName = SanitizeName(_nameDraft);
        await PersistPlayerName(_playerName);
        _namePromptOpen = false;
        if (_game == null) StartSession();
        await BeginPlay();
    }

    private async Task PersistPlayerName(string name)
    {
        if (string.IsNullOrEmpty(name)) return;
        try
        {
            if (JS is IJSInProcessRuntime sync)
                sync.InvokeVoid("pokerProfile.saveName", name);
            else
                await JS.InvokeVoidAsync("pokerProfile.saveName", name);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private string ReadCachedPlayerName()
    {
        try
        {
            if (JS is IJSInProcessRuntime sync)
            {
                string saved = sync.Invoke<string>("pokerProfile.loadName");
                return SanitizeName(saved, allowEmpty: true);
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        return "";
    }

    private async Task<string> ReadCachedPlayerNameAsync()
    {
        string sync = ReadCachedPlayerName();
        if (!string.IsNullOrEmpty(sync)) return sync;
        try
        {
            string saved = await JS.InvokeAsync<string>("pokerProfile.loadName");
            return SanitizeName(saved, allowEmpty: true);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        return "";
    }

    private static string SanitizeName(string raw, bool allowEmpty = false)
    {
        if (string.IsNullOrWhiteSpace(raw)) return allowEmpty ? "" : "Player";
        var cleaned = new System.Text.StringBuilder();
        foreach (char c in raw.Trim())
        {
            if (char.IsLetterOrDigit(c) || c is ' ' or '-' or '\'' or '.')
                cleaned.Append(c);
            if (cleaned.Length >= PlayerNameMaxLength) break;
        }
        string name = string.Join(" ", cleaned.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries));
        return name.Length > 0 ? name : allowEmpty ? "" : "Player";
    }

    private bool _sceneLoading;

    private async Task BeginPlay()
    {
        if (_introRequested) return;
        _introRequested = true; // the tap doubles as the audio-unlock gesture
        // Hold the title card up — with a visible loading notice — until the
        // whole scene (table, characters AND the saloon backdrop) is in
        // memory. The old 6-second cap dropped slow connections onto a table
        // whose background hadn't arrived yet. Stop waiting only if the scene
        // reports it cannot build at all (the HUD-only table still plays),
        // with a generous ceiling as a final safety net.
        if (!_sceneReady)
        {
            _sceneLoading = true;
            StateHasChanged();
            for (int i = 0; i < 480 && !_sceneReady; i++)
            {
                try
                {
                    // Same shared build as OnAfterRenderAsync's retries;
                    // driving it from here too covers boots where that loop
                    // exhausted its attempts while the scene module itself
                    // was still downloading.
                    _sceneReady = await JS.InvokeAsync<bool>("pokerScene.init", "poker-canvas");
                    if (!_sceneReady &&
                        await JS.InvokeAsync<string>("pokerScene.status") == "failed")
                        break;
                }
                catch (JSException) { /* scene module still downloading */ }
                if (!_sceneReady) await Task.Delay(250);
            }
            _sceneLoading = false;
            if (_sceneReady) await SyncBackdropLabel();
        }
        // Reveal the table first, then let the title card fade out over it.
        _introFading = true;
        StateHasChanged();
        // No opening camera sweep — go straight to the seated saloon view.
        try
        {
            await JS.InvokeVoidAsync("pokerScene.lockLandscape");
            await JS.InvokeVoidAsync("pokerScene.skipIntro");
        }
        catch (JSException)
        {
            // Scene module still loading; gameplay HUD is already live.
        }
        await Task.Delay(IntroFadeMs);
        _introStarted = true;
        await MaybeShowBoardHint();
    }

    // ------------------------------------- first-game community-cards hint

    // The very first time someone plays on this device, a small callout
    // under the community-cards window teaches the close-up comparison tap.
    // It goes away when the player tries it (ToggleHudBoard), when they tap
    // the callout itself (the tap bubbles into the same toggle), or after a
    // generous read timeout — and once dismissed it never comes back.
    private bool _boardHintVisible;
    private const int BoardHintTimeoutMs = 20000;

    private async Task MaybeShowBoardHint()
    {
        bool seen = true;
        try { seen = await JS.InvokeAsync<bool>("pokerProfile.boardHintSeen"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        if (seen) return;

        _boardHintVisible = true;
        StateHasChanged();
        _ = AutoDismissBoardHint();
    }

    private async Task AutoDismissBoardHint()
    {
        await Task.Delay(BoardHintTimeoutMs);
        if (_boardHintVisible) await DismissBoardHint();
    }

    private async Task DismissBoardHint()
    {
        if (!_boardHintVisible) return;
        _boardHintVisible = false;
        try { await JS.InvokeVoidAsync("pokerProfile.markBoardHintSeen"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        StateHasChanged();
    }

    // ------------------------------------------------------------- 3D scene

    private bool _sceneReady;

    protected override void OnInitialized()
    {
        // WASM can read localStorage synchronously here so TAP TO PLAY already
        // knows whether this device has a saved name.
        _playerName = ReadCachedPlayerName();
        _settingsLoaded = !string.IsNullOrEmpty(_playerName) || JS is IJSInProcessRuntime;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(_playerName))
                _playerName = await ReadCachedPlayerNameAsync();
            _settingsLoaded = true;
            if (!_webSnapshotLoaded)
            {
                _webSnapshotLoaded = true;
                string saved = "";
                try { saved = await JS.InvokeAsync<string>("pokerSession.load"); }
                catch (JSException) { }
                if (!string.IsNullOrEmpty(saved))
                    TryRestoreWebSession(saved);
                if (_game == null && !string.IsNullOrEmpty(_playerName))
                    StartSession();
            }
            StateHasChanged();

            // The scene module loads asynchronously; retry until it's there.
            for (int i = 0; i < 60 && !_sceneReady; i++)
            {
                try
                {
                    _sceneReady = await JS.InvokeAsync<bool>("pokerScene.init", "poker-canvas");
                }
                catch (JSException)
                {
                    await Task.Delay(250);
                }
            }
            if (_sceneReady) await SyncBackdropLabel();
        }
        if (_sceneReady) await PushSceneState();
        // One-shot: fly to the winner's cards after the snapshot has put them
        // on the felt. Cleared immediately so later HUD updates do not yank
        // the camera back if the player has already looked around.
        if (_sceneReady && _pendingFocusSeat >= 0)
        {
            int seat = _pendingFocusSeat;
            _pendingFocusSeat = -1;
            try { await JS.InvokeVoidAsync("pokerScene.focusReveal", seat); }
            catch (JSException) { }
        }
    }

    private async Task PushSceneState()
    {
        if (_game == null) return;

        // Capture the actor once for the whole snapshot. Reading CurrentSeat
        // independently while building each row made the scene's actor flag
        // vulnerable to a turn transition between rows, leaving the outline
        // and the HUD name briefly pointing at different seats.
        int actorSeat = _game.CurrentSeat;
        var seats = _game.Players.Select(p =>
        {
            SeatState s = SeatOf(p.Seat);
            bool folded = s != null && s.Folded;
            bool eliminated = ShownOut(p.Seat);
            bool acting = actorSeat == p.Seat;
            string status =
                folded ? "folded"
                : s != null && s.AllIn ? "ALL-IN"
                : s != null && s.CommittedThisStreet > 0 ? $"bet ${s.CommittedThisStreet}"
                : acting && !p.IsHuman ? "thinking…"
                : "";
            return new
            {
                seat = p.Seat,
                name = DisplayName(p),
                stack = ShownStack(p.Seat),
                bet = s?.CommittedThisStreet ?? 0,
                folded,
                @out = eliminated,
                actor = acting,
                // A render can briefly observe the round while its seat
                // collection is being replaced (new hand / continued game).
                // Missing seat state is not the same thing as folding: keep
                // the player active unless the engine explicitly says they
                // folded or were eliminated. Otherwise the WebGL reconciler
                // clears their cards and chips for one snapshot, and that
                // stale empty state can look like a random table animation.
                active = Round != null && !folded && !eliminated,
                heat = SeatHeat(p.Seat),
                dealer = Round != null && p.Seat == Round.DealerSeat,
                sb = Round != null && p.Seat == Round.SmallBlindSeat,
                bb = Round != null && p.Seat == Round.BigBlindSeat,
                reveal = p.Seat != 0 && _revealed.TryGetValue(p.Seat, out var shown)
                    ? shown.Select(CardImage).ToArray()
                    : null,
                status
            };
        }).ToArray();

        var snapshot = new
        {
            pot = Round?.PotTotal ?? 0,
            actorSeat,
            board = _shownBoard.Select(CardImage).ToArray(),
            // Folding mucks your cards: they leave your hand immediately.
            hole = SeatOf(0) is { Folded: true }
                ? Array.Empty<string>()
                : HoleCardsOf(0).Select(CardImage).ToArray(),
            seats
        };

        try { await JS.InvokeVoidAsync("pokerScene.update", snapshot); }
        catch (JSException ex)
        {
            // The scene self-heals on the next push, but surface the cause in
            // the browser console instead of hiding it — a silent failure here
            // is how seats ended up with no cards on the felt.
            Console.Error.WriteLine($"pokerScene.update failed: {ex.Message}");
        }
        await PersistWebSession();
    }

    private void SceneEmotion(int seat, string mood, double intensity, bool speak = true)
    {
        if (!_sceneReady) return;
        _ = JS.InvokeVoidAsync("pokerScene.emotion", seat, mood, intensity, speak);
    }

    // 0 = settled, 1 = steaming. Read from the NPC's tilt after each hand.
    private double SeatHeat(int seat)
    {
        if (_game?.GetPlayer(seat) is not AIPlayer ai) return 0.2;
        return Math.Clamp(
            ai.Tilt.Tilt * 0.55 + ai.Tilt.Frustration * 0.45 + (1 - ai.Tilt.Confidence) * 0.2,
            0, 1);
    }

    private double PotHeat(long amount)
    {
        long bb = Math.Max(1, _game?.Rules.BigBlind ?? 10);
        return Math.Clamp(amount / (double)(bb * 28), 0, 1);
    }

    // Anyone still in the hand, other than the actor, feels the bet.
    private void NudgeWaiting(int actorSeat, double intensity)
    {
        if (_game == null) return;
        foreach (PokerPlayer p in _game.Players)
        {
            if (p.IsHuman || p.Seat == actorSeat) continue;
            SeatState s = SeatOf(p.Seat);
            if (s == null || s.Folded || p.Status == PlayerStatus.Eliminated) continue;
            SceneEmotion(p.Seat, "wait", Math.Clamp(Math.Max(intensity, SeatHeat(p.Seat)), 0, 1));
        }
    }

    private void RememberHand(HandCompleted completed)
    {
        int biggest = -1;
        long best = long.MinValue;
        foreach (var kv in completed.StackChanges)
            if (kv.Value > best) { best = kv.Value; biggest = kv.Key; }
        long bb = Math.Max(1, _game.Rules.BigBlind);
        foreach (var kv in completed.StackChanges)
            if (_game.GetPlayer(kv.Key) is AIPlayer ai)
                ai.OnHandCompleted(kv.Value, bb, biggest);
    }

    // Action gestures play on NPC bodies. The player's body only gestures on
    // a fold — otherwise the scene keeps him in his card-holding idle until
    // the hand is decided (win/lose takes come via SceneEmotion/celebrate).
    private void SceneAction(int seat, string kind)
    {
        if (!_sceneReady) return;
        _ = JS.InvokeVoidAsync("pokerScene.action", seat, kind);
    }

    private void ClearWebSession()
    {
        try { _ = JS.InvokeVoidAsync("pokerSession.clear"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void TryRestoreWebSession(string json)
    {
        try
        {
            WebSessionSnapshot saved = JsonSerializer.Deserialize<WebSessionSnapshot>(json, SnapshotJson);
            if (saved == null || saved.version != 1 || saved.seats is not { Count: >= 2 })
                return;

            _playerName = SanitizeName(saved.playerName, allowEmpty: true);
            _difficulty = Math.Clamp(saved.difficulty, 0, DifficultyNames.Length - 1);
            _quickMode = saved.quickMode;
            _muted = saved.muted;
            _tableScene = saved.tableScene == "street" ? "street" : "saloon";

            var players = new List<PokerPlayer>();
            foreach (WebSeatSnapshot seat in saved.seats.OrderBy(s => s.seat))
            {
                if (seat.seat == 0)
                {
                    var human = new HumanPlayer("human", PlayerName, 0, Math.Max(0, seat.stack));
                    human.Status = seat.eliminated ? PlayerStatus.Eliminated : PlayerStatus.Active;
                    players.Add(human);
                    continue;
                }

                AIProfile profile = WithDifficulty(Roster[seat.seat - 1]());
                var npc = new AIPlayer(
                    string.IsNullOrEmpty(seat.id) ? $"npc{seat.seat - 1}" : seat.id,
                    string.IsNullOrEmpty(seat.name) ? $"Player {seat.seat}" : seat.name,
                    seat.seat, Math.Max(0, seat.stack), profile, _rng.Next());
                npc.Status = seat.eliminated ? PlayerStatus.Eliminated : PlayerStatus.Active;
                npc.Tilt.Tilt = seat.tilt;
                npc.Tilt.Confidence = seat.confidence;
                players.Add(npc);
            }

            if (players.Count < 2) return;
            _game = new PokerGame(TableRules.Default, players, _rng.Next());
            _game.EventEmitted += OnEngineEvent;
            _game.RestoreProgress(saved.handNumber, saved.dealerSeat);
            if (saved.round != null)
            {
                _game.RestoreRound(saved.round);
                _shownBoard.AddRange(_game.CurrentRound.Board);
            }
            _handLog = new HandSequenceLog();
            _handLog.BeginSession(0, TableRules.Default, players);
            _statusLine = saved.round == null ? "Dealing…" : "Resuming your hand…";
            _ = RunLoop(++_loopToken);
        }
        catch (Exception ex) when (ex is JsonException || ex is ArgumentException || ex is InvalidOperationException)
        {
            ClearWebSession();
        }
    }

    private async Task PersistWebSession()
    {
        if (_game == null) return;
        var saved = new WebSessionSnapshot
        {
            playerName = PlayerName,
            difficulty = _difficulty,
            quickMode = _quickMode,
            muted = _muted,
            tableScene = _tableScene,
            handNumber = _game.HandNumber,
            dealerSeat = _game.DealerSeat,
            round = Round?.Capture()
        };
        foreach (PokerPlayer player in _game.Players)
        {
            SeatState roundSeat = SeatOf(player.Seat);
            saved.seats.Add(new WebSeatSnapshot
            {
                seat = player.Seat,
                id = player.Id,
                name = player.Name,
                stack = roundSeat?.Stack ?? player.Stack,
                eliminated = player.Status == PlayerStatus.Eliminated,
                tilt = player is AIPlayer ai ? ai.Tilt.Tilt : 0.2,
                confidence = player is AIPlayer ai2 ? ai2.Tilt.Confidence : 0.5
            });
        }
        try
        {
            string json = JsonSerializer.Serialize(saved, SnapshotJson);
            await JS.InvokeVoidAsync("pokerSession.save", json);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void StartSession()
    {
        ClearWebSession();
        var rules = TableRules.Default;
        var players = new List<PokerPlayer> { new HumanPlayer("human", PlayerName, seat: 0, stack: rules.StartingStack) };
        string[] npcNames = ShuffledNpcNames();
        for (int i = 0; i < Roster.Length; i++)
        {
            players.Add(new AIPlayer($"npc{i}", npcNames[i], seat: i + 1, stack: rules.StartingStack,
                profile: WithDifficulty(Roster[i]()), seed: _rng.Next()));
        }

        _game = new PokerGame(rules, players, seed: _rng.Next());
        _game.EventEmitted += OnEngineEvent;

        _handLog = new HandSequenceLog();
        _handLog.BeginSession(0, rules, players);

        _revealed.Clear();
        _pending.Clear();
        _shownBoard.Clear();
        _showdownView.Clear();
        _banner = null;
        _bannerAmount = null;
        _playerWonPot = false;
        _shotBusy = false;
        _shotStatus = null;
        _pendingFocusSeat = -1;
        _sessionOver = false;
        _humanLost = false;
        _humanWon = false;
        _awaitingHuman = false;
        _showSlider = false;
        _advice = null;
        _skipRequested = false;
        _skipToNextHand = false;
        _awaitingNextHand = false;
        _handHasCompleted = false;
        _ = EndBetPreview(); // RESTART mid-sizing: drop the preview close-up
        _exportOpen = false;
        _exportNote = "";
        _settingsOpen = false;
        _handRankingsOpen = false;
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
        catch (InvalidOperationException) { }
        catch (JSException) { }

        _ = RunLoop(++_loopToken);
    }

    /// <summary>
    /// Keep James in the game when he still has chips or can buy back in.
    /// A bust rebies against the same opponents; a table win seats a new
    /// table and he keeps his stack.
    /// </summary>
    private void ContinueGame()
    {
        if (_game == null) return;
        try
        {
            if (_game.HasHumanLost)
            {
                _game.RebuyHuman();
            }
            else if (_game.HasHumanWon
                     || (_game.Human != null
                         && _game.Human.Status != PlayerStatus.Eliminated
                         && _game.Human.Stack >= _game.Rules.BigBlind))
            {
                _game.ContinueWithNewOpponents(CreateNpcRoster());
            }
            else
            {
                return;
            }
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch (ArgumentException)
        {
            return;
        }

        _sessionOver = false;
        _humanLost = false;
        _humanWon = false;
        _awaitingHuman = false;
        _showSlider = false;
        _advice = null;
        _skipRequested = false;
        _skipToNextHand = false;
        _awaitingNextHand = false;
        _handHasCompleted = false;
        _exportOpen = false;
        _banner = null;
        _bannerAmount = null;
        _playerWonPot = false;
        _shotBusy = false;
        _shotStatus = null;
        _pendingFocusSeat = -1;
        _showdownView.Clear();
        _statusLine = "Dealing…";
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        _ = EndBetPreview();
        _ = RunLoop(++_loopToken);
    }

    private List<PokerPlayer> CreateNpcRoster()
    {
        var npcs = new List<PokerPlayer>();
        string[] npcNames = ShuffledNpcNames();
        for (int i = 0; i < Roster.Length; i++)
        {
            npcs.Add(new AIPlayer($"npc{i}", npcNames[i], seat: i + 1, stack: TableRules.Default.StartingStack,
                profile: WithDifficulty(Roster[i]()), seed: _rng.Next()));
        }
        return npcs;
    }

    /// <summary>
    /// Table is down to one player, or James is busted. Losing shows GAME
    /// OVER; winning offers Continue Game so he can sit a new table with
    /// the chips he still has.
    /// </summary>
    private void FinishSession()
    {
        _humanLost = _game.HasHumanLost;
        _humanWon = _game.HasHumanWon;
        if (_humanLost)
        {
            _sessionOverMessage = "GAME OVER";
        }
        else if (_humanWon)
        {
            _sessionOverMessage = $"{PlayerName} takes the table!";
        }
        else
        {
            var winner = _game.AlivePlayers.Count > 0 ? _game.AlivePlayers[0] : null;
            _sessionOverMessage = winner == null
                ? "Nobody takes the table."
                : winner.IsHuman
                ? $"{PlayerName} cleaned out the whole table!"
                : $"{winner.Name} takes the table. Rough night.";
        }
        _sessionOver = true;
        _awaitingHuman = false;
        _awaitingNextHand = false;
        _showSlider = false;
        try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        StateHasChanged();
    }

    /// <summary>
    /// Drives the session: NPC turns with think-time pacing, pauses for human
    /// input, and waits for NEXT HAND after a result is shown. Cancelled by
    /// token when restarting.
    /// </summary>
    private async Task RunLoop(int token)
    {
        while (token == _loopToken)
        {
            // A finished table (James won, or only NPCs remain) still holds
            // on the result until NEXT HAND. Do not overlay immediately —
            // that skipped the banner and hid the action bar.
            bool tableSettled = _game.IsSessionOver || _game.HasHumanLost;
            if (tableSettled && !_handHasCompleted)
            {
                FinishSession();
                return;
            }

            if (_game.Phase == GamePhase.WaitingForHand || tableSettled)
            {
                if (_handHasCompleted && _skipToNextHand && !tableSettled)
                {
                    // The player asked for the next hand while spectating:
                    // don't hold on the result, deal straight away. A settled
                    // table (bust or table win) still holds below so the
                    // final result can never be skipped past.
                    _skipToNextHand = false;
                    _skipRequested = false;
                }
                else if (_handHasCompleted)
                {
                    // Hold on the win/lose banner until the player taps
                    // NEXT HAND. Ignore leftover SKIP taps from the just-
                    // finished hand so the result cannot be skipped by
                    // accident.
                    _skipRequested = false;
                    _skipToNextHand = false;
                    _awaitingNextHand = true;
                    _statusLine = HumanIsBusted
                        ? "Tap CONTINUE when you've seen the result"
                        : _game.HasHumanWon
                        ? "Tap NEXT HAND to keep your stack"
                        : "Tap NEXT HAND when you've seen the result";
                    StateHasChanged();
                    while (token == _loopToken && !_skipRequested)
                        await Task.Delay(50);
                    _skipRequested = false;
                    _awaitingNextHand = false;
                }
                else if (_game.Phase == GamePhase.WaitingForHand)
                {
                    _statusLine = "Dealing…";
                    StateHasChanged();
                    await Task.Delay(NextHandDelayMs);
                }
                if (token != _loopToken) return;

                // James still has chips and opponents remain: deal. Bust or
                // a table sweep goes to the overlay, where Continue Game
                // rebies or seats a new table with his stack.
                if (_game.HasHumanLost || _game.IsSessionOver)
                {
                    FinishSession();
                    return;
                }

                _handHasCompleted = false;
                _game.StartHand();
                await DrainEvents(token);
                continue;
            }

            PokerPlayer actor = _game.CurrentPlayer;
            if (actor == null) { await Task.Delay(50); continue; }

            if (actor.IsHuman)
            {
                _legal = _game.GetLegalActions();
                _sliderValue = _legal.MinBetOrRaiseTo;
                _sliderPosition = BetAmountToSliderPosition(_sliderValue);
                _showSlider = false;
                _advice = null;           // computed on demand when the button is tapped
                _adviceCollapsed = true;  // every turn starts as just the button
                _awaitingHuman = true;
                try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", true); }
                catch (JSException) { }
                StateHasChanged();
                return; // resumes via Act()
            }

            _statusLine = $"{actor.Name} is thinking…";
            StateHasChanged();
            await PacedDelay(ThinkTimeMs, token);
            if (token != _loopToken) return;

            var npc = (AIPlayer)actor;
            DecisionContext context = DecisionContext.ForCurrentActor(_game, EquityIterations);
            _game.SubmitAction(npc.DecideAction(context));
            await DrainEvents(token);
        }
    }

    private async Task Act(PlayerAction action)
    {
        if (!_awaitingHuman) return;
        try
        {
            _game.SubmitAction(action);
            _awaitingHuman = false;
            _showSlider = false;
            _advice = null;
            try { _ = JS.InvokeVoidAsync("pokerAudio.setAwaitingHuman", false); }
            catch (JSException) { }
        }
        catch (IllegalActionException)
        {
            return; // engine rejected it; keep waiting for a legal choice
        }
        StateHasChanged();
        await DrainEvents(_loopToken);
        await RunLoop(_loopToken);
    }

