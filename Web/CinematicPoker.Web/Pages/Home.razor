    private async Task OnTableSceneChanged(ChangeEventArgs e)
    {
        if (_isGuest) return;
        var next = e.Value?.ToString() == "street" ? "street" : "saloon";
        if (next == _tableScene) return;
        if (_coachOpen) await CloseCoach(false);
        _tableScene = next;
        GameLog.Info("ui", $"table scene -> {next}");
        if (_game != null)
            await PersistWebSession();
        try { await JS.InvokeVoidAsync("pokerScene.setTableScene", next); }
        catch (JSException) { }
    }

    private async Task SyncBackdropLabel()
    {
        var sceneBefore = _tableScene;
        try
        {
            var sceneId = await JS.InvokeAsync<string>("pokerScene.tableScene");
            if (sceneId == "street" || sceneId == "saloon") _tableScene = sceneId;
        }
        catch (JSException) { }
        if (_tableScene != sceneBefore) StateHasChanged();
        try
        {
            if (JS is IJSInProcessRuntime sync)
                sync.InvokeVoid("pokerAudio.setScene", _tableScene);
            else
                await JS.InvokeVoidAsync("pokerAudio.setScene", _tableScene);
        }
        catch (JSException) { }
    }

    // -------------------------------------------------------------- sounds

    // Two independently selectable audio channels (SOUND combo in settings):
    // MUSIC drives the music beds, BACKGROUND drives everything else (table
    // voices, chip/card effects and the crowd bed) as one switch.
    private bool _musicOn = true;
    private bool _backgroundOn = true;
    private bool _soundMenuOpen;

    private bool AnyChannelOn => _musicOn || _backgroundOn;

    private string SoundSummary => (_musicOn, _backgroundOn) switch
    {
        (true, true) => "ALL ON",
        (false, false) => "ALL OFF",
        (true, false) => "MUSIC ONLY",
        (false, true) => "BACKGROUND ONLY"
    };

    private void ToggleSoundMenu() => _soundMenuOpen = !_soundMenuOpen;

    private void ToggleChannel(string channel)
    {
        switch (channel)
        {
            case "music": _musicOn = !_musicOn; break;
            case "background": _backgroundOn = !_backgroundOn; break;
        }
        PushAudioChannels();
    }

    private void PushAudioChannels()
    {
        _ = JS.InvokeVoidAsync("pokerAudio.setChannels", new
        {
            music = _musicOn,
            voices = _backgroundOn,
            effects = _backgroundOn,
            ambience = _backgroundOn
        });
    }

    private void NextSong()
    {
        if (!_musicOn) return;
        // Synchronous JS so the new bed's HTMLAudio.play() still runs inside
        // the tap gesture (async interop can lose autoplay on some browsers).
        try
        {
            if (JS is IJSInProcessRuntime sync)
                sync.InvokeVoid("pokerAudio.nextSong");
            else
                _ = JS.InvokeVoidAsync("pokerAudio.nextSong");
        }
        catch (JSException) { }
    }

    private static readonly Dictionary<string, string[]> SoundGroups = new()
    {
        ["shuffle"] = new[] { "card-shuffle" },
        ["deal"] = new[] { "card-slide-1", "card-slide-2", "card-slide-3" },
        ["place"] = new[] { "card-place-1", "card-place-2" },
        ["fold"] = new[] { "card-shove-1" },
        ["chips"] = new[] { "chips-stack-1", "chips-stack-2", "chips-stack-3" },
        ["raise"] = new[] { "chips-handle-1", "chips-handle-2" },
        ["allin"] = new[] { "chips-collide-1", "chips-collide-2" }
    };

    private int _dealSoundIndex;

    private void PlaySound(string group, int delayMs = 0)
    {
        if (!_backgroundOn) return;
        string[] variants = SoundGroups[group];
        _ = JS.InvokeVoidAsync("pokerAudio.play", variants[_rng.Next(variants.Length)], delayMs);
    }

    private void PlaySoundFor(PokerEvent evt)
    {
        // Your two cards land audibly after the shuffle, not on top of it.
        if (evt is HandStarted) _dealSoundIndex = 0;
        if (evt is CardDealt dealtCard && dealtCard.Seat == 0)
        {
            PlaySound("place", 700 + _dealSoundIndex++ * 280);
            return;
        }

        string group = evt switch
        {
            HandStarted _ => "shuffle",
            FlopDealt _ => "deal",
            TurnDealt _ => "deal",
            RiverDealt _ => "deal",
            BetPlaced _ => "chips",
            PlayerCalled _ => "chips",
            PlayerRaised _ => "raise",
            PlayerAllIn _ => "allin",
            PlayerFolded _ => "fold",
            PotAwarded _ => "allin", // big pile of chips pushed to the winner
            _ => null
        };
        if (group != null) PlaySound(group);
    }
