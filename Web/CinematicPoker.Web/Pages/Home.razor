                <div class="overlay-actions">
                    <button class="act small" @onclick="CopyDebugLog" title="Copy the debug log to the clipboard to paste into Cursor or a bug report">COPY LOG</button>
                    <button class="act small" @onclick="ExportFromSettings">EXPORT STATS</button>
                    @if (_isGuest)
                    {
                        <button class="act allin settings-restart" @onclick="LeaveTable">LEAVE TABLE</button>
                    }
