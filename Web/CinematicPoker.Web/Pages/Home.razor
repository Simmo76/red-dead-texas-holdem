    private static string FormatVictoryDate(long utcMs) =>
        DateTimeOffset.FromUnixTimeMilliseconds(utcMs).ToLocalTime()
            .ToString("MMMM d, yyyy", CultureInfo.InvariantCulture).ToUpperInvariant();

    private static List<Card> ParseVictoryCards(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return new List<Card>();
        var list = new List<Card>();
        foreach (string token in text.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            try { list.Add(Card.Parse(token)); }
            catch (FormatException) { }
        }
        return list;
    }

    private void RecordPlayerVictory(long humanPayout)
    {
        VictoryWinRecord snap = BuildVictorySnapshot(humanPayout);
        StampVictoryIdentity(snap);
        if (_winGallery.Count > 0 && IsSameVictory(_winGallery[^1], snap))
            return;
        _winGallery.Add(snap);
        if (_winGallery.Count > MaxVictoryWins)
            _winGallery.RemoveRange(0, _winGallery.Count - MaxVictoryWins);
        _winGalleryIndex = _winGallery.Count - 1;
        TryAttachCoachSnapshot(snap);
        // A review left open from an earlier hand stays in _coachReview after
        // the panel closes. It belongs on this certificate only when it is
        // the review of this same hand.
        if (_coachReview != null && VictoryCoachAlignment.SameHand(snap.coachHandId, _coachReview.HandId))
            ApplyCoachToVictoryRecord(snap, _coachReview);
        _ = PersistWinGallery();
    }

    private static bool IsSameVictory(VictoryWinRecord existing, VictoryWinRecord snap)
    {
        if (existing == null || snap == null) return false;
        if (VictoryCoachAlignment.SameHand(existing.coachHandId, snap.coachHandId))
            return true;
        if (existing.handNumber != snap.handNumber) return false;
        if (!string.Equals(existing.holeCards ?? "", snap.holeCards ?? "", StringComparison.Ordinal))
            return false;
        if (!string.Equals(existing.boardCards ?? "", snap.boardCards ?? "", StringComparison.Ordinal))
            return false;
        if (!string.IsNullOrEmpty(existing.coachHandId)
            && !string.IsNullOrEmpty(snap.coachHandId)
            && !VictoryCoachAlignment.SameHand(existing.coachHandId, snap.coachHandId))
            return false;
        return true;
    }

    private VictoryWinRecord BuildVictorySnapshot(long humanPayout)
    {
        IReadOnlyList<Card> hole = BannerHandCards;
        return new VictoryWinRecord
        {
            version = 1,
            handNumber = _game?.HandNumber ?? 0,
            capturedAtUtcMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
            playerName = PlayerName,
            amount = humanPayout > 0 ? humanPayout : _bannerAmount ?? 0,
            headline = _banner ?? "",
            holeCards = hole is { Count: > 0 } ? HandSequenceLog.FormatCards(hole) : "",
            boardCards = _shownBoard.Count > 0 ? HandSequenceLog.FormatCards(_shownBoard) : ""
        };
    }

    private void ShowPreviousVictory()
    {
        if (!CanShowPreviousVictory) return;
        _ = ResetVictoryCarouselTrackAsync();
        _winGalleryIndex--;
        StateHasChanged();
    }

    private void ShowNextVictory()
    {
        if (!CanShowNextVictory) return;
        _ = ResetVictoryCarouselTrackAsync();
        _winGalleryIndex++;
        StateHasChanged();
    }

    private async Task ResetVictoryCarouselTrackAsync()
    {
        try { await JS.InvokeVoidAsync("pokerVictorySwipe.reset"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task TakeVictoryScreenshot()
    {
        if (_shotBusy) return;
        _shotBusy = true;
        _shotStatus = null;
        try
        {
            string result = await JS.InvokeAsync<string>("pokerShot.save");
            _shotStatus = result switch
            {
                "shared" => "Certificate shared",
                "downloaded" => "Certificate downloaded",
                "aborted" => null,
                _ => "Couldn't export the certificate"
            };
        }
        catch (JSException)
        {
            _shotStatus = "Couldn't export the certificate";
        }
        catch (InvalidOperationException)
        {
            _shotStatus = "Couldn't export the certificate";
        }
        finally
        {
            _shotBusy = false;
        }
    }

