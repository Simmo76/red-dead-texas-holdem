                _mpPill = "DISCONNECTED";
                break;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void SendToHost(MpMessage message) => _ = SafeInvoke("pokerRealtime.toHost", Encode(message));

    private void RequestSync() => SendToHost(new MpMessage { t = "sync" });

    // Who is human, in each guest's own seat numbers, so a join or a leave
    // shows or hides chat without waiting for the next deal.
    private void BroadcastRoster()
    {
        if (!_hosting) return;
        foreach (int guest in _remote.Keys.ToList())
        {
            var names = new string[TableSeats];
            var humans = new bool[TableSeats];
            if (_game != null)
            {
                foreach (PokerPlayer p in _game.Players)
                {
                    int j = Rot(p.Seat, guest);
                    if (j < 0 || j >= TableSeats) continue;
                    names[j] = p.Seat == 0 ? PlayerName : NameOf(p.Seat);
                    humans[j] = IsHumanSeat(p.Seat);
                }
            }
            else
            {
                int hostSeat = Rot(0, guest);
                if (hostSeat >= 0 && hostSeat < TableSeats)
                {
                    names[hostSeat] = PlayerName;
                    humans[hostSeat] = true;
                }
                foreach (KeyValuePair<int, RemoteSeat> kv in _remote)
                {
                    int j = Rot(kv.Key, guest);
                    if (j < 0 || j >= TableSeats) continue;
                    names[j] = kv.Value.Name;
                    humans[j] = true;
                }
            }
            SendToGuest(guest, new MpMessage { t = "roster", names = names, humans = humans });
        }
    }

    private void ApplyRoster(MpMessage m)
    {
        if (m.humans == null) return;
        _guestHumanSeats.Clear();
        int limit = Math.Min(TableSeats, m.humans.Length);
        for (int j = 1; j < limit; j++)
        {
            if (m.names != null && j < m.names.Length && !string.IsNullOrEmpty(m.names[j]))
                _seatNames[j] = m.names[j];
            if (m.humans[j]) _guestHumanSeats.Add(j);
        }
        SuppressAdviceForCompany();
        // The placeholder solo game is still on screen until the host's
        // first state arrives (_guestRot stays 0). Don't paint that over
        // the felt just because someone sat down.
        if (_guestRot != 0 && _sceneReady) _ = PushSceneState();
    }

    private void ApplyRemoteRename(int seat, string raw)
    {
        if (!_remote.TryGetValue(seat, out RemoteSeat remote)) return;
        string shown = SanitizeName(raw, allowEmpty: true);
        if (shown.Length == 0 || string.Equals(shown, remote.Name, StringComparison.Ordinal)) return;
        string previous = remote.Name;
        remote.Name = shown;
        _seatNames[seat] = shown;
        RefreshHostPill();
        BroadcastRoster();
        Announce($"{previous} is now {shown}.", skipSeat: seat);
        if (_sceneReady) _ = PushSceneState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Announce(string text, int skipSeat = -1)
    {
        text = SanitizeChat(text);
        if (text.Length == 0) return;
        AppendChat(null, text, 0, mine: false, system: true);
        if (!_hosting) return;
        foreach (int guest in _remote.Keys.ToList())
        {
            if (guest == skipSeat) continue;
            SendToGuest(guest, new MpMessage { t = "chat", a = "sys", text = text });
        }
    }

    private void ReceiveGuestChat(int seat, MpMessage m)
    {
        if (!IsRemote(seat)) return;
        if (_chatHeardAt.TryGetValue(seat, out DateTime last)
            && (DateTime.UtcNow - last).TotalMilliseconds < 250)
            return;
        string text = SanitizeChat(m.text);
        if (text.Length == 0) return;
        _chatHeardAt[seat] = DateTime.UtcNow;
        string name = _remote[seat].Name;
        AppendChat(name, text, seat, mine: false, system: false);
        foreach (int other in _remote.Keys.ToList())
        {
            if (other == seat) continue;
            SendToGuest(other, new MpMessage
            {
                t = "chat",
                who = name,
                text = text,
                seat = Rot(seat, other)
            });
        }
    }

    private void ReceiveRelayedChat(MpMessage m)
    {
        string text = SanitizeChat(m.text);
        if (text.Length == 0) return;
        if (m.a == "sys")
        {
            AppendChat(null, text, 0, mine: false, system: true);
            return;
        }
        string name = SanitizeName(m.who, allowEmpty: true);
        if (name.Length == 0) name = "Friend";
        int seat = m.seat;
        if (seat <= 0 || seat >= TableSeats) seat = 1;
        AppendChat(name, text, seat, mine: false, system: false);
    }

    private void AppendChat(string name, string text, int seat, bool mine, bool system)
    {
        _chat.Add(new ChatLine
        {
            Id = ++_chatSeq,
            Name = name,
            Text = text,
            Seat = seat < 0 ? 0 : seat,
            Mine = mine,
            System = system
        });
        if (_chat.Count > ChatMaxLines) _chat.RemoveAt(0);
        if (_chatCollapsed) _chatUnread++;
        else _chatPendingScroll = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleChat()
    {
        _chatCollapsed = !_chatCollapsed;
        if (!_chatCollapsed)
        {
            _chatUnread = 0;
            _chatPendingScroll = true;
        }
    }

    private void SubmitChat()
    {
        if (!ShowChat) return;
        string text = SanitizeChat(_chatDraft);
        if (text.Length == 0) return;
        if ((DateTime.UtcNow - _chatLastSent).TotalMilliseconds < 400) return;
        _chatLastSent = DateTime.UtcNow;
        _chatDraft = "";
        AppendChat(PlayerName, text, 0, mine: true, system: false);
        if (_isGuest)
        {
            SendToHost(new MpMessage { t = "chat", who = PlayerName, text = text });
            return;
        }
        foreach (int guest in _remote.Keys.ToList())
        {
            SendToGuest(guest, new MpMessage
            {
                t = "chat",
                who = PlayerName,
                text = text,
                seat = Rot(0, guest)
            });
        }
    }

    private static string SanitizeChat(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var cleaned = new System.Text.StringBuilder();
        bool pendingSpace = false;
        foreach (char c in raw.Trim())
        {
            if (char.IsControl(c)) continue;
            if (char.IsWhiteSpace(c))
            {
                pendingSpace = cleaned.Length > 0;
                continue;
            }
            if (pendingSpace)
            {
                if (cleaned.Length + 1 > ChatMaxLength) break;
                cleaned.Append(' ');
                pendingSpace = false;
            }
            if (char.IsHighSurrogate(c))
            {
                if (cleaned.Length + 2 > ChatMaxLength) break;
            }
            else if (cleaned.Length >= ChatMaxLength)
            {
                break;
            }
            cleaned.Append(c);
        }
        return cleaned.ToString();
    }

