                    {
                        <div class="sound-menu">
                            <button class="sound-option @(_musicOn ? "on" : "")" @onclick="@(() => ToggleChannel("music"))">
                                <span class="sound-check">@(_musicOn ? "\u2713" : "")</span>MUSIC
                            </button>
                            <button class="sound-option @(_backgroundOn ? "on" : "")" @onclick="@(() => ToggleChannel("background"))">
                                <span class="sound-check">@(_backgroundOn ? "\u2713" : "")</span>BACKGROUND
                            </button>
