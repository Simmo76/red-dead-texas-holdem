    // ------------------------------------------------------------ friends beta
    //
    // The host's browser runs the real table: the same engine and NPCs as the
    // single-player game. A friend's seat is still an NPC in the engine, but on
    // that seat's turn the host waits for the friend's action instead of asking
    // the NPC brain, and shows the friend's name. Each guest replays the hand
    // locally from their own point of view: seats are relabelled so a guest is
    // always seat 0 (same camera, controls and HUD as the host) using the deck
    // order and actions relayed by the host. The SignalR hub only forwards
    // messages and never looks at cards.

    private const int TableSeats = 6;
    private const int RemoteTurnTimeoutSeconds = 60;

    private bool _isGuest;
    private bool _hosting;
    private bool _guestJoined;
    private bool _guestConnecting;
    private bool _guestOverDismissed;
