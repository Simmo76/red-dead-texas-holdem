    private const int ConfettiCount = 27;
    private static readonly string[] ConfettiColors = { "#e6c36a", "#c0392b", "#57c785", "#f4efe2" };
    private static readonly string[] ConfettiSuits = { "♠", "♥", "♦", "♣" };

    // Deterministic scatter from the piece index: no RNG, so the shower
    // looks the same on every render pass of the same overlay.
    private static string ConfettiStyle(int i)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        int left = (i * 41 + 7) % 100;
        double delay = (i * 73 % 260) / 100.0;
        double duration = 2.8 + (i * 29 % 140) / 100.0;
        int size = 7 + (i * 31) % 7;
        string color = ConfettiColors[i % ConfettiColors.Length];
        return string.Format(inv,
            "left:{0}%;animation-delay:{1:0.00}s;animation-duration:{2:0.00}s;width:{3}px;height:{4}px;background-color:{5};",
            left, delay, duration, size, size + 4, color);
    }

    private static string ConfettiSuitStyle(int i)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        int left = (i * 41 + 23) % 100;
        double delay = (i * 67 % 260) / 100.0;
        double duration = 3.1 + (i * 37 % 120) / 100.0;
        int size = 15 + (i * 13) % 9;
        string color = (i / 3) % 2 == 0 ? "#e6c36a" : "#d05a4e";
        return string.Format(inv,
            "left:{0}%;animation-delay:{1:0.00}s;animation-duration:{2:0.00}s;font-size:{3}px;color:{4};",
            left, delay, duration, size, color);
    }

    /// <summary>
    /// Rolls the overlay's "rides off with" figure from 0 up to the final
    /// stack, slot-machine style. Token-guarded so a restart mid-roll stops
    /// the stale animation.
    /// </summary>
    private async Task AnimateHaulAsync(long target)
    {
        int token = ++_haulAnimToken;
        _haulShown = 0;
        const int steps = 50;
        for (int i = 1; i <= steps; i++)
        {
            await Task.Delay(28);
            if (token != _haulAnimToken || !_sessionOver) return;
            double eased = 1 - Math.Pow(1 - i / (double)steps, 3);
            _haulShown = (long)Math.Round(target * eased);
            StateHasChanged();
        }
    }

