    @if (_rulesOpen)
    {
        <div class="overlay" @onclick="CloseRules">
            <div class="overlay-box rules-box" @onclick:stopPropagation="true">
                <div class="overlay-title">HOW TO PLAY</div>
                <div class="rules-scroll">
                    <p class="rules-lede">
                        Texas Hold’em. Make the best five-card hand from your two private cards
                        and the five shared cards on the table. Last player standing — or the
                        strongest hand at showdown — takes the pot.
                    </p>

                    <section class="rules-section">
                        <h3 class="rules-heading">THE DEAL</h3>
                        <ul class="rules-list">
                            <li>Each hand starts with blinds: the two seats left of the dealer post forced bets (small blind, then big blind).</li>
                            <li>Everyone gets two hole cards face down — yours alone.</li>
                            <li>Up to five community cards land face up in the middle for everyone to share.</li>
                        </ul>
                    </section>

                    <section class="rules-section">
                        <h3 class="rules-heading">THE STREETS</h3>
                        <ol class="rules-steps">
                            <li><strong>Preflop</strong> — bet on your hole cards alone.</li>
                            <li><strong>Flop</strong> — three community cards, then another betting round.</li>
                            <li><strong>Turn</strong> — fourth community card, then bet again.</li>
                            <li><strong>River</strong> — fifth and final card, then the last betting round.</li>
                        </ol>
                    </section>

                    <section class="rules-section">
                        <h3 class="rules-heading">YOUR MOVES</h3>
                        <ul class="rules-list">
                            <li><strong>Fold</strong> — toss the hand; you’re out of this pot.</li>
                            <li><strong>Check</strong> — pass when nothing is owed (no bet in front of you).</li>
                            <li><strong>Call</strong> — match the current bet to stay in.</li>
                            <li><strong>Bet / Raise</strong> — put chips in or bump the price.</li>
                            <li><strong>All-in</strong> — shove your whole stack.</li>
                        </ul>
                    </section>

                    <section class="rules-section">
                        <h3 class="rules-heading">SHOWDOWN</h3>
                        <p class="rules-copy">
                            If two or more players remain after the river, cards are shown.
                            Best five-card hand wins — use any mix of your holes and the board.
                            If everyone else folds, you win without showing. Tap
                            <strong>HANDS</strong> in the top bar for the ranking chart from
                            royal flush down to high card.
                        </p>
                    </section>
                </div>
                <div class="overlay-actions">
                    <button class="act small" @onclick="CloseRules">CLOSE</button>
                </div>
            </div>
        </div>
    }

    @if (_handRankingsOpen)
    {
        <div class="overlay" @onclick="CloseHandRankings">
            <div class="overlay-box hands-box" @onclick:stopPropagation="true">
                <div class="hands-zoom" @ref="_handsZoomRef" title="Pinch or scroll to zoom, drag to pan">
                    <div class="hands-chart">
                        <img src="img/hand-rankings.jpg?v=2"
                             alt="Poker hand rankings from best to worst: royal flush, straight flush, four of a kind, full house, flush, straight, three of a kind, two pair, pair, high card" />
                        <button type="button" class="hands-close" @onclick="CloseHandRankings" aria-label="Close">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_exportOpen)
    {
        <div class="overlay" @onclick="CloseExportPanel">
            <div class="overlay-box export-box" @onclick:stopPropagation="true">
                <div class="overlay-title">EXPORT STATS</div>
                <p class="export-blurb">
                    Send your full hand history and coaching notes — every session saved on this
                    device — as a .csv file via email or text
                    @if (_handLog.CompletedHandCount > 0)
                    {
                        <text> · @_handLog.CompletedHandCount hand@(_handLog.CompletedHandCount == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text> · no hands yet</text>
                    }
                </p>
                @if (!string.IsNullOrEmpty(_exportNote))
                {
                    <p class="export-note">@_exportNote</p>
                }
                <div class="export-actions">
                    <button class="act call" @onclick="ExportViaEmail" disabled="@(_handLog.CompletedHandCount == 0)">EMAIL CSV</button>
                    <button class="act bet" @onclick="ExportViaText" disabled="@(_handLog.CompletedHandCount == 0)">TEXT CSV</button>
                    <button class="act small" @onclick="ExportDownload" disabled="@(_handLog.CompletedHandCount == 0)">DOWNLOAD</button>
                    <button class="act small" @onclick="CloseExportPanel">CLOSE</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_guestError))
    {
        <div class="overlay" role="dialog" aria-label="Could not join">
            <div class="overlay-box">
                <div class="overlay-title">CAN'T JOIN THIS TABLE</div>
                <p class="invite-blurb">@_guestError</p>
                <div class="overlay-actions">
                    <button class="act call big" @onclick="LeaveTable">PLAY SOLO</button>
                </div>
            </div>
        </div>
    }

    @if (_inviteOpen)
    {
        <div class="overlay" @onclick="CloseInvite">
            <div class="overlay-box invite-box" @onclick:stopPropagation="true">
                <div class="overlay-title">INVITE A FRIEND</div>
                <p class="invite-blurb">
                    Send this link to a friend (up to four can join). Each one takes over an NPC seat and keeps this
                    same table, camera and controls. Keep this game open while they play.
                </p>
                <div class="invite-room">
                    <span class="invite-room-label">TABLE LINK</span>
                    <code>@_inviteUrl</code>
                </div>
                @if (!string.IsNullOrEmpty(_inviteNote))
                {
                    <p class="invite-note" role="status">@_inviteNote</p>
                }
                <div class="invite-actions">
                    <button class="act call" @onclick="TextInvite">TEXT INVITE</button>
                    <button class="act bet" @onclick="EmailInvite">EMAIL INVITE</button>
                    <button class="act bet" @onclick="ShareInvite">SHARE LINK</button>
                    <button class="act small" @onclick="CopyInvite">COPY LINK</button>
                    <button class="act small" @onclick="CloseInvite">CLOSE</button>
                </div>
                @if (_remote.Count > 0)
                {
                    <p class="invite-footnote">At the table now: @string.Join(", ", _remote.Values.Select(r => r.Name))</p>
                }
            </div>
        </div>
    }

    @if (_coachOpen && _coachReview != null)
    {
        <div class="coach-layer @(_coachKeyOpen ? "key-open" : null)" role="dialog" aria-modal="@(_coachUseScene ? "true" : "false")" aria-label="Hand review with @CoachDisplayName">
            <button type="button" class="coach-back" @onclick="() => CloseCoach(false)" @onclick:stopPropagation="true" @onkeydown="OnCoachKey">
                ← BACK TO TABLE
            </button>
            @if (CoachCanAdvance)
            {
                <button type="button" class="coach-next" @onclick="() => CloseCoach(true)" @onclick:stopPropagation="true" @onkeydown="OnCoachKey"
                        title="Go to the next hand">
                    @CoachAdvanceLabel →
                </button>
            }
            @if (_coach3dOk != true)
            {
                <div class="coach-portrait" aria-hidden="true">
                    <span>@CoachInitial</span>
                    <small>COACH</small>
                </div>
            }
            <section class="coach-panel" tabindex="-1" @ref="_coachPanelRef" @onclick:stopPropagation="true" @onkeydown="OnCoachKey">
                <div class="coach-scroll">
                <h2 class="coach-name">@CoachDisplayNameUpper</h2>
                <p class="coach-role">YOUR TABLE COACH</p>
                <hr class="coach-rule" />
                @if (_coachIntroNote)
                {
                    <p class="coach-handoff" role="note">
                        That's my last automatic visit, so the game keeps moving.
                        Tap <b>POKER COACH</b> at the top of the table whenever you
                        want a hand reviewed, or set <b>POST-HAND COACH</b> to
                        <b>EVERY HAND</b> in Settings and I'll keep appearing after
                        every hand.
                    </p>
                }
                <h3 class="coach-section-title">HAND REVIEW</h3>
                <div class="coach-block">
                    <div class="coach-mark" aria-hidden="true">♠</div>
                    <div>
                        <p class="coach-kicker">@_coachReview.Heading</p>
                        <p class="coach-copy">
                            @if (CoachAtShowdown)
                            {
                                <span class="coach-sr">At showdown. </span>
                            }
                            @_coachReview.WhyWon
                        </p>
                    </div>
                </div>
                <div class="coach-block">
                    <div class="coach-mark" aria-hidden="true">✦</div>
                    <div>
                        <p class="coach-kicker">ONE THING TO TRY</p>
                        <p class="coach-copy" aria-live="polite">
                            <span class="coach-sr">With the information you had then. </span>
                            @(string.IsNullOrEmpty(_coachReview.Lesson) ? "No lesson for this hand." : _coachReview.Lesson)
                        </p>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_coachReview.ChipDetail))
                {
                    <p class="coach-chips">@_coachReview.ChipDetail</p>
                }
                @if (_coachReview.PotLines != null)
                {
                    @foreach (var line in _coachReview.PotLines)
                    {
                        <p class="coach-chips">@line</p>
                    }
                }
                @if (_coach3dOk == false && _coachSceneReason == "shared-table")
                {
                    <p class="coach-note">This review stays on the card while friends are at the table.</p>
                }
                else if (_coach3dOk == false && !string.IsNullOrEmpty(_coachSceneReason))
                {
                    <p class="coach-note">Saloon view: @_coachSceneReason. The written advice is on this card.</p>
                }
                </div>
                <div class="coach-dock">
                @if (_coachBoardFaces.Count > 0 || _coachPlayerHands.Count > 0)
                {
                    <div class="coach-cards" aria-label="Cards from this hand">
                        @if (_coachBoardFaces.Count > 0)
                        {
                            <div class="coach-card-row coach-board-row">
                                @foreach (var face in _coachBoardFaces)
                                {
                                    <img src="@face.Src" alt="@face.Alt" class="@CoachHot(face.Code)" />
                                }
                            </div>
                        }
                        @if (_coachPlayerHands.Count > 0)
                        {
                            <div class="coach-card-row coach-players-row">
                                @foreach (var playerHand in _coachPlayerHands)
                                {
                                    <div class="coach-player-hand">
                                        <div class="coach-player-cards">
                                            @foreach (var face in playerHand.Faces)
                                            {
                                                <img src="@face.Src" alt="@face.Alt" class="@CoachHot(face.Code)" />
                                            }
                                        </div>
                                        <span class="coach-player-name">@playerHand.Label</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="coach-actions">
                    <button type="button" class="act call @(_coachKeyOpen ? "on" : null)" @onclick="ToggleKeyDecision" aria-expanded="@_coachKeyOpen" aria-controls="coach-key-decision">SEE KEY DECISION</button>
                    @if (CoachCanHighlight)
                    {
                        <button type="button" class="act highlight @(_coachHighlight ? "on" : "off")" aria-pressed="@_coachHighlight" @onclick="ToggleCoachHighlights">@(_coachHighlight ? "HIGHLIGHT ON" : "HIGHLIGHT OFF")</button>
                    }
                </div>
                <p class="coach-foot">POST-HAND ADVICE</p>
                </div>
            </section>
            @if (_coachKeyOpen)
            {
                <aside id="coach-key-decision" class="coach-key-panel" @onclick:stopPropagation="true" @onkeydown="OnCoachKey">
                    @if (_coachReview.KeyDecision == null)
                    {
                        <p>No single priced decision was selected — the note below is about the finished hand.</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_coachReview.KeyDecision.Caveat))
                        {
                            <p>@_coachReview.KeyDecision.Caveat</p>
                        }
                        <p>Street: @_coachReview.KeyDecision.Street</p>
                        <p>Board: @_coachReview.KeyDecision.BoardText</p>
                        <p>Action: @_coachReview.KeyDecision.ActionTaken</p>
                        @if (!string.IsNullOrEmpty(_coachReview.KeyDecision.RecordedAction))
                        {
                            <p>@_coachReview.KeyDecision.RecordedAction</p>
                        }
                        @if (!string.IsNullOrEmpty(_coachReview.KeyDecision.PriceLine))
                        {
                            <p>@_coachReview.KeyDecision.PriceLine</p>
                        }
                        @if (_coachReview.KeyDecision.EquityShare.HasValue || _coachReview.KeyDecision.ReasonCode == "equity_unavailable" || _coachReview.KeyDecision.ReasonCode == "cancelled")
                        {
                            <p>Estimated share: @CoachPct(_coachReview.KeyDecision.EquityShare)</p>
                        }
                        @if (_coachReview.KeyDecision.BreakEvenEquity.HasValue)
                        {
                            <p>Break-even: @CoachPct(_coachReview.KeyDecision.BreakEvenEquity)</p>
                        }
                        @if (_coachReview.KeyDecision.CallEv.HasValue)
                        {
                            <p>Call value: @CoachChips(_coachReview.KeyDecision.CallEv)</p>
                        }
                        @if (!string.IsNullOrEmpty(_coachReview.KeyDecision.Detail))
                        {
                            <p>@_coachReview.KeyDecision.Detail</p>
                        }
                        @if (!string.IsNullOrEmpty(_coachReview.KeyDecision.Method))
                        {
                            <p>Method: @_coachReview.KeyDecision.Method</p>
                        }
                    }
                    @if (!string.IsNullOrEmpty(_coachReview.Assumptions))
                    {
                        <p>@_coachReview.Assumptions</p>
                    }
                </aside>
            }
        </div>
    }
</div>

@code {
    private static readonly Func<AIProfile>[] Roster =
    {
        AIProfile.Maniac,
        AIProfile.Regular,
        AIProfile.Rock,
        AIProfile.CallingStation,
        AIProfile.Professional
    };

    // Per-seat accent colours: every name in the HUD is painted with its
    // seat's colour, and the 3D scene tints that character's hat to match,
    // so a name always points at a hat around the table. Keep in sync with
    // SEAT_COLORS in wwwroot/js/poker-scene.js.
    private static readonly string[] SeatColors =
        { "#e0b84a", "#d87a6a", "#7aa5d8", "#8cc47e", "#c08ad8", "#5ec8b8" };

    private static string SeatColor(int seat) => SeatColors[seat % SeatColors.Length];

    // Table nicknames handed out at random each time a fresh roster sits down.
    // The saloon draws western handles; the octagon draws cage-fighter handles.
    // Every entry is unique, each pool is larger than the NPC count, and any
    // name matching the player's own is skipped, so no two people at the
    // table ever share a name.
    private static readonly string[] SaloonNpcNamePool =
    {
        "Sam Six-Shot",
        "Billie Quickdraw",
        "Jesse Deadeye",
        "Charlie Cold-Iron",
        "Frankie Fast-Hand",
        "Riley Black-Hat",
        "Casey Trigger"
    };

    private static readonly string[] OctagonNpcNamePool =
    {
        "Alex Iron-Fist",
        "Jordan Dust-Knuckle",
        "Taylor Low-Blow",
        "Morgan Cage-Breaker",
        "Reese Blood-Odds",
        "Cameron Blindside",
        "Quinn Dead-Ringer"
    };

    private string[] NpcNamePoolForScene(string scene) =>
        scene == "street" ? OctagonNpcNamePool : SaloonNpcNamePool;

    private static bool IsSaloonNpcName(string name) =>
        Array.Exists(SaloonNpcNamePool, n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase));

    private static bool IsOctagonNpcName(string name) =>
        Array.Exists(OctagonNpcNamePool, n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase));

    // Each seat keeps a western handle and a fighter handle for the session.
    // Switching saloon ↔ octagon swaps only which one the HUD and scene show
    // (same idea as cinematic-poker-table-cast-v1 for 3D bodies).
    private string[] _saloonNpcNames = new string[5];
    private string[] _streetNpcNames = new string[5];

    private void ClearSceneNpcNameMaps()
    {
        Array.Clear(_saloonNpcNames, 0, _saloonNpcNames.Length);
        Array.Clear(_streetNpcNames, 0, _streetNpcNames.Length);
    }

    private static bool SceneNpcNamesComplete(string[] names) =>
        names is { Length: 5 } && names.All(n => !string.IsNullOrEmpty(n));

    private void DealDualSceneNpcNames()
    {
        string[] saloon = ShuffledNpcNames("saloon");
        string[] street = ShuffledNpcNames("street");
        for (int i = 0; i < Roster.Length; i++)
        {
            _saloonNpcNames[i] = saloon[i];
            _streetNpcNames[i] = street[i];
        }
    }

    private string[] NpcNamesForScene(string scene) =>
        scene == "street" ? _streetNpcNames : _saloonNpcNames;

    private string NpcDisplayName(int seat)
    {
        if (seat <= 0 || seat > Roster.Length || _game == null) return null;
        string[] names = NpcNamesForScene(_tableScene);
        int idx = seat - 1;
        return idx < names.Length ? names[idx] : null;
    }

    // Older snapshots only stored one roster name per seat; rebuild the dual
    // maps so a scene switch can still swap handles after restore.
    private void RebuildSceneNpcNameMapsFromSeats(IReadOnlyList<WebSeatSnapshot> seats, string savedScene)
    {
        var taken = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (WebSeatSnapshot seat in seats)
        {
            if (seat.seat <= 0 || seat.seat > Roster.Length) continue;
            int idx = seat.seat - 1;
            string name = seat.name;
            if (string.IsNullOrEmpty(name) || ShouldRemapRestoredNpcName(name, savedScene)) continue;
            if (savedScene == "saloon")
                _saloonNpcNames[idx] = name;
            else
                _streetNpcNames[idx] = name;
            taken.Add(name);
        }
        foreach (string scene in new[] { "saloon", "street" })
        {
            string[] pool = ShuffledNpcNames(scene);
            string[] map = NpcNamesForScene(scene);
            int next = 0;
            for (int idx = 0; idx < Roster.Length; idx++)
            {
                if (!string.IsNullOrEmpty(map[idx])) continue;
                while (next < pool.Length && !taken.Add(pool[next]))
                    next++;
                map[idx] = next < pool.Length ? pool[next++] : $"Player {idx + 1}";
            }
        }
    }

    // Retired handles and fighter-only names on a saloon save are remapped.
    private static bool ShouldRemapRestoredNpcName(string name, string savedScene)
    {
        if (string.IsNullOrEmpty(name)) return true;
        bool inSaloon = IsSaloonNpcName(name);
        bool inOctagon = IsOctagonNpcName(name);
        if (!inSaloon && !inOctagon) return true;
        return savedScene == "saloon" && !inSaloon && inOctagon;
    }

    private string[] ShuffledNpcNames(string scene = null)
    {
        var names = Array.FindAll(NpcNamePoolForScene(scene ?? _tableScene),
            n => !string.Equals(n, PlayerName, StringComparison.OrdinalIgnoreCase));
        for (int i = names.Length - 1; i > 0; i--)
        {
            int j = _rng.Next(i + 1);
            (names[i], names[j]) = (names[j], names[i]);
        }
        return names;
    }

    // ---------------------------------------------------------- difficulty

    private static readonly string[] DifficultyNames = { "EASY", "NORMAL" };
    private int _difficulty = 1; // NORMAL

    private void CycleDifficulty()
    {
        _difficulty = (_difficulty + 1) % DifficultyNames.Length;
        GameLog.Info("ui", $"difficulty -> {DifficultyNames[_difficulty]}");
        if (_game == null) return;
        // Retune the live NPCs in place, mid-session: rebuild each personality
        // preset at the new difficulty and write it into the existing profile.
        for (int i = 0; i < Roster.Length; i++)
        {
            if (_game.GetPlayer(i + 1) is AIPlayer ai)
                CopyProfile(WithDifficulty(Roster[i]()), ai.Profile);
        }
    }

    // Scales each personality's competence down on EASY without erasing what
    // makes them distinct: aggression and tightness stay untouched, only the
    // "how well do they actually play" parameters move. NORMAL uses the
    // presets as authored.
    private AIProfile WithDifficulty(AIProfile p)
    {
        if (_difficulty == 0) // EASY: sloppier reads, more mistakes, tilts easily
        {
            p.Skill *= 0.45;
            p.PotOddsAccuracy *= 0.45;
            p.HandReadingAbility *= 0.45;
            p.PositionAwareness *= 0.5;
            p.OpponentAwareness *= 0.5;
            p.BluffFrequency *= 0.7;
            p.DecisionNoise = Math.Min(1, p.DecisionNoise + 0.15);
            p.TiltSensitivity = Math.Min(1, p.TiltSensitivity + 0.2);
        }
        return p;
    }

    private static void CopyProfile(AIProfile from, AIProfile into)
    {
        into.Skill = from.Skill;
        into.Aggression = from.Aggression;
        into.Tightness = from.Tightness;
        into.BluffFrequency = from.BluffFrequency;
        into.RiskTolerance = from.RiskTolerance;
        into.TiltSensitivity = from.TiltSensitivity;
        into.PositionAwareness = from.PositionAwareness;
        into.OpponentAwareness = from.OpponentAwareness;
        into.PotOddsAccuracy = from.PotOddsAccuracy;
        into.HandReadingAbility = from.HandReadingAbility;
        into.DecisionNoise = from.DecisionNoise;
        into.EmotionalBias = from.EmotionalBias;
    }

