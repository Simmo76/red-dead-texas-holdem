    // A seated NPC already answering to this name mid-session would put two
    // identical names at the table, so the rename is refused with a hint.
    private bool NpcNameInUse(string name)
    {
        if (_game == null) return false;
        foreach (PokerPlayer p in _game.Players)
        {
            if (p.Seat == 0) continue;
            string shown = NpcDisplayName(p.Seat) ?? p.Name;
            if (string.Equals(shown, name, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }

    // Renames take effect immediately: the HUD reads PlayerName directly and
    // the scene/actor windows go through DisplayName, so the engine's
    // immutable player record never needs to change mid-session.
    private async Task SaveSettingsName()
    {
        if (!CanSaveSettingsName) return;
        string candidate = SanitizeName(_settingsNameDraft);
        if (NpcNameInUse(candidate))
        {
            _settingsNameNote = $"There's already a {candidate} at this table — pick another name.";
            return;
        }
        _playerName = candidate;
        _settingsNameDraft = _playerName;
        await PersistPlayerName(_playerName);
        _settingsNameNote = $"Saved — the table knows you as {_playerName}.";
        if (_sceneReady)
        {
            await PushSceneState(); // refresh the 3D nameplate now
            try { await JS.InvokeVoidAsync("pokerScene.healGraphics"); }
            catch (JSException) { }
        }
        // Friends read this name on the next line they see, and on the
        // nameplate, without waiting for the next deal.
        if (_isGuest && _guestJoined)
            SendToHost(new MpMessage { t = "rename", who = _playerName });
        else if (_hosting && _remote.Count > 0)
            BroadcastRoster();
    }

