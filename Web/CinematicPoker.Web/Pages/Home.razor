    // ------------------------------------------- "What would AI do?" advisor

    // Maximilian is a card-counting pro who shares the Professional NPC's
    // playbook, but with the humanising flaws stripped out: no decision
    // noise, no tilt, no random bluffs — just Monte Carlo equity (counting
    // the unseen cards) measured against pot odds. On the player's turn only
    // the "WHAT WOULD AI DO?" button is shown; the count runs and the advice
    // appears only when the player taps it, and every new turn starts back
    // at the button so the read is opt-in each decision. A second human at
    // the table turns the button off for as long as they're seated.
    private const int AdviceEquityIterations = 400;
    private const double MaxAggression = 0.65; // mirrors AIProfile.Professional
    private const double MaxTightness = 0.6;
    private const double MaxRiskTolerance = 0.5;

    private MaxAdvice _advice;
    private bool _adviceCollapsed = true;

    // Solo aid. The host counts connected friends; a guest counts every
    // other human the roster marked, which still includes them while the
    // link is down so a reconnect can't briefly unlock the count.
    private bool AnotherHumanSeated =>
        _isGuest ? _guestHumanSeats.Count > 0 : _remote.Count > 0;

    private bool ShowAiAdvice => _awaitingHuman && !AnotherHumanSeated;

    // A friend can sit down while the panel is already open. Drop the
    // read immediately so it cannot sit in memory and pop back open.
    private void SuppressAdviceForCompany()
    {
        if (!AnotherHumanSeated) return;
        _advice = null;
        _adviceCollapsed = true;
    }

    private void ToggleAdvice()
    {
        if (!ShowAiAdvice)
        {
            SuppressAdviceForCompany();
            return;
        }
        _ = JS.InvokeVoidAsync("pokerAudio.button");
        if (!_adviceCollapsed)
        {
            _adviceCollapsed = true;
            return;
        }
        // First tap this turn: run the count now, not before.
        _advice ??= ComputeAdvice();
        if (_advice != null) _adviceCollapsed = false;
    }

    private sealed class MaxAdvice
    {
        public string ActionLabel;
        public int WinPercent;
        public int? PotOddsPercent;
        public string Opponents;
        public string Rationale;
    }

    private MaxAdvice ComputeAdvice()
    {
        if (_game?.CurrentRound == null || AnotherHumanSeated) return null;
        try
        {
            DecisionContext ctx = DecisionContext.ForCurrentActor(_game, AdviceEquityIterations);
            if (ctx.HoleCards == null || ctx.HoleCards.Count != 2) return null;

            int opponents = Math.Max(1, ctx.OpponentsInHand);
            double equity = EquityCalculator.Estimate(
                ctx.HoleCards, ctx.Board, opponents, AdviceEquityIterations, _rng);

            var advice = new MaxAdvice
            {
                WinPercent = (int)Math.Round(equity * 100),
                Opponents = opponents == 1 ? "1 PLAYER" : $"{opponents} PLAYERS"
            };

            if (ctx.ToCall <= 0)
                AdviseUnopened(ctx, advice, equity);
            else
                AdviseFacingBet(ctx, advice, equity);
            return advice;
        }
        catch (ArgumentException)
        {
            return null;
        }
        catch (InvalidOperationException)
        {
            return null;
        }
    }

    // Nothing to call: bet for value past the Professional's threshold,
    // otherwise take the free card.
    private void AdviseUnopened(DecisionContext ctx, MaxAdvice advice, double equity)
    {
        LegalActions legal = ctx.Legal;
        bool canOpen = legal.CanBet || legal.CanRaise;
        double betThreshold = 0.5 + MaxTightness * 0.15 - MaxAggression * 0.12;

        if (canOpen && equity > betThreshold)
        {
            double fraction = Math.Max(0.3, Math.Min(1.2,
                0.4 + MaxAggression * 0.5 + (equity - 0.5) * 0.5));
            long desired = Math.Max(ctx.BigBlind, (long)(ctx.Pot * fraction));
            SetAggressiveLabel(ctx, advice, desired);
            advice.Rationale =
                $"The count says {advice.WinPercent} wins in 100 deals here — strong enough to bet for value.";
            return;
        }

        advice.ActionLabel = "CHECK";
        advice.Rationale = equity > 0.40
            ? $"{advice.WinPercent}% to win is decent but not enough to build a pot — see a free card."
            : $"Only {advice.WinPercent}% to win — check and pay nothing to improve.";
    }

    // Facing a bet: compare counted equity against the pot odds plus the
    // Professional's required edge. Clearly ahead raises, ahead calls,
    // behind folds.
    private void AdviseFacingBet(DecisionContext ctx, MaxAdvice advice, double equity)
    {
        LegalActions legal = ctx.Legal;
        double? price = PotPrice.BreakEvenEquity(ctx.Pot, legal.CallAmount);
        if (price == null)
        {
            advice.ActionLabel = legal.CanCheck ? "CHECK" : "FOLD";
            advice.Rationale = "There isn't a call to price on this street.";
            return;
        }
        double potOdds = price.Value;
        double requiredEdge = MaxTightness * 0.08 - MaxRiskTolerance * 0.04;
        double margin = equity - (potOdds + requiredEdge);
        advice.PotOddsPercent = (int)Math.Round(potOdds * 100);

        if (margin < 0)
        {
            advice.ActionLabel = legal.CanCheck ? "CHECK" : "FOLD";
            advice.Rationale =
                $"The call needs better than {advice.PotOddsPercent}% but the cards only win {advice.WinPercent}% — bad price, let it go.";
            return;
        }

        if (margin > 0.12 && legal.CanRaise)
        {
            long desired = (long)(ctx.CurrentBet * (2.2 + MaxAggression * 1.3));
            SetAggressiveLabel(ctx, advice, desired);
            advice.Rationale =
                $"{advice.WinPercent}% to win dwarfs the {advice.PotOddsPercent}% pot odds — raise for value.";
            return;
        }

        advice.ActionLabel = legal.CanCall ? $"CALL ${legal.CallAmount}" : "CHECK";
        advice.Rationale =
            $"{advice.WinPercent}% to win beats the {advice.PotOddsPercent}% pot odds — the price is right.";
    }

    // Same clamping the NPC brain uses: an aggressive amount becomes a legal
    // BET / RAISE TO / ALL-IN.
    private static void SetAggressiveLabel(DecisionContext ctx, MaxAdvice advice, long desired)
    {
        LegalActions legal = ctx.Legal;
        long to = Math.Max(legal.MinBetOrRaiseTo, Math.Min(desired, legal.MaxBetOrRaiseTo));
        if (to >= legal.MaxBetOrRaiseTo && legal.CanAllIn)
            advice.ActionLabel = "ALL-IN";
        else if (legal.CanBet)
            advice.ActionLabel = $"BET ${to}";
        else
            advice.ActionLabel = $"RAISE TO ${to}";
    }

