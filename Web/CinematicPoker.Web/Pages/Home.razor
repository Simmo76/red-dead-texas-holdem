    // Opponent hole cards shown in the top-right HUD after a loss. Prefer
    // an actual winner; fall back to the first revealed NPC.
    private ShowdownRow HudWinningHand =>
        _playerWonPot || _showdownView.Count == 0
            ? null
            : _showdownView.FirstOrDefault(r => r.Winner && r.Seat != 0 && r.Cards is { Count: > 0 })
              ?? _showdownView.FirstOrDefault(r => r.Seat != 0 && r.Cards is { Count: > 0 });

    // Cards featured on the result banner — and therefore in the Victory
    // Screen-Shot. On a player win this is YOUR hole cards so the photo
    // shows the hand that took the pot. On a loss it is the opponent who
    // beat you (same cards as the top-right HUD strip).
    private IReadOnlyList<Card> BannerHandCards
    {
        get
        {
            if (_playerWonPot)
            {
                ShowdownRow mine = _showdownView.FirstOrDefault(
                    r => r.Seat == 0 && r.Cards is { Count: > 0 });
                if (mine != null) return mine.Cards;
                IReadOnlyList<Card> hole = HoleCardsOf(0);
                return hole is { Count: > 0 } ? hole : null;
            }
            return HudWinningHand?.Cards;
        }
    }

    // Multi-seat compares stay on screen. A fold-win that only lists the
    // player is already shown on the victory banner, so skip the strip.
    private bool ShowShowdownCompare =>
        _showdownView.Count > 0
        && !(_playerWonPot && _showdownView.TrueForAll(r => r.Seat == 0));

    private void RememberShownHand(int seat, IReadOnlyList<Card> hole, bool winner)
    {
        if (hole == null || hole.Count == 0) return;
        if (seat != 0) _revealed[seat] = hole;
        ShowdownRow existing = _showdownView.Find(r => r.Seat == seat);
        if (existing != null)
        {
            existing.Cards = hole;
            existing.HandName = DescribeShownHand(hole);
            existing.Winner = winner || existing.Winner;
            return;
        }
        _showdownView.Add(new ShowdownRow
        {
            Seat = seat,
            Name = seat == 0 ? "You" : NameOf(seat),
            Cards = hole,
            HandName = DescribeShownHand(hole),
            Winner = winner
        });
    }

    private int FirstOpponentRevealSeat(IReadOnlyList<int> prefer = null)
    {
        if (prefer != null)
        {
            foreach (int seat in prefer)
                if (seat != 0 && _revealed.ContainsKey(seat)) return seat;
        }
        foreach (ShowdownRow row in _showdownView)
            if (row.Seat != 0 && row.Cards is { Count: > 0 }) return row.Seat;
        return -1;
    }

    private string DescribeShownHand(IReadOnlyList<Card> hole)
    {
        if (hole == null || hole.Count + _shownBoard.Count < 5) return null;
        try { return Pretty(HandEvaluator.Evaluate(hole, _shownBoard).Category); }
        catch (ArgumentException) { return null; }
    }

    private static string Pretty(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high card",
        HandCategory.Pair => "a pair",
        HandCategory.TwoPair => "two pair",
        HandCategory.ThreeOfAKind => "three of a kind",
        HandCategory.Straight => "a straight",
        HandCategory.Flush => "a flush",
        HandCategory.FullHouse => "a full house",
        HandCategory.FourOfAKind => "four of a kind",
        HandCategory.StraightFlush => "a straight flush",
        HandCategory.RoyalFlush => "a ROYAL FLUSH",
        _ => category.ToString()
    };

    private SeatState SeatOf(int seat)
    {
        if (Round == null) return null;
        foreach (SeatState s in Round.Seats)
            if (s.Seat == seat) return s;
        return null;
    }

    private IReadOnlyList<Card> HoleCardsOf(int seat) =>
        SeatOf(seat)?.HoleCards ?? (IReadOnlyList<Card>)Array.Empty<Card>();

    // Kenney boardgame pack card faces (CC0) — see ASSET_LICENSES.md.
    private static string CardImage(Card card)
    {
        string rank = card.Rank == Rank.Ten ? "10" : Card.RankSymbol(card.Rank);
        return $"img/cards/{card.Suit.ToString().ToLowerInvariant()}_{rank}.png";
    }

