    private void ApplySeatInfo(MpMessage m)
    {
        _seatNames.Clear();
        _guestHumanSeats.Clear();
        for (int j = 1; j < TableSeats; j++)
        {
            _seatNames[j] = m.names[j];
            if (m.humans[j]) _guestHumanSeats.Add(j);
        }
        SuppressAdviceForCompany();
        // Seat (6 - guest) % 6 in this view is the host's real seat 0.
        _mpPill = $"PLAYING AT {m.names[Rot(0, _guestRot)].ToUpperInvariant()}'S TABLE";
    }

    private void ApplyGuestState(MpMessage m)
    {
        _guestRot = m.rot;
        ResetGuestPresentation();
        ApplySeatInfo(m);
        var players = new List<PokerPlayer>();
        for (int j = 0; j < TableSeats; j++)
        {
            PokerPlayer player;
            if (j == 0)
            {
                player = new HumanPlayer("human", PlayerName, 0, Math.Max(0, m.stacks[0]));
            }
            else
            {
                int hostSeat = (j + m.rot) % TableSeats;
                player = new AIPlayer($"npc{j}", m.names[j] ?? $"Player {j}", j, Math.Max(0, m.stacks[j]),
                    WithDifficulty(Roster[Math.Max(0, hostSeat - 1)]()), _rng.Next());
            }
            player.Status = m.outs[j] ? PlayerStatus.Eliminated : PlayerStatus.Active;
            players.Add(player);
        }

        _game = new PokerGame(TableRules.Default, players, _rng.Next(), () => new Deck(_guestDeck, 0));
        _game.EventEmitted += OnEngineEvent;
        try
        {
            _game.RestoreProgress(m.handNumber, m.dealer);
            if (m.round != null)
            {
                _game.RestoreRound(m.round);
                _shownBoard.AddRange(_game.CurrentRound.Board);
            }
        }
        catch (Exception ex) when (ex is ArgumentException || ex is InvalidOperationException)
        {
            Console.Error.WriteLine($"Guest state rejected: {ex.Message}");
            RequestSync();
            return;
        }
        _handLog = new HandSequenceLog();
        _handLog.BeginSession(0, TableRules.Default, players);
        _ = GuestLoop(++_loopToken);
    }

    private bool ApplyGuestHand(MpMessage m)
    {
        ResetGuestPresentation();
        ApplySeatInfo(m);
        try
        {
            _guestDeck = m.deck.Select(Card.FromIndex).ToList();
            foreach (PokerPlayer p in _game.Players)
            {
                p.Stack = Math.Max(0, m.stacks[p.Seat]);
                p.Status = m.outs[p.Seat] ? PlayerStatus.Eliminated : PlayerStatus.Active;
            }
            _game = new PokerGame(TableRules.Default, _game.Players.ToList(), _rng.Next(),
                () => new Deck(_guestDeck, 0));
            _game.EventEmitted += OnEngineEvent;
            _game.RestoreProgress(m.handNumber - 1, -1);
            _game.StartHand(m.dealer);
            return true;
        }
        catch (Exception ex) when (ex is ArgumentException || ex is InvalidOperationException)
        {
            Console.Error.WriteLine($"Guest hand rejected: {ex.Message}");
            return false;
        }
    }

    private async Task GuestLoop(int token)
    {
        AfterGuestStep();
        while (token == _loopToken)
        {
            if (_guestInbox.Count == 0)
            {
                await Task.Delay(30);
                continue;
            }

            MpMessage m = _guestInbox.Dequeue();
            if (m.t == "hand")
            {
                if (!ApplyGuestHand(m))
                {
                    RequestSync();
                    continue;
                }
                await DrainEvents(token);
            }
            else if (m.t == "act")
            {
                if (_game.Phase != GamePhase.HandInProgress || _game.CurrentSeat != m.seat
                    || !TryDecodeAction(m, out PlayerAction action))
                {
                    RequestSync();
                    continue;
                }
                try { _game.SubmitAction(action); }
                catch (IllegalActionException)
                {
                    RequestSync();
                    continue;
                }
                await DrainEvents(token);
            }
            else if (m.t == "over")
            {
                _statusLine = m.text ?? "Waiting for the host…";
                StateHasChanged();
                continue;
            }

            if (token != _loopToken) return;
            AfterGuestStep();
        }
    }

    private void AfterGuestStep()
    {
        if (_game.Phase == GamePhase.HandInProgress && _game.CurrentSeat >= 0)
        {
            if (_game.CurrentPlayer.IsHuman)
            {
                if (!_awaitingHuman) PromptHuman();
            }
            else
            {
                _statusLine = $"{NameOf(_game.CurrentSeat)} is thinking…";
            }
        }
        else if (_game.HasHumanLost && !_guestOverDismissed && !_sessionOver && _handHasCompleted)
        {
            FinishSession();
        }
        else
        {
            _statusLine = "Waiting for the next hand…";
        }
        StateHasChanged();
    }

