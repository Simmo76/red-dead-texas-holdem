    // A reload (e.g. switching the table scene) drops the host's connection;
    // reopen the same room straight away so friends are not left waiting.
    private bool _restoredAwaitingLoop;

    // A restored table must not start dealing until friends are seated again,
    // or the NPC logic would play their hands during the reload.
    private async Task ResumeThenRunLoop()
    {
        try
        {
            Task resume = ResumeHostingAfterReload();
            await Task.WhenAny(resume, Task.Delay(8000));
        }
        finally
        {
            if (_restoredAwaitingLoop && _game != null)
            {
                _restoredAwaitingLoop = false;
                _ = RunLoop(++_loopToken);
            }
        }
    }

    private async Task ResumeHostingAfterReload()
    {
        if (_isGuest || _hosting || _game == null) return;
        try
        {
            string room = await JS.InvokeAsync<string>("pokerInvite.hostedRoom");
            if (string.IsNullOrEmpty(room)) return;
            _roomCode = room;
            _inviteUrl = await JS.InvokeAsync<string>("pokerInvite.url", _roomCode);
            await EnsureHosting();
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"Could not resume hosting: {ex.Message}");
            // Away too long: a friend took the table over and it carried on.
            // This browser keeps its own (solo) game; the invite link still
            // leads to the live table as a guest.
            if (ex.Message.Contains("already hosting", StringComparison.OrdinalIgnoreCase))
            {
                _mpPill = "YOUR FRIENDS KEPT THE TABLE GOING — OPEN YOUR INVITE LINK TO REJOIN";
                _ = InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ApplyGuestRoster(string json)
    {
        List<GuestRow> rows;
        try { rows = JsonSerializer.Deserialize<List<GuestRow>>(json, MpRead) ?? new(); }
        catch (JsonException) { return; }
        foreach (GuestRow row in rows)
            if (row.Connected) AddRemote(row.Seat, row.Name, row.PlayerId);
    }

    private void AddRemote(int hubSeat, string name, string playerId)
    {
        int seat = ResolveGameSeat(hubSeat, playerId);
        if (seat < 1 || seat >= TableSeats) return;
        string shown = SanitizeName(name, allowEmpty: true);
        if (shown.Length == 0) shown = "Friend";
        bool already = _remote.TryGetValue(seat, out RemoteSeat seated) && seated.PlayerId == playerId;
        _remote[seat] = new RemoteSeat { PlayerId = playerId, Name = shown, HubSeat = hubSeat };
        _gameSeatByPlayerId[playerId] = seat;
        _seatNames[seat] = shown;
        _remoteActions.Remove(seat);
        RefreshHostPill();
        SendState(seat);
        BroadcastRoster();
        if (!already)
        {
            // Everyone else hears who sat down. The new player gets a
            // welcome instead of a line about their own name.
            Announce($"{shown} joined the table.", skipSeat: seat);
            SendToGuest(seat, new MpMessage { t = "chat", a = "sys", text = "You're in. Say howdy." });
        }
        SuppressAdviceForCompany();
        _ = InvokeAsync(StateHasChanged);
    }

    // Until a takeover the relay seat IS the game seat. After one, a
    // returning friend keeps the seat remembered for them in this host's
    // numbering, and a brand-new friend takes the lowest seat nobody holds
    // or is remembered at.
    private int ResolveGameSeat(int hubSeat, string playerId)
    {
        if (_gameSeatByPlayerId.TryGetValue(playerId, out int known)
            && known >= 1 && known < TableSeats
            && (!_remote.TryGetValue(known, out RemoteSeat occupant) || occupant.PlayerId == playerId))
            return known;

        bool Taken(int seat) =>
            _remote.ContainsKey(seat)
            || _gameSeatByPlayerId.Any(kv => kv.Value == seat && kv.Key != playerId);

        if (hubSeat >= 1 && hubSeat < TableSeats && !Taken(hubSeat)) return hubSeat;
        for (int seat = 1; seat < TableSeats; seat++)
            if (!Taken(seat)) return seat;
        // Every free seat is merely remembered for someone who left: reuse one.
        for (int seat = 1; seat < TableSeats; seat++)
            if (!_remote.ContainsKey(seat)) return seat;
        return -1;
    }

    private void RemoveRemote(int seat, bool permanent)
    {
        if (!_remote.TryGetValue(seat, out RemoteSeat remote)) return;
        string name = remote.Name;
        _remote.Remove(seat);
        if (permanent) _gameSeatByPlayerId.Remove(remote.PlayerId);
        _seatNames.Remove(seat);
        _remoteActions.Remove(seat);
        _chatHeardAt.Remove(seat);
        RefreshHostPill();
        BroadcastRoster();
        Announce($"{name} left the table.");
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshHostPill()
    {
        _mpPill = _remote.Count == 0
            ? ""
            : "AT THE TABLE: " + string.Join(", ", _remote.OrderBy(r => r.Key)
                .Select(r => r.Value.Name.ToUpperInvariant()));
    }

    [JSInvokable]
    public void OnGuestJoined(int seat, string name, string playerId) => AddRemote(seat, name, playerId);

    [JSInvokable]
    public void OnGuestLeft(int seat, bool permanent)
    {
        int gameSeat = GameSeatOfHub(seat);
        if (gameSeat > 0) RemoveRemote(gameSeat, permanent);
    }

    [JSInvokable]
    public void OnHostReattached(string guestsJson)
    {
        _hosting = true;
        ApplyGuestRoster(guestsJson);
    }

    [JSInvokable]
    public void OnGuestMessage(int seat, string payload)
    {
        if (_isGuest) return;
        MpMessage m = Decode(payload);
        if (m == null) return;
        // The relay hands us its own seat number; everything below works in
        // game seats.
        int gameSeat = GameSeatOfHub(seat);
        if (gameSeat < 1) return;
        if (m.t == "chat")
        {
            ReceiveGuestChat(gameSeat, m);
            return;
        }
        if (m.t == "rename")
        {
            ApplyRemoteRename(gameSeat, m.who);
            return;
        }
        if (_game == null) return;
        if (m.t == "act")
        {
            if (_game.Phase == GamePhase.HandInProgress && _game.CurrentSeat == gameSeat
                && TryDecodeAction(m, out PlayerAction action))
                _remoteActions[gameSeat] = action;
            else
                SendState(gameSeat);
        }
        else if (m.t == "sync")
        {
            SendState(gameSeat);
        }
    }

    private void SendToGuest(int seat, MpMessage message)
    {
        if (!_remote.TryGetValue(seat, out RemoteSeat remote)) return;
        _ = SafeInvoke("pokerRealtime.toGuest", remote.HubSeat, Encode(message));
    }

    private void BroadcastToAll(MpMessage message)
    {
        foreach (int seat in _remote.Keys) SendToGuest(seat, message);
    }

    private void SubmitAndBroadcast(PlayerAction action)
    {
        int seat = _game.CurrentSeat;
        _game.SubmitAction(action);
        foreach (int guest in _remote.Keys)
        {
            SendToGuest(guest, new MpMessage
            {
                t = "act",
                seat = Rot(seat, guest),
                a = action.Type.ToString(),
                amt = action.Amount,
                handNumber = _game.HandNumber
            });
        }
    }

    private void FillTable(MpMessage m, int guest, bool atHandStart)
    {
        m.stacks = new long[TableSeats];
        m.outs = new bool[TableSeats];
        m.names = new string[TableSeats];
        m.humans = new bool[TableSeats];
        foreach (PokerPlayer p in _game.Players)
        {
            int j = Rot(p.Seat, guest);
            SeatState inHand = SeatOf(p.Seat);
            m.stacks[j] = atHandStart && inHand != null ? inHand.StackAtHandStart : p.Stack;
            m.outs[j] = p.Status == PlayerStatus.Eliminated && inHand == null;
            m.names[j] = p.Seat == 0 ? PlayerName : NameOf(p.Seat);
            m.humans[j] = IsHumanSeat(p.Seat);
        }
        m.hubs = HubSeatMapFor(guest);
    }

    // Which relay seat routes to each game seat, in the receiving guest's own
    // numbering. Guests remember this so that one of them, if promoted, can
    // re-map the remaining friends exactly — relay seats stop matching game
    // seats after the first takeover.
    private int[] HubSeatMapFor(int guest)
    {
        var hubs = new int[TableSeats];
        foreach (KeyValuePair<int, RemoteSeat> kv in _remote)
        {
            int j = Rot(kv.Key, guest);
            if (j >= 0 && j < TableSeats) hubs[j] = kv.Value.HubSeat;
        }
        return hubs;
    }

    private void BroadcastHand()
    {
        if (_game?.CurrentRound == null) return;
        List<int> deck = Round.Capture().deck;
        foreach (int guest in _remote.Keys)
        {
            var m = new MpMessage
            {
                t = "hand",
                scene = _tableScene,
                handNumber = _game.HandNumber,
                dealer = Rot(_game.DealerSeat, guest),
                deck = deck.ToArray()
            };
            FillTable(m, guest, atHandStart: true);
            SendToGuest(guest, m);
        }
    }

    private void SendState(int guest)
    {
        if (_game == null || !IsRemote(guest)) return;
        var m = new MpMessage
        {
            t = "state",
            scene = _tableScene,
            rot = guest,
            handNumber = _game.HandNumber,
            dealer = Rot(_game.DealerSeat, guest)
        };
        FillTable(m, guest, atHandStart: false);
        if (_game.Phase == GamePhase.HandInProgress && Round != null && !Round.IsComplete)
            m.round = Round.Capture().RotateSeats(guest);
        SendToGuest(guest, m);
    }

    private async Task RunRemoteTurn(PokerPlayer actor, int token)
    {
        int seat = actor.Seat;
        _statusLine = $"{NameOf(seat)} is thinking…";
        StateHasChanged();
        _remoteActions.Remove(seat);
        DateTime started = DateTime.UtcNow;
        while (token == _loopToken && IsRemote(seat) && !_remoteActions.ContainsKey(seat))
        {
            if ((DateTime.UtcNow - started).TotalSeconds > RemoteTurnTimeoutSeconds)
            {
                // An away friend must not stall the table: check if free, else fold.
                LegalActions legal = _game.GetLegalActions();
                _remoteActions[seat] = legal.CanCheck ? PlayerAction.Check() : PlayerAction.Fold();
                break;
            }
            await Task.Delay(50);
        }
        if (token != _loopToken) return;
        if (!_remoteActions.Remove(seat, out PlayerAction action)) return; // seat is an NPC again

        try { SubmitAndBroadcast(action); }
        catch (IllegalActionException)
        {
            SendState(seat);
            return;
        }
        await DrainEvents(token);
    }

    // ----------------------------------------------------------------- guest

    private async Task ConnectGuestAsync()
    {
        if (_guestConnecting || _guestJoined) return;
        _guestConnecting = true;
        _mpPill = "JOINING THE TABLE…";
        _statusLine = "Joining the table…";
        StateHasChanged();
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            string json = await JS.InvokeAsync<string>("pokerRealtime.join", _roomCode, PlayerName, _selfRef);
            JoinRow result = JsonSerializer.Deserialize<JoinRow>(json, MpRead);
            if (result == null || !result.Ok)
            {
                _mpPill = "";
                _guestConnecting = false;
                _guestError = string.IsNullOrEmpty(result?.Error) ? "Couldn't join this table." : result.Error;
            }
            else
            {
                _guestJoined = true;
                _mpPill = "JOINED — WAITING FOR THE DEAL";
                _statusLine = "Waiting for the host to deal you in…";
            }
        }
        catch (JSException ex)
        {
            _mpPill = "";
            _guestError = $"Couldn't reach the table ({ex.Message}). Check the link and try again.";
        }
        _guestConnecting = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnHostMessage(string payload)
    {
        if (!_isGuest) return;
        MpMessage m = Decode(payload);
        if (m == null) return;
        // Chat and the seating roster are not hands. They must never enter
        // the replay inbox, and they have to work before the first deal.
        if (m.t == "chat")
        {
            ReceiveRelayedChat(m);
            return;
        }
        if (m.t == "roster")
        {
            ApplyRoster(m);
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        if (_game == null) return;
        if (!string.IsNullOrEmpty(m.scene) && m.scene != _tableScene)
            _ = FollowHostScene(m.scene);
        if (m.t == "state")
        {
            _guestInbox.Clear();
            ApplyGuestState(m);
        }
        else
        {
            _guestInbox.Enqueue(m);
        }
    }

    private async Task FollowHostScene(string scene)
    {
        try { await JS.InvokeVoidAsync("pokerInvite.followScene", scene); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    [JSInvokable]
    public void OnHostGone()
    {
        if (!_isGuest) return;
        _tableLinkDown = true;
        _mpPill = "HOST AWAY — THE TABLE CARRIES ON IF THEY DON'T RETURN…";
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnHostBack()
    {
        if (!_isGuest) return;
        _tableLinkDown = false;
        _mpPill = "HOST IS BACK";
        RequestSync();
        _ = InvokeAsync(StateHasChanged);
    }

    // ------------------------------------------------------------- takeover
    //
    // The host left and stayed away: the relay offers their table to one of
    // the remaining friends. This guest's replica already holds the whole
    // game — every stack, the live hand, the deck — so it becomes the real
    // table and everyone else simply re-syncs against it.

    private sealed class ClaimRow
    {
        public bool Ok { get; set; }
        public int Seat { get; set; }
        public List<GuestRow> Guests { get; set; }
    }

    private bool _claimingHost;

    [JSInvokable]
    public async Task OnBecomeHost()
    {
        if (!_isGuest || _claimingHost) return;
        _claimingHost = true;
        try
        {
            string json = await JS.InvokeAsync<string>("pokerRealtime.claimHost", PlayerName);
            ClaimRow claim = null;
            try { claim = JsonSerializer.Deserialize<ClaimRow>(json, MpRead); }
            catch (JsonException) { }
            // Not ok: the host came back, or another friend claimed first.
            if (claim == null || !claim.Ok) return;
            await PromoteSelfToHost(claim);
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"Takeover claim failed: {ex.Message}");
        }
        finally
        {
            _claimingHost = false;
        }
    }

    private async Task PromoteSelfToHost(ClaimRow claim)
    {
        // My rotation in the departed host's frame. The relay seat only
        // matches it until the first takeover, so prefer what the host told
        // us; the relay seat covers the never-synced case.
        int myRot = _guestRot != 0 ? _guestRot : claim.Seat;
        ++_loopToken; // stop the guest replay loop
        FastForwardGuestInbox();

        // In my (rotated) numbering the departed host sat at Rot(0, myRot).
        _seatNames.TryGetValue(Rot(0, myRot), out string oldHostName);

        _isGuest = false;
        _hosting = true;
        _guestJoined = false;
        _guestConnecting = false;
        _tableLinkDown = false;
        _guestError = "";
        _guestRot = 0;

        // Re-label every remaining friend from the old host's seat numbers
        // into mine. Disconnected friends keep a reserved seat so they come
        // back to their own stack.
        _remote.Clear();
        _remoteActions.Clear();
        _seatNames.Clear();
        _gameSeatByPlayerId.Clear();
        _chatHeardAt.Clear();
        _guestHumanSeats.Clear();
        var hubSeatMap = new Dictionary<int, int>(_guestHubSeats);
        _guestHubSeats.Clear();
        foreach (GuestRow row in claim.Guests ?? new List<GuestRow>())
        {
            int gameSeat = GameSeatForClaimedGuest(hubSeatMap, row.Seat, myRot);
            if (gameSeat < 1 || gameSeat >= TableSeats) continue;
            _gameSeatByPlayerId[row.PlayerId] = gameSeat;
            if (!row.Connected) continue;
            string shown = SanitizeName(row.Name, allowEmpty: true);
            if (shown.Length == 0) shown = "Friend";
            _remote[gameSeat] = new RemoteSeat { PlayerId = row.PlayerId, Name = shown, HubSeat = row.Seat };
            _seatNames[gameSeat] = shown;
        }

        if (_game == null)
        {
            // The host vanished before any deal reached us: open a fresh
            // table for everyone instead of resuming one.
            StartSessionCore(run: false);
        }
        else
        {
            RebuildGameForHosting();
        }

        await SafeInvoke("pokerInvite.adoptRoom", _roomCode);
        EnsureCoachRecorder();
        RefreshHostPill();
        string gone = string.IsNullOrEmpty(oldHostName) ? "The host" : oldHostName;
        Announce($"{gone} left — {PlayerName} now runs the table.");
        foreach (int seat in _remote.Keys.ToList()) SendState(seat);
        BroadcastRoster();
        await PersistWebSession();
        _statusLine = "You run the table now.";
        StateHasChanged();
        int token = ++_loopToken;
        _ = ResumeAsHostLoop(token);
    }

    // Where does the friend routed at this relay seat sit, in my numbering?
    // The host's roster map answers exactly; falling back to plain rotation
    // is only correct while relay seats still match game seats (no takeover
    // has happened yet).
    private static int GameSeatForClaimedGuest(Dictionary<int, int> hubSeatMap, int hubSeat, int myRot)
    {
        foreach (KeyValuePair<int, int> kv in hubSeatMap)
            if (kv.Value == hubSeat) return kv.Key;
        return Rot(hubSeat, myRot);
    }

    // Apply any relayed actions still queued for presentation, without the
    // cinematic pacing, so the promoted table resumes from the latest state
    // the old host actually sent.
    private void FastForwardGuestInbox()
    {
        while (_guestInbox.Count > 0)
        {
            MpMessage m = _guestInbox.Dequeue();
            if (m.t == "hand")
            {
                if (!ApplyGuestHand(m)) break;
            }
            else if (m.t == "act")
            {
                if (_game == null || _game.Phase != GamePhase.HandInProgress
                    || _game.CurrentSeat != m.seat || !TryDecodeAction(m, out PlayerAction action))
                    continue;
                try { _game.SubmitAction(action); }
                catch (IllegalActionException) { break; }
            }
        }
        _guestInbox.Clear();
    }

    // The guest replica deals from the deck the old host relayed. Re-house
    // the same players (and the live hand, if any) in a game that shuffles
    // its own decks, since this browser deals every hand from here on.
    private void RebuildGameForHosting()
    {
        PokerRoundSnapshot live = Round is { IsComplete: false } ? Round.Capture() : null;
        int handNumber = _game.HandNumber;
        int dealerSeat = _game.DealerSeat;
        List<PokerPlayer> players = _game.Players.ToList();
        _game.EventEmitted -= OnEngineEvent;
        try
        {
            var game = new PokerGame(TableRules.Default, players, _rng.Next());
            game.RestoreProgress(handNumber, dealerSeat);
            if (live != null) game.RestoreRound(live);
            game.EventEmitted += OnEngineEvent;
            _game = game;
        }
        catch (Exception ex) when (ex is ArgumentException || ex is InvalidOperationException)
        {
            // Keep the replica; its stale relayed deck still deals, which
            // beats dropping the table.
            Console.Error.WriteLine($"Takeover game rebuild failed: {ex.Message}");
            _game.EventEmitted += OnEngineEvent;
        }
    }

    // Present whatever the fast-forward queued, then drive the table exactly
    // like a host that resumed after a reload.
    private async Task ResumeAsHostLoop(int token)
    {
        await DrainEvents(token);
        if (token != _loopToken) return;
        await RunLoop(token);
    }

    [JSInvokable]
    public void OnLinkState(string state)
    {
        if (!_isGuest) return;
        switch (state)
        {
            case "reconnecting":
                _tableLinkDown = true;
                _mpPill = "RECONNECTING…";
                break;
            case "connected":
                _tableLinkDown = false;
                _mpPill = "BACK AT THE TABLE";
                RequestSync();
                break;
            case "rejected":
                _tableLinkDown = true;
                _guestError = "This table is no longer open.";
                break;
            case "closed":
                _tableLinkDown = true;
                _mpPill = "DISCONNECTED";
                break;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void SendToHost(MpMessage message) => _ = SafeInvoke("pokerRealtime.toHost", Encode(message));

    private void RequestSync() => SendToHost(new MpMessage { t = "sync" });

    // Who is human, in each guest's own seat numbers, so a join or a leave
    // shows or hides chat without waiting for the next deal.
    private void BroadcastRoster()
    {
        if (!_hosting) return;
        foreach (int guest in _remote.Keys.ToList())
        {
            var names = new string[TableSeats];
            var humans = new bool[TableSeats];
            if (_game != null)
            {
                foreach (PokerPlayer p in _game.Players)
                {
                    int j = Rot(p.Seat, guest);
                    if (j < 0 || j >= TableSeats) continue;
                    names[j] = p.Seat == 0 ? PlayerName : NameOf(p.Seat);
                    humans[j] = IsHumanSeat(p.Seat);
                }
            }
            else
            {
                int hostSeat = Rot(0, guest);
                if (hostSeat >= 0 && hostSeat < TableSeats)
                {
                    names[hostSeat] = PlayerName;
                    humans[hostSeat] = true;
                }
                foreach (KeyValuePair<int, RemoteSeat> kv in _remote)
                {
                    int j = Rot(kv.Key, guest);
                    if (j < 0 || j >= TableSeats) continue;
                    names[j] = kv.Value.Name;
                    humans[j] = true;
                }
            }
            SendToGuest(guest, new MpMessage
            {
                t = "roster",
                names = names,
                humans = humans,
                hubs = HubSeatMapFor(guest)
            });
        }
    }

    private void ApplyRoster(MpMessage m)
    {
        if (m.humans == null) return;
        _guestHumanSeats.Clear();
        int limit = Math.Min(TableSeats, m.humans.Length);
        for (int j = 1; j < limit; j++)
        {
            if (m.names != null && j < m.names.Length && !string.IsNullOrEmpty(m.names[j]))
                _seatNames[j] = m.names[j];
            if (m.humans[j]) _guestHumanSeats.Add(j);
        }
        RememberHubSeats(m);
        SuppressAdviceForCompany();
        // The placeholder solo game is still on screen until the host's
        // first state arrives (_guestRot stays 0). Don't paint that over
        // the felt just because someone sat down.
        if (_guestRot != 0 && _sceneReady) _ = PushSceneState();
    }

    private void ApplyRemoteRename(int seat, string raw)
    {
        if (!_remote.TryGetValue(seat, out RemoteSeat remote)) return;
        string shown = SanitizeName(raw, allowEmpty: true);
        if (shown.Length == 0 || string.Equals(shown, remote.Name, StringComparison.Ordinal)) return;
        string previous = remote.Name;
        remote.Name = shown;
        _seatNames[seat] = shown;
        RefreshHostPill();
        BroadcastRoster();
        Announce($"{previous} is now {shown}.", skipSeat: seat);
        if (_sceneReady) _ = PushSceneState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Announce(string text, int skipSeat = -1)
    {
        text = SanitizeChat(text);
        if (text.Length == 0) return;
        AppendChat(null, text, 0, mine: false, system: true);
        if (!_hosting) return;
        foreach (int guest in _remote.Keys.ToList())
        {
            if (guest == skipSeat) continue;
            SendToGuest(guest, new MpMessage { t = "chat", a = "sys", text = text });
        }
    }

    private void ReceiveGuestChat(int seat, MpMessage m)
    {
        if (!IsRemote(seat)) return;
        if (_chatHeardAt.TryGetValue(seat, out DateTime last)
            && (DateTime.UtcNow - last).TotalMilliseconds < 250)
            return;
        string text = SanitizeChat(m.text);
        if (text.Length == 0) return;
        _chatHeardAt[seat] = DateTime.UtcNow;
        string name = _remote[seat].Name;
        AppendChat(name, text, seat, mine: false, system: false);
        foreach (int other in _remote.Keys.ToList())
        {
            if (other == seat) continue;
            SendToGuest(other, new MpMessage
            {
                t = "chat",
                who = name,
                text = text,
                seat = Rot(seat, other)
            });
        }
    }

    private void ReceiveRelayedChat(MpMessage m)
    {
        string text = SanitizeChat(m.text);
        if (text.Length == 0) return;
        if (m.a == "sys")
        {
            AppendChat(null, text, 0, mine: false, system: true);
            return;
        }
        string name = SanitizeName(m.who, allowEmpty: true);
        if (name.Length == 0) name = "Friend";
        int seat = m.seat;
        if (seat <= 0 || seat >= TableSeats) seat = 1;
        AppendChat(name, text, seat, mine: false, system: false);
    }

    private void AppendChat(string name, string text, int seat, bool mine, bool system)
    {
        _chat.Add(new ChatLine
        {
            Id = ++_chatSeq,
            Name = name,
            Text = text,
            Seat = seat < 0 ? 0 : seat,
            Mine = mine,
            System = system
        });
        if (_chat.Count > ChatMaxLines) _chat.RemoveAt(0);
        if (_chatCollapsed) _chatUnread++;
        else _chatPendingScroll = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleChat()
    {
        _chatCollapsed = !_chatCollapsed;
        if (!_chatCollapsed)
        {
            _chatUnread = 0;
            _chatPendingScroll = true;
        }
    }

    private void SubmitChat()
    {
        if (!ShowChat) return;
        string text = SanitizeChat(_chatDraft);
        if (text.Length == 0) return;
        if ((DateTime.UtcNow - _chatLastSent).TotalMilliseconds < 400) return;
        _chatLastSent = DateTime.UtcNow;
        _chatDraft = "";
        AppendChat(PlayerName, text, 0, mine: true, system: false);
        if (_isGuest)
        {
            SendToHost(new MpMessage { t = "chat", who = PlayerName, text = text });
            return;
        }
        foreach (int guest in _remote.Keys.ToList())
        {
            SendToGuest(guest, new MpMessage
            {
                t = "chat",
                who = PlayerName,
                text = text,
                seat = Rot(0, guest)
            });
        }
    }

    private static string SanitizeChat(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var cleaned = new System.Text.StringBuilder();
        bool pendingSpace = false;
        foreach (char c in raw.Trim())
        {
            if (char.IsControl(c)) continue;
            if (char.IsWhiteSpace(c))
            {
                pendingSpace = cleaned.Length > 0;
                continue;
            }
            if (pendingSpace)
            {
                if (cleaned.Length + 1 > ChatMaxLength) break;
                cleaned.Append(' ');
                pendingSpace = false;
            }
            if (char.IsHighSurrogate(c))
            {
                if (cleaned.Length + 2 > ChatMaxLength) break;
            }
            else if (cleaned.Length >= ChatMaxLength)
            {
                break;
            }
            cleaned.Append(c);
        }
        return cleaned.ToString();
    }

