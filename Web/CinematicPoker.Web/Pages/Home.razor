        _introStarted
        && _game?.HandNumber is >= 1 and <= EnlargeHintLastHand;

    private bool ShowCardWindowGlow =>
        _introStarted
        && _game?.HandNumber is >= 1 and <= EnlargeHintLastHand;

    private Task MaybeShowBoardHint()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task DismissBoardHint()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ------------------------------------------------------------- 3D scene

    private bool _sceneReady;

    protected override void OnInitialized()
    {
        // WASM can read localStorage synchronously here so TAP TO PLAY already
        // knows whether this device has a saved name.
        _playerName = ReadCachedPlayerName();
        _tableScene = ReadSceneSync();
        _settingsLoaded = !string.IsNullOrEmpty(_playerName) || JS is IJSInProcessRuntime;
        // The title menu is only for a fresh visit. Switching saloon/octagon
        // reloads this page; that return goes straight back to the table.
        _resumePlay = ReadInGameSync() && !string.IsNullOrEmpty(_playerName);
        if (_resumePlay) _introStarted = true;
        ReadInviteRoomFromUrl();
        NoteCoachPreviewFromUrl();
        NoteWinPreviewFromUrl();
        NoteVictoryGalleryPreviewFromUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chatPendingScroll)
        {
            _chatPendingScroll = false;
            try { await JS.InvokeVoidAsync("pokerRealtime.scrollChat"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        if (firstRender)
        {
            await LoadCoachPersistence();
            await LoadStatsArchive();
            await LoadWinGallery();
            await BindCoachEscape();
            if (_coachPreview)
            {
                _introStarted = true;
                _settingsLoaded = true;
                if (string.IsNullOrEmpty(_playerName))
                    _playerName = "Preview";
            }
            else if (_winPreview)
            {
                _introStarted = true;
                _settingsLoaded = true;
                if (string.IsNullOrEmpty(_playerName))
                    _playerName = "Jt";
            }
            else
            {
                if (_victoryGalleryPreview)
                {
                    _introStarted = true;
                    if (string.IsNullOrEmpty(_playerName))
                        _playerName = "Preview";
                }
                if (string.IsNullOrEmpty(_playerName))
                    _playerName = await ReadCachedPlayerNameAsync();
                _settingsLoaded = true;
                if (!_webSnapshotLoaded)
                {
                    _webSnapshotLoaded = true;
                    string saved = "";
                    // A friend's browser never resumes (or overwrites) its own
                    // saved solo game: the host's table is the only game there.
                    if (!_isGuest && !_victoryGalleryPreview)
                    {
                        try { saved = await JS.InvokeAsync<string>("pokerSession.load"); }
                        catch (JSException) { }
                    }
                    if (!string.IsNullOrEmpty(saved))
                        TryRestoreWebSession(saved);
                    // The audio module reads its channel prefs from its own
                    // localStorage key at script load, so it is already right
                    // before the first tap can start music. Adopt that state
                    // for the settings UI. Devices that saved sound prefs only
                    // inside the game-session snapshot (older builds) migrate:
                    // pushing the restored flags makes the JS module store them.
                    try
                    {
                        var stored = await JS.InvokeAsync<AudioChannelsState>("pokerAudio.getChannels");
                        if (stored is { Stored: true })
                        {
                            _musicOn = stored.Music;
                            // Prefs stored by the old four-channel menu map
                            // onto the single BACKGROUND switch with the same
                            // keep-audible bias as the save migration: off
                            // only when every channel was off.
                            _backgroundOn = stored.Voices || stored.Effects || stored.Ambience;
                            // Uniform the three JS channels so a partially-off
                            // legacy store matches the two-switch UI.
                            if (stored.Voices != _backgroundOn || stored.Effects != _backgroundOn || stored.Ambience != _backgroundOn)
                                PushAudioChannels();
                        }
                        else
                        {
                            PushAudioChannels();
                        }
                    }
                    catch (JSException) { }
                    // Restored tables never hit StartSessionCore, so ping here
                    // or solo play is invisible in Render logs. _hosting is
                    // still false this early — check the invite flag instead.
                    if (_game != null && !_isGuest)
                    {
                        string hosted = "";
                        try { hosted = await JS.InvokeAsync<string>("pokerInvite.hostedRoom"); }
                        catch (JSException) { }
                        _ = ReportUsageAsync(string.IsNullOrEmpty(hosted) ? "solo_resume" : "host_table");
                    }
                    if (_game == null && !string.IsNullOrEmpty(_playerName))
                        StartSessionCore(run: !_isGuest);
                }
                if (_victoryGalleryPreview)
                    ShowVictoryGalleryPreview();
                StateHasChanged();
                if (_isGuest && !string.IsNullOrEmpty(_playerName)) _ = ConnectGuestAsync();
                else _ = ResumeThenRunLoop();
            }

            // The scene module loads asynchronously; retry until it's there.
            for (int i = 0; i < 60 && !_sceneReady; i++)
            {
                try
                {
                    _selfRef ??= DotNetObjectReference.Create(this);
                    _sceneReady = await JS.InvokeAsync<bool>("pokerScene.init", "poker-canvas", _selfRef);
                }
                catch (JSException)
                {
                    await Task.Delay(250);
                }
            }
            if (_sceneReady)
            {
                // After a snapshot restore, C# may disagree with localStorage until synced.
                if (_game != null)
                {
                    try { await JS.InvokeVoidAsync("pokerScene.setTableScene", _tableScene); }
                    catch (JSException) { }
                }
                await SyncBackdropLabel();
            }
            if (_coachPreview) await OpenCoachPreview();
            else if (_resumePlay) await FinishDirectEntry();
            if (!_coachPreview && _game == null && !string.IsNullOrEmpty(_playerName) && _introStarted)
                StartSessionCore(run: !_isGuest);
        }
        if (_sceneReady && !_coachOpen) await PushSceneState();
        await FocusCoachPanel();
        if (_handRankingsOpen && !_handsZoomBound)
            await AttachHandsZoomAsync();
        // One-shot: fly to the winner's cards after the snapshot has put them
        // on the felt. Cleared immediately so later HUD updates do not yank
        // the camera back if the player has already looked around.
        if (_sceneReady && _pendingFocusSeat >= 0)
        {
            int seat = _pendingFocusSeat;
            _pendingFocusSeat = -1;
            try { await JS.InvokeVoidAsync("pokerScene.focusReveal", seat); }
            catch (JSException) { }
        }
    }

    private bool _tableCastLocked;

    private async Task PushSceneState(CompletedHandRecord handReview = null)
    {
        if (_game == null) return;
        if (!_tableCastLocked)
        {
            _tableCastLocked = true;
            try { await JS.InvokeVoidAsync("pokerScene.lockTableCast"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }

        // Capture the actor once for the whole snapshot. Reading CurrentSeat
        // independently while building each row made the scene's actor flag
        // vulnerable to a turn transition between rows, leaving the outline
        // and the HUD name briefly pointing at different seats.
        int actorSeat = _game.CurrentSeat;
        var seats = _game.Players.Select(p =>
        {
            SeatState s = SeatOf(p.Seat);
            bool folded = s != null && s.Folded;
            bool eliminated = ShownOut(p.Seat);
            bool acting = actorSeat == p.Seat;
            string status =
                folded ? "folded"
                : s != null && s.AllIn ? "ALL-IN"
                : s != null && s.CommittedThisStreet > 0 ? $"bet ${s.CommittedThisStreet}"
                : acting && !p.IsHuman ? "thinking…"
                : "";
            return new
            {
                seat = p.Seat,
                name = DisplayName(p),
                stack = ShownStack(p.Seat),
                bet = s?.CommittedThisStreet ?? 0,
                folded,
                @out = eliminated,
                actor = acting,
                // A render can briefly observe the round while its seat
                // collection is being replaced (new hand / continued game).
                // Missing seat state is not the same thing as folding: keep
                // the player active unless the engine explicitly says they
                // folded or were eliminated. Otherwise the WebGL reconciler
                // clears their cards and chips for one snapshot, and that
                // stale empty state can look like a random table animation.
                active = Round != null && !folded && !eliminated,
                heat = SeatHeat(p.Seat),
                human = IsHumanSeat(p.Seat),
                dealer = Round != null && p.Seat == Round.DealerSeat,
                sb = Round != null && p.Seat == Round.SmallBlindSeat,
                bb = Round != null && p.Seat == Round.BigBlindSeat,
                reveal = p.Seat != 0 && _revealed.TryGetValue(p.Seat, out var shown)
                    ? shown.Select(CardImage).ToArray()
                    : null,
                status
            };
        }).ToArray();

        IReadOnlyList<Card> boardCards = handReview?.FinalBoard is { Count: > 0 } reviewBoard
            ? reviewBoard
            : _shownBoard;
        string[] holeImages;
        if (handReview?.HeroHoleCards is { Count: 2 } reviewHoles)
            holeImages = reviewHoles.Select(CardImage).ToArray();
        else if (SeatOf(0) is { Folded: true })
            holeImages = Array.Empty<string>(); // folding mucks your cards during live play
        else
            holeImages = HoleCardsOf(0).Select(CardImage).ToArray();

        var snapshot = new
        {
            pot = Round?.PotTotal ?? 0,
            actorSeat,
            board = boardCards.Select(CardImage).ToArray(),
            hole = holeImages,
            seats
        };

        try { await JS.InvokeVoidAsync("pokerScene.update", snapshot); }
        catch (JSException ex)
        {
            // The scene self-heals on the next push, but surface the cause in
            // the browser console instead of hiding it — a silent failure here
            // is how seats ended up with no cards on the felt.
            Console.Error.WriteLine($"pokerScene.update failed: {ex.Message}");
        }
        if (!_isGuest) await PersistWebSession();
    }

    private void SceneEmotion(int seat, string mood, double intensity, bool speak = true)
    {
        if (!_sceneReady) return;
        _ = JS.InvokeVoidAsync("pokerScene.emotion", seat, mood, intensity, speak);
    }

    // 0 = settled, 1 = steaming. Read from the NPC's tilt after each hand.
    private double SeatHeat(int seat)
    {
        if (_game?.GetPlayer(seat) is not AIPlayer ai) return 0.2;
        return Math.Clamp(
            ai.Tilt.Tilt * 0.55 + ai.Tilt.Frustration * 0.45 + (1 - ai.Tilt.Confidence) * 0.2,
            0, 1);
    }

    private double PotHeat(long amount)
    {
        long bb = Math.Max(1, _game?.Rules.BigBlind ?? 10);
        return Math.Clamp(amount / (double)(bb * 28), 0, 1);
    }

    // Anyone still in the hand, other than the actor, feels the bet.
    private void NudgeWaiting(int actorSeat, double intensity)
    {
        if (_game == null) return;
        foreach (PokerPlayer p in _game.Players)
        {
            if (p.IsHuman || p.Seat == actorSeat) continue;
            SeatState s = SeatOf(p.Seat);
            if (s == null || s.Folded || p.Status == PlayerStatus.Eliminated) continue;
            SceneEmotion(p.Seat, "wait", Math.Clamp(Math.Max(intensity, SeatHeat(p.Seat)), 0, 1));
        }
    }

    private void RememberHand(HandCompleted completed)
    {
        int biggest = -1;
        long best = long.MinValue;
        foreach (var kv in completed.StackChanges)
            if (kv.Value > best) { best = kv.Value; biggest = kv.Key; }
        long bb = Math.Max(1, _game.Rules.BigBlind);
        foreach (var kv in completed.StackChanges)
            if (_game.GetPlayer(kv.Key) is AIPlayer ai)
                ai.OnHandCompleted(kv.Value, bb, biggest);
    }

