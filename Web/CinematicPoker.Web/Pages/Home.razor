    // ------------------------------------------------------------- engine events

    // Events are only queued here; ApplyEvent presents them via DrainEvents.
    // The hand log records every event immediately so exports stay complete
    // even while the table is still animating a prior street.
    private void OnEngineEvent(PokerEvent evt)
    {
        _handLog.OnEvent(evt);
        _pending.Enqueue(evt);
    }

    /// <summary>
    /// Presents queued engine events in order, pausing before the dramatic
    /// ones (a dealt street, the showdown reveal, the pot award) — so the
    /// river card is on the table and readable BEFORE the winner is
    /// announced, instead of everything landing in one frame.
    /// </summary>
    private async Task DrainEvents(int token)
    {
        while (_pending.Count > 0)
        {
            if (token != _loopToken) return; // session restarted; new loop owns the queue
            PokerEvent evt = _pending.Dequeue();
            ApplyEvent(evt);
            StateHasChanged();
            int after = PauseAfter(evt);
            if (after > 0)
                await PacedDelay(after, token);
            if (token != _loopToken) return;
            int before = PauseBefore(_pending.Count > 0 ? _pending.Peek() : null);
            if (before > 0)
                await PacedDelay(before, token);
        }
        StateHasChanged();
    }

    // Dwell time BEFORE presenting the given queued event: let the current
    // street sink in before hands are revealed, and the reveal sink in
    // before the pot is pushed.
    private int PauseBefore(PokerEvent next) => next switch
    {
        FlopDealt or TurnDealt or RiverDealt => _quickMode ? 900 : 1400,
        ShowdownStarted => _quickMode ? 1400 : 2200,
        PotAwarded => _quickMode ? 1200 : 2000,
        _ => 0
    };

    // Extra dwell AFTER the current event is on screen: read opponent hole
    // cards at showdown, then sit with the win/loss amount before the next
    // hand wipes the table.
    private int PauseAfter(PokerEvent evt) => evt switch
    {
        ShowdownStarted => _quickMode ? 1800 : 2800,
        PotAwarded award => award.WinnerSeats.Contains(0)
            ? (_quickMode ? 2400 : 3800)
            : (_quickMode ? 1800 : 2800),
        _ => 0
    };

    // Stack as the table currently shows it: winnings (and returned uncalled
    // bets) that are still queued behind the reveal pauses are hidden, so
    // nobody's chip count gives away the result before it is announced.
    private long ShownStack(int seat)
    {
        long stack = SeatOf(seat)?.Stack ?? _game.GetPlayer(seat).Stack;
        foreach (PokerEvent evt in _pending)
        {
            if (evt is PotAwarded award && award.Payouts != null && award.Payouts.TryGetValue(seat, out long paid))
                stack -= paid;
            else if (evt is UncalledBetReturned ret && ret.Seat == seat)
                stack -= ret.Amount;
        }
        return stack;
    }

    // Eliminations are applied in the engine as soon as the pot is awarded,
    // which is before this table has shown the hole cards or the dollar
    // amount. Hide OUT until those events have been presented.
    private bool ShownOut(int seat)
    {
        if (_game.GetPlayer(seat).Status != PlayerStatus.Eliminated) return false;
        foreach (PokerEvent evt in _pending)
        {
            if (evt is PotAwarded or HandCompleted or PlayerEliminated)
                return false;
        }
        return true;
    }

    private void ApplyEvent(PokerEvent evt)
    {
        PlaySoundFor(evt);

        switch (evt)
        {
            case HandStarted started:
                _revealed.Clear();
                _shownBoard.Clear();
                _showdownView.Clear();
                _showdownHandCount = 0;
                _banner = null;
                _bannerAmount = null;
                _playerWonPot = false;
                _handHasCompleted = false;
                break;

            case FlopDealt flop:
                _shownBoard.Add(flop.Card1);
                _shownBoard.Add(flop.Card2);
                _shownBoard.Add(flop.Card3);
                break;

            case TurnDealt turn:
                _shownBoard.Add(turn.Card);
                break;

            case RiverDealt river:
                _shownBoard.Add(river.Card);
                break;

            case ShowdownStarted showdown:
                _showdownHandCount = showdown.RevealedHands.Count;
                _statusLine = "Showdown — read their cards";
                _showdownView.Clear();
                foreach (var kv in showdown.RevealedHands.OrderBy(h => h.Key))
                {
                    _revealed[kv.Key] = kv.Value;
                    _showdownView.Add(new ShowdownRow
                    {
                        Seat = kv.Key,
                        Name = kv.Key == 0 ? "You" : NameOf(kv.Key),
                        Cards = kv.Value,
                        HandName = DescribeShownHand(kv.Value),
                        Winner = false
                    });
                }
                break;

            case PlayerChecked checkedEvt:
                SceneAction(checkedEvt.Seat, "check");
                break;

            case PlayerFolded foldedEvt:
                SceneAction(foldedEvt.Seat, "fold");
                // Letting a big pot go stings. The fold plays first; the
                // disappointment follows when that gesture lets go.
                // Don't fire a second voice — the fold line already spoke.
                if (foldedEvt.Seat != 0 && Round != null && Round.PotTotal > _game.Rules.BigBlind * 16)
                    SceneEmotion(foldedEvt.Seat, "lose", 0.4, speak: false);
                break;

            case PotAwarded award:
            {
                double potHeat = PotHeat(award.Amount);
                // Body takes on every winner/loser; only one NPC speaks so the
                // table doesn't stack the same sayings on top of each other.
                bool spoken = false;
                foreach (int seatIdx in award.WinnerSeats)
                {
                    bool speak = !spoken && seatIdx != 0;
                    SceneEmotion(seatIdx, "win", potHeat, speak);
                    if (speak) spoken = true;
                }
                if (award.WinningHand.HasValue)
                {
                    foreach (int seatIdx in _revealed.Keys)
                    {
                        if (award.WinnerSeats.Contains(seatIdx)) continue;
                        bool speak = !spoken && seatIdx != 0;
                        SceneEmotion(seatIdx, "lose", Math.Max(0.5, potHeat), speak);
                        if (speak) spoken = true;
                    }
                }
                // A heads-up showdown (exactly two hands compared) gets a
                // victory fanfare for whoever comes out on top.
                if (_showdownHandCount == 2 && !_muted)
                {
                    _ = JS.InvokeVoidAsync("pokerAudio.victory");
                    _showdownHandCount = 0; // once per showdown (side pots re-award)
                }
                // The player's own win gets the full show: fireworks + sparklers,
                // and the dealer names the winning hand (full house, straight, …).
                // Stay on the table camera so opponent hole cards remain in view.
                if (award.WinnerSeats.Contains(0))
                {
                    if (_sceneReady)
                        _ = JS.InvokeVoidAsync("pokerScene.celebrate");
                    if (award.WinningHand.HasValue)
                        PlayDealer(HandClip(award.WinningHand.Value.Category));
                }
                foreach (ShowdownRow row in _showdownView)
                    row.Winner = award.WinnerSeats.Contains(row.Seat);
                _playerWonPot = award.WinnerSeats.Contains(0);
                long paid = 0;
                if (award.Payouts != null)
                    award.Payouts.TryGetValue(0, out paid);
                _bannerAmount = _playerWonPot && paid > 0 ? paid : award.Amount;
                string winners = string.Join(" & ", award.WinnerSeats.Select(s => s == 0 ? "You" : NameOf(s)));
                if (_playerWonPot)
                {
                    _banner = award.WinningHand.HasValue
                        ? $"YOU WON with {Pretty(award.WinningHand.Value.Category)}"
                        : "YOU WON — everyone folded";
                }
                else
                {
                    _banner = award.WinningHand.HasValue
                        ? $"{winners} win{(award.WinnerSeats.Count == 1 ? "s" : "")} with {Pretty(award.WinningHand.Value.Category)}"
                        : $"{winners} take{(award.WinnerSeats.Count == 1 ? "s" : "")} the pot";
                }
                _statusLine = _bannerAmount.HasValue
                    ? $"{_banner}  ·  ${_bannerAmount.Value}"
                    : _banner;
                break;
            }

            default:
                // Chip-toss gesture whenever someone puts chips in the middle.
                switch (evt)
                {
                    case PlayerCalled pc: SceneAction(pc.Seat, "call"); break;
                    case BetPlaced bp: SceneAction(bp.Seat, "bet"); break;
                    case PlayerRaised pr:
                        SceneAction(pr.Seat, "raise");
                        NudgeWaiting(pr.Seat, 0.5);
                        break;
                    case PlayerAllIn pa:
                        SceneAction(pa.Seat, "allin");
                        NudgeWaiting(pa.Seat, 0.85);
                        break;
                    case HandCompleted completed:
                        RememberHand(completed);
                        _handHasCompleted = true;
                        break;
                }
                break;
        }
    }

    // ------------------------------------------------------------------ helpers

    private string NameOf(int seat) => _game.GetPlayer(seat).Name;

    private PokerPlayer HudActor =>
        _game == null || _sessionOver ? null : _game.CurrentPlayer;

    private string HudActorRole
    {
        get
        {
            if (HudActor == null || Round == null) return null;
            int seat = HudActor.Seat;
            if (seat == Round.DealerSeat) return "dealer";
            if (seat == Round.SmallBlindSeat) return "sb";
            if (seat == Round.BigBlindSeat) return "bb";
            return null;
        }
    }

    private string HudActorStatusLine
    {
        get
        {
            PokerPlayer actor = HudActor;
            if (actor == null) return null;
            SeatState s = SeatOf(actor.Seat);
            if (s != null && s.AllIn) return "ALL-IN";
            if (s != null && s.CommittedThisStreet > 0) return $"bet ${s.CommittedThisStreet}";
            if (actor.IsHuman) return null;
            return "thinking…";
        }
    }

    private static string HandClip(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high-card",
        HandCategory.Pair => "pair",
        HandCategory.TwoPair => "two-pair",
        HandCategory.ThreeOfAKind => "three-of-a-kind",
        HandCategory.Straight => "straight",
        HandCategory.Flush => "flush",
        HandCategory.FullHouse => "full-house",
        HandCategory.FourOfAKind => "four-of-a-kind",
        HandCategory.StraightFlush => "straight-flush",
        HandCategory.RoyalFlush => "royal-flush",
        _ => null
    };

    private void PlayDealer(string clip)
    {
        if (_muted || string.IsNullOrEmpty(clip)) return;
        try { _ = JS.InvokeVoidAsync("pokerAudio.dealer", clip); }
        catch (JSException) { }
    }

    private string DescribeShownHand(IReadOnlyList<Card> hole)
    {
        if (hole == null || hole.Count + _shownBoard.Count < 5) return null;
        try { return Pretty(HandEvaluator.Evaluate(hole, _shownBoard).Category); }
        catch (ArgumentException) { return null; }
    }

    private static string Pretty(HandCategory category) => category switch
    {
        HandCategory.HighCard => "high card",
        HandCategory.Pair => "a pair",
        HandCategory.TwoPair => "two pair",
        HandCategory.ThreeOfAKind => "three of a kind",
        HandCategory.Straight => "a straight",
        HandCategory.Flush => "a flush",
        HandCategory.FullHouse => "a full house",
        HandCategory.FourOfAKind => "four of a kind",
        HandCategory.StraightFlush => "a straight flush",
        HandCategory.RoyalFlush => "a ROYAL FLUSH",
        _ => category.ToString()
    };

    private SeatState SeatOf(int seat)
    {
        if (Round == null) return null;
        foreach (SeatState s in Round.Seats)
            if (s.Seat == seat) return s;
        return null;
    }

    private IReadOnlyList<Card> HoleCardsOf(int seat) =>
        SeatOf(seat)?.HoleCards ?? (IReadOnlyList<Card>)Array.Empty<Card>();

    // Kenney boardgame pack card faces (CC0) — see ASSET_LICENSES.md.
    private static string CardImage(Card card)
    {
        string rank = card.Rank == Rank.Ten ? "10" : Card.RankSymbol(card.Rank);
        return $"img/cards/{card.Suit.ToString().ToLowerInvariant()}_{rank}.png";
    }

    // -------------------------------------------------------------- backdrop

    private string _backdropName = "ARCADE";

    private async Task CycleBackdrop()
    {
        _backdropName = await JS.InvokeAsync<string>("pokerScene.cycleBackdrop");
        // Each backdrop brings its own music bed (beach/western/disco/saloon).
        await JS.InvokeVoidAsync("pokerAudio.setScene", _backdropName);
    }

    // -------------------------------------------------------------- sounds

    private bool _muted;

    private void ToggleMute()
    {
        _muted = !_muted;
        _ = JS.InvokeVoidAsync("pokerAudio.setMuted", _muted);
    }

    private static readonly Dictionary<string, string[]> SoundGroups = new()
    {
        ["shuffle"] = new[] { "card-shuffle" },
        ["deal"] = new[] { "card-slide-1", "card-slide-2", "card-slide-3" },
        ["place"] = new[] { "card-place-1", "card-place-2" },
        ["fold"] = new[] { "card-shove-1" },
        ["chips"] = new[] { "chips-stack-1", "chips-stack-2", "chips-stack-3" },
        ["raise"] = new[] { "chips-handle-1", "chips-handle-2" },
        ["allin"] = new[] { "chips-collide-1", "chips-collide-2" }
    };

    private int _dealSoundIndex;

    private void PlaySound(string group, int delayMs = 0)
    {
        if (_muted) return;
        string[] variants = SoundGroups[group];
        _ = JS.InvokeVoidAsync("pokerAudio.play", variants[_rng.Next(variants.Length)], delayMs);
    }

    private void PlaySoundFor(PokerEvent evt)
    {
        // Your two cards land audibly after the shuffle, not on top of it.
        if (evt is HandStarted) _dealSoundIndex = 0;
        if (evt is CardDealt dealtCard && dealtCard.Seat == 0)
        {
            PlaySound("place", 700 + _dealSoundIndex++ * 280);
            return;
        }

        string group = evt switch
        {
            HandStarted _ => "shuffle",
            FlopDealt _ => "deal",
            TurnDealt _ => "deal",
            RiverDealt _ => "deal",
            BetPlaced _ => "chips",
            PlayerCalled _ => "chips",
            PlayerRaised _ => "raise",
            PlayerAllIn _ => "allin",
            PlayerFolded _ => "fold",
            PotAwarded _ => "allin", // big pile of chips pushed to the winner
            _ => null
        };
        if (group != null) PlaySound(group);
    }
}
