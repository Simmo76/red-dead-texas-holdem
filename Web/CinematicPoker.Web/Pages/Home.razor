@page "/"
@using CinematicPoker.Engine.AI
@using CinematicPoker.Engine.Coaching
@using CinematicPoker.Engine.Players
@using CinematicPoker.Engine.Poker
@using CinematicPoker.Engine.Simulation
@using CinematicPoker.Web.Diagnostics
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Dead Man's Hand</PageTitle>

@* Tapping anywhere outside the enlarged card close-up contracts it back
   to its corner size; the close-up itself stops propagation so its own
   tap still toggles (see ToggleHudBoard). *@
<div class="@GameRootClass" @onclick="CollapseHudBoard">

    <canvas id="poker-canvas"></canvas>

    @if (!_introStarted)
    {
        <div class="intro-overlay intro-splash @(_introFading ? "fading" : "") @(_namePromptOpen ? "prompting" : "")"
             @onclick="StartIntro" role="button" aria-label="Tap to play">
            <div class="intro-splash-art @(_tableScene == "street" ? "street" : "")">
                @if (_sceneLoading && !_namePromptOpen)
                {
                    @* Play was tapped but the scene (saloon backdrop included) is
                       still downloading — say so instead of silently sitting on
                       the splash or, worse, revealing a background-less table. *@
                    <div class="intro-loading" aria-live="polite">SETTING THE TABLE</div>
                }
                else if (!_namePromptOpen)
                {
                    @* Title art + TAP TO PLAY live in the splash image; keep a
                       pulsing hotspot over the painted CTA so the cue still animates. *@
                    <div class="intro-tap-pulse" aria-hidden="true"></div>
                }
            </div>
            @if (_namePromptOpen)
            {
                <div class="name-prompt" @onclick:stopPropagation="true">
                    <div class="intro-title">WHAT DO THEY <span>CALL YOU</span></div>
                    <p class="name-blurb">We’ll remember it on this device so you only enter it once.</p>
                    <div class="name-entry-row">
                        <input class="name-input" type="text" maxlength="16"
                               autocapitalize="words" autocomplete="nickname" autocorrect="off" spellcheck="false"
                               placeholder="Your name" @bind="_nameDraft" @bind:event="oninput"
                               @onkeydown="OnNameKeyDown" />
                        <button class="act call big" disabled="@(!CanConfirmName)" @onclick="ConfirmName">SIT DOWN</button>
                    </div>
                </div>
            }
        </div>
    }
    <header class="topbar gameplay-toolbar" role="toolbar" aria-label="Game controls" @onclick:stopPropagation="true">
        <div class="topbar-left toolbar-brand">
            <img class="toolbar-logo"
                 src="img/toolbar-logo-h44.png"
                 srcset="img/toolbar-logo-h34.png 34w, img/toolbar-logo-h44.png 44w"
                 sizes="(max-width: 559px) 120px, 180px"
                 width="130"
                 height="44"
                 alt="Dead Man's Hand" />
            @if (Round != null)
            {
                <div class="hud-pot">POT&nbsp;<b>$@Round.PotTotal</b></div>
            }
        </div>
        <div class="topbar-right toolbar-controls">
            <div class="topbar-actions toolbar-actions">
                @if (CanReview && _handHasCompleted && _awaitingNextHand)
                {
                    <button type="button" class="toolbar-btn review-hand toolbar-coach" @onclick="OpenCoachReview"
                            title="Ask the poker coach about the last hand" aria-label="Poker coach">
                        <span class="toolbar-btn-label">Coach</span>
                    </button>
                }
                <ToolbarButton IconSrc="icons/toolbar/rules" Label="Rules" AriaLabel="Rules — how to play Texas Hold'em"
                               OnClick="OpenRules" CssClass="toolbar-primary" />
                @if (_musicOn)
                {
                    <ToolbarButton IconSrc="icons/toolbar/tune" Label="Tune" AriaLabel="Tune — skip to the next song"
                                   Title="Skip to the next song" OnClick="NextSong"
                                   CssClass="toolbar-primary toolbar-item-tune" />
                }
                <ToolbarButton IconSrc="icons/toolbar/hands" Label="Hands" AriaLabel="Hands — poker hand rankings"
                               OnClick="OpenHandRankings" CssClass="toolbar-primary" />
                @if (_sceneReady)
                {
                    <ToolbarButton IconSrc="icons/toolbar/view" Label="View"
                                   AriaLabel="@(_overheadView ? "View — return to seat camera" : "View — overhead table camera")"
                                   Title="@(_overheadView ? "Back to your seat" : "Overhead camera — see every player's remaining chips")"
                                   Active="_overheadView" Toggle="true" OnClick="ToggleOverheadView"
                                   CssClass="toolbar-primary toolbar-item-view" />
                }
                <ToolbarButton IconSrc="icons/toolbar/settings" AriaLabel="Settings" Title="Game settings"
                               OnClick="OpenSettings" ShowLabel="false" CssClass="toolbar-primary toolbar-item-settings" />
                <div class="toolbar-more-wrap">
                    <button type="button" class="toolbar-btn toolbar-btn-icon toolbar-more-trigger"
                            aria-label="More actions" aria-haspopup="menu" aria-expanded="@_toolbarMoreOpen"
                            @onclick="ToggleToolbarMore">
                        <span class="toolbar-btn-icon" aria-hidden="true">
                            <img class="toolbar-icon-img toolbar-icon-fallback" src="icons/toolbar/more.png" alt="" width="24" height="24" />
                        </span>
                    </button>
                    @if (_toolbarMoreOpen)
                    {
                        <div class="toolbar-overflow-menu" role="menu" @onclick:stopPropagation="true">
                            @if (_musicOn)
                            {
                                <button type="button" class="toolbar-overflow-item" role="menuitem" @onclick="OverflowTune">
                                    <img src="icons/toolbar/tune.png" alt="" width="24" height="24" aria-hidden="true" />
                                    Tune
                                </button>
                            }
                            <button type="button" class="toolbar-overflow-item" role="menuitem" @onclick="OverflowSettings">
                                <img src="icons/toolbar/settings.png" alt="" width="24" height="24" aria-hidden="true" />
                                Settings
                            </button>
                            @if (ShowInviteButton && !_isGuest)
                            {
                                <button type="button" class="toolbar-overflow-item" role="menuitem" @onclick="OverflowInvite">
                                    Invite friend
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            @if (ShowInviteButton && !_isGuest)
            {
                <button type="button" class="chip-btn invite-btn toolbar-invite-wide" @onclick="OpenInvite"
                        title="Invite a friend to this table" aria-label="Invite friend">
                    <span aria-hidden="true">♧</span> Invite
                </button>
            }
        </div>
    </header>

    @if (ShowFriendPill)
    {
        <div class="friend-seat-pill" role="status">
            <span class="friend-seat-dot"></span>
            <span>@_mpPill</span>
        </div>
    }

    @if (Round != null)
    {
        @* Pot lives under the brand in the topbar. This column only keeps
           the current-actor window while the enlarged card close-up owns
           the right edge, so those big cards can never cover it. *@
        @if (_hudBoardExpanded && HudActor != null && !_overheadView)
        {
            <div class="hud-meters">
                @ActorCardFragment
            </div>
        }

        @* The overhead view already shows the board and every stack on the
           felt itself, so the floating card window stays out of its way. *@
        @if (!_overheadView)
        {
        <div class="hud-hand-rail @(_hudBoardExpanded ? "board-expanded-rail" : "")">
        <div class="hud-board @(_hudBoardExpanded ? "expanded" : "") @(ShowCardWindowGlow ? "hint-active" : "")"
             @onclick="ToggleHudBoard" @onclick:stopPropagation="true">
                <div class="hud-row hud-card-cue-row">
                @* Dealt cards fill from the right so they hug the border,
                   aligned above the player's pair. *@
                @for (int i = 0; i < 5; i++)
                {
                    var dealt = i - (5 - _shownBoard.Count);
                    if (dealt >= 0)
                    {
                        <img class="hud-card" src="@CardImage(_shownBoard[dealt])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
            <div class="hud-row hud-hole hud-card-cue-row">
                @if (ShowEnlargeHint)
                {
                    @* No @onclick of its own: the click bubbles to the parent
                       .hud-board handler (ToggleHudBoard), same as the old
                       text hint. Arrows point outward to expand, inward to
                       minimise. *@
                    <button type="button" class="board-hint @(_hudBoardExpanded ? "expanded" : "")"
                            aria-label="@(_hudBoardExpanded ? "Minimise cards" : "Expand cards")"
                            title="@(_hudBoardExpanded ? "Minimise cards" : "Expand cards")">
                        @if (_hudBoardExpanded)
                        {
                            <svg class="board-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M10 4.5V10H4.5" /><path d="M4 4l6 6" />
                                <path d="M14 4.5V10h5.5" /><path d="M20 4l-6 6" />
                                <path d="M10 19.5V14H4.5" /><path d="M4 20l6-6" />
                                <path d="M14 19.5V14h5.5" /><path d="M20 20l-6-6" />
                            </svg>
                        }
                        else
                        {
                            <svg class="board-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9.5 4H4v5.5" /><path d="M4 4l6 6" />
                                <path d="M14.5 4H20v5.5" /><path d="M20 4l-6 6" />
                                <path d="M9.5 20H4v-5.5" /><path d="M4 20l6-6" />
                                <path d="M14.5 20H20v-5.5" /><path d="M20 20l-6-6" />
                            </svg>
                        }
                    </button>
                }
                @{ IReadOnlyList<Card> hudHole = SeatOf(0) is { Folded: true } ? Array.Empty<Card>() : HoleCardsOf(0); }
                @for (int i = 0; i < 2; i++)
                {
                    if (i < hudHole.Count)
                    {
                        <img class="hud-card" src="@CardImage(hudHole[i])" alt="" />
                    }
                    else
                    {
                        <img class="hud-card facedown" src="img/cards/back.png" alt="" />
                    }
                }
            </div>
            @if (HudWinningHand is { } winHand)
            {
                <div class="hud-row hud-winner" title="@winHand.Name's winning hand">
                    <span class="hud-winner-name" style="color:@SeatColor(winHand.Seat)">@winHand.Name</span>
                    @foreach (var card in winHand.Cards)
                    {
                        <img class="hud-card" src="@CardImage(card)" alt="" />
                    }
                </div>
            }
        </div>
            @* Pinned under the card panel on the right so it never stacks on
               top of the board; the close-up moves the actor to hud-meters. *@
            @if (HudActor != null && !_hudBoardExpanded)
            {
                @ActorCardFragment
            }
        </div>
        }
    }

    @if (_banner != null)
    {
        @* While the result is announced, fade the table (3D cards, board
           HUD) behind a dim veil so the banner and the hand-compare strip
           are the only bright things on screen. Sits above the z:5 HUD
           layers but below .hud-bottom (8) and .banner (12). *@
        <div class="result-dim" aria-hidden="true"></div>
        @if (_playerWonPot)
        {
            <img class="victory-gallery-plaque" src="@VictoryGalleryPlaqueImage" alt="Gallery of Wins"
                 width="2149" height="280" decoding="async" />
            <div class="victory-carousel victory-carousel-coverflow @(_winGallery.Count > 1 ? "victory-carousel-nav" : "")">
                @if (_winGallery.Count > 1)
                {
                    <button type="button" class="victory-nav victory-nav-prev"
                            disabled="@(!CanShowPreviousVictory)" aria-label="Previous win"
                            @onclick="ShowPreviousVictory" @onclick:stopPropagation="true">&#8249;</button>
                }
                <div class="victory-carousel-viewport victory-swipe-stage">
                    <div class="victory-carousel-track" aria-live="polite">
                        @if (_winGallery.Count == 0)
                        {
                            <div class="victory-carousel-slide victory-carousel-slide-active">
                                @RenderVictoryBanner(
                                    null,
                                    VictoryDisplayAmount,
                                    VictoryDisplayHoleCards,
                                    VictoryDisplayHeadline,
                                    VictoryDisplayBoardCards,
                                    VictoryDisplayFooter,
                                    isActive: true)
                            </div>
                        }
                        else
                        {
                            @for (var slideIndex = 0; slideIndex < _winGallery.Count; slideIndex++)
                            {
                                var record = _winGallery[slideIndex];
                                var offset = slideIndex - _winGalleryIndex;
                                if (VictorySlideRenderMaxOffset < int.MaxValue
                                    && Math.Abs(offset) > VictorySlideRenderMaxOffset)
                                {
                                    continue;
                                }

                                var holeCards = ParseVictoryCards(record.holeCards);
                                var boardCards = ParseVictoryCards(record.boardCards);
                                <div @key="@(record.handNumber + "-" + record.capturedAtUtcMs)"
                                     class="victory-carousel-slide @VictorySlideClass(offset)"
                                     data-victory-offset="@offset"
                                     aria-hidden="@(offset != 0 ? "true" : "false")">
                                    @RenderVictoryBanner(
                                        record,
                                        record.amount,
                                        holeCards,
                                        record.headline,
                                        boardCards,
                                        VictoryRecordFooter(record),
                                        offset == 0);
                                </div>
                            }
                        }
                    </div>
                </div>
                @if (_winGallery.Count > 1)
                {
                    <button type="button" class="victory-nav victory-nav-next"
                            disabled="@(!CanShowNextVictory)" aria-label="Next win"
                            @onclick="ShowNextVictory" @onclick:stopPropagation="true">&#8250;</button>
                    <div class="victory-carousel-counter" aria-live="polite">
                        @(_winGalleryIndex + 1) / @_winGallery.Count
                    </div>
                }
            </div>
        }
        else
        {
        <div class="banner banner-result">
                @* Someone else took the pot: their two cards sit to the LEFT
                   of the text column so the amount and the reason they won
                   read beside the hand, not underneath it. The community
                   cards stay below, matching the player's victory certificate
                   so it is clear how that opponent made the winning hand. *@
                <div class="banner-result-row">
                    @if (BannerHandCards is { Count: > 0 } cards)
                    {
                        <div class="banner-cards" aria-label="Winning hand">
                            @foreach (var card in cards)
                            {
                                <img class="hud-card" src="@CardImage(card)" alt="" />
                            }
                        </div>
                    }
                    <div class="banner-result-text">
                        @if (_bannerAmount.HasValue)
                        {
                            <div class="banner-amount">$@_bannerAmount.Value</div>
                        }
                        <div class="banner-line">@_banner</div>
                        @if (!string.IsNullOrEmpty(_bannerReason))
                        {
                            <div class="banner-reason">@_bannerReason</div>
                        }
                    </div>
                </div>
                @if (_shownBoard.Count > 0)
                {
                    <div class="cert-board-label">ON THE BOARD</div>
                    <div class="cert-board" aria-label="Community cards">
                        @foreach (var card in _shownBoard)
                        {
                            <img class="hud-card" src="@CardImage(card)" alt="" />
                        }
                    </div>
                }
            @if (CanReview)
            {
                <button type="button" class="act ff review-hand cert-coach" @onclick="OpenCoachReview"
                        @onclick:stopPropagation="true"
                        title="Ask @CoachDisplayName what happened">
                    Poker Coach Feedback
                </button>
            }
        </div>
        }
    }

    @* Hand-compare sits in its own centered stage (not the bottom flow
       column) so multi-seat showdowns stay middle-of-screen and never
       clip past the top or bottom of the viewport. Fold-wins that only
       list the player's own cards stay off the strip — those cards already
       live in the victory banner, which is what the photo captures. *@
    @if (ShowShowdownCompare)
    {
        <div class="showdown-layer">
            <div class="showdown-strip">
                @foreach (var row in _showdownView)
                {
                    <div class="showdown-seat @(row.Winner ? "winner" : "")">
                        <div class="showdown-name" style="color:@SeatColor(row.Seat)">@row.Name</div>
                        <div class="showdown-cards">
                            @foreach (var card in row.Cards)
                            {
                                <img class="hud-card" src="@CardImage(card)" alt="" />
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(row.HandName))
                        {
                            <div class="showdown-hand">@row.HandName</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* Bottom-edge flow column: Maximilian's advisor, the actor card and
       the action bar stack on top of each other instead of overlapping. *@
    <div class="hud-bottom">

    <div class="hud-bottom-row @(ShowChat ? "with-chat" : "") @(_chatCollapsed ? "" : "chat-open")">

    @* Friends talk from the left end of this row — the left thumb in
       landscape, and a slot that's empty except on your own turn, when
       Maximilian sits just to its right. Hidden entirely while you're
       the only human here. The header carries who's seated, so the old
       floating "at the table" pill can stay out of the top-left corner. *@
    @if (ShowChat)
    {
        <section class="table-chat @(_chatCollapsed ? "collapsed" : "") @(_chatCollapsed && _chatUnread > 0 ? "has-unread" : "")"
                 aria-label="Table chat" @onclick:stopPropagation="true">
            <button type="button" class="table-chat-toggle" @onclick="ToggleChat"
                    aria-expanded="@(!_chatCollapsed)"
                    title="@(_chatCollapsed ? "Show table chat" : "Hide table chat")">
                <span class="table-chat-mark" aria-hidden="true"></span>
                <span class="table-chat-heading">CHAT</span>
                @if (_chatCollapsed && _chatUnread > 0)
                {
                    <span class="table-chat-unread">@(_chatUnread > 9 ? "9+" : _chatUnread.ToString())</span>
                }
                <span class="table-chat-who">@ChatBarHint</span>
                <span class="table-chat-chevron" aria-hidden="true"></span>
            </button>
            @if (!_chatCollapsed)
            {
                <div class="table-chat-log" id="chat-log" role="log" aria-live="polite">
                    @if (_chat.Count == 0)
                    {
                        <p class="table-chat-empty">The table's quiet. Say howdy.</p>
                    }
                    else
                    {
                        @foreach (var line in _chat)
                        {
                            @if (line.System)
                            {
                                <p class="table-chat-line system" @key="line.Id">@line.Text</p>
                            }
                            else
                            {
                                <p class="table-chat-line @(line.Mine ? "mine" : "")" @key="line.Id">
                                    <span class="table-chat-name" style="color:@SeatColor(line.Seat)">@line.Name</span>
                                    <span class="table-chat-text">@line.Text</span>
                                </p>
                            }
                        }
                    }
                </div>
                <form class="table-chat-form" @onsubmit="SubmitChat" @onsubmit:preventDefault="true">
                    <input class="table-chat-input" type="text" maxlength="@ChatMaxLength"
                           placeholder="Talk to the table…"
                           autocomplete="off" enterkeyhint="send"
                           aria-label="Message the table"
                           @bind="_chatDraft" @bind:event="oninput" />
                    <button class="act small table-chat-send" type="submit" disabled="@(!CanSendChat)">SEND</button>
                </form>
            }
        </section>
    }

    @* Expanded close-up moves this window up under the brand+pot column
       (see the hud-meters block above). *@
    @* The overhead plates already name the actor (gold border) with their
       stack and status, so the floating actor window would only cover them. *@

    @* "What would AI do?" — the table coach (random saloon or octagon
       portrait for this game). On your turn
       only the title button shows; his advice stays hidden until you tap it,
       so the read is never spoiled before you've asked for it. Tap again to
       put it away. It starts hidden again on every new turn. With another
       human at the table the button stays off — the count would play the
       hand for you. *@
    @if (ShowAiAdvice && !_overheadView)
    {
        <div class="ai-advice @(_adviceCollapsed ? "collapsed" : "")" @onclick="ToggleAdvice"
             title="Tap and @CoachDisplayName counts the cards and tells you what he'd do">
            <img class="ai-advice-icon" @key="@($"{_tableScene}:{ActiveCoachPortrait.Id}")"
                 src="@CoachAdviceIcon" alt="" aria-hidden="true" />
            <div class="ai-advice-plate">
                <div class="ai-advice-title">POKER <span>COACH</span> ADVICE</div>
                @if (!_adviceCollapsed && _advice != null)
                {
                    <div class="ai-advice-action">@_advice.ActionLabel</div>
                    <div class="ai-advice-stats">
                        <span class="ai-stat">EST. EQUITY <b>@_advice.WinPercent%</b></span>
                        @if (_advice.PotOddsPercent.HasValue)
                        {
                            <span class="ai-stat">POT ODDS <b>@_advice.PotOddsPercent%</b></span>
                        }
                        <span class="ai-stat">VS <b>@_advice.Opponents</b></span>
                    </div>
                    <div class="ai-advice-why">@_advice.Rationale</div>
                    <div class="ai-advice-sig">— @CoachDisplayName, card counter</div>
                }
            </div>
        </div>
    }

    </div>

    <div class="actionbar">
        @if (Round != null)
        {
            <div class="hud-stack" title="Chips you have left">
                <span class="hud-stack-icon" aria-hidden="true"></span>
                <span class="hud-stack-name" style="color:@SeatColor(0)">@PlayerName.ToUpperInvariant()</span>
                <b>$@ShownStack(0)</b>
            </div>
        }
        @if (_awaitingHuman && _legal != null && !_showSlider)
        {
            <div class="actionbar-left">
                @if (_legal.CanFold) { <button class="act fold" @onclick="() => Act(PlayerAction.Fold())">FOLD</button> }
            </div>
            <div class="actionbar-right">
                @if (_legal.CanCheck) { <button class="act check" @onclick="() => Act(PlayerAction.Check())">CHECK</button> }
                @if (_legal.CanCall)  { <button class="act call" @onclick="() => Act(PlayerAction.Call())">CALL $@_legal.CallAmount</button> }
                @if (_legal.CanBet)   { <button class="act bet" @onclick="OpenSlider">BET</button> }
                @if (_legal.CanRaise) { <button class="act bet" @onclick="OpenSlider">RAISE</button> }
                @if (_legal.CanAllIn) { <button class="act allin" @onclick="() => Act(PlayerAction.AllIn())">ALL-IN</button> }
            </div>
        }
        else if (_awaitingHuman && _legal != null && _showSlider)
        {
            <div class="slider-panel">
                @* The thumb travels through a normalized scale. The displayed
                   amount is mapped logarithmically so small bets get much more
                   of the slider than they would on a linear $20-$4,000 range. *@
                <div class="slider-control">
                    <input type="range" min="0" max="@BetSliderSteps" step="1"
                           value="@_sliderPosition" aria-label="Bet amount"
                           aria-valuetext="$@_sliderValue"
                           @oninput="OnSliderInput"
                           @onpointerdown="BeginSliderInteraction"
                           @onpointerup="EndSliderInteraction"
                           @onpointercancel="EndSliderInteraction" />
                    <span class="slider-thumb-symbol" aria-hidden="true"
                          style="left: @SliderThumbPosition;"></span>
                    <span class="slider-tooltip @(_sliderInteracting ? "visible" : "")" role="tooltip"
                          style="left: @SliderThumbPosition;">$@_sliderValue</span>
                </div>
                <div class="slider-row">
                    <span class="slider-amount">$@_sliderValue</span>
                    <button class="act small" @onclick="() => SetSlider(PotNow / 2)">½ POT</button>
                    <button class="act small" @onclick="() => SetSlider(PotNow)">POT</button>
                    <button class="act small" @onclick="() => SetSlider(_legal.MaxBetOrRaiseTo)">MAX</button>
                    <button class="act call" @onclick="ConfirmSlider">CONFIRM</button>
                    <button class="act small" @onclick="CloseSlider">BACK</button>
                </div>
            </div>
        }
        else if (_game != null && !_sessionOver)
        {
            <div class="waiting">@_statusLine</div>
            @if (CanFastForward)
            {
                @if (!_awaitingNextHand)
                {
                    @* Folded and spectating, or the hand is settled and only
                       the result presentation is still playing: step through
                       the action one tap at a time, or jump straight to the
                       next hand. *@
                    <div class="actionbar-right">
                        <button class="act ff" @onclick="FastForward"
                                title="Skip to the next action">
                            SKIP »
                        </button>
                        <button class="act ff ff-next" @onclick="SkipToNextHand"
                                title="Fast-forward to the next hand">
                            NEXT HAND »
                        </button>
                    </div>
                }
                else
                {
                    <div class="actionbar-right">
                        @* Any result window covers this corner, so the coach
                           control moves into that window. *@
                        @if (CanReview && _banner == null)
                        {
                            <button class="act ff review-hand" @onclick="OpenCoachReview"
                                    title="Ask @CoachDisplayName what happened">
                                Poker Coach Feedback
                            </button>
                        }
                        <button class="act ff" @onclick="FastForward"
                                title="@NextHandButtonTitle">
                            @NextHandButtonLabel
                        </button>
                    </div>
                }
            }
        }
    </div>

    </div>

    @if (_sessionOver)
    {
        <div class="overlay @(_humanWon ? "win-celebration" : "")" role="dialog" aria-label="@_sessionOverMessage">
            @if (_humanWon)
            {
                @* Gold confetti and card suits rain for the full-table win.
                   Deterministic per-piece inline styles keep the CSS small. *@
                <div class="win-confetti" aria-hidden="true">
                    @for (int i = 0; i < ConfettiCount; i++)
                    {
                        @if (i % 3 == 0)
                        {
                            <span class="confetti-piece confetti-suit" style="@ConfettiSuitStyle(i)">@ConfettiSuits[(i / 3) % ConfettiSuits.Length]</span>
                        }
                        else
                        {
                            <span class="confetti-piece" style="@ConfettiStyle(i)"></span>
                        }
                    }
                </div>
            }
            <div class="overlay-box @(_humanLost ? "game-over" : _humanWon ? "table-win" : "")">
                @if (_humanWon)
                {
                    <div class="win-rays" aria-hidden="true"></div>
                    @* Dead man's hand — aces and eights, fanned like the pot
                       was just dragged. Pure flourish, hidden from readers. *@
                    <div class="win-cards" aria-hidden="true">
                        <span class="win-card"><b>A</b><i>♠</i></span>
                        <span class="win-card"><b>A</b><i>♣</i></span>
                        <span class="win-card red"><b>Q</b><i>♥</i></span>
                        <span class="win-card"><b>8</b><i>♠</i></span>
                        <span class="win-card"><b>8</b><i>♣</i></span>
                    </div>
                    <div class="win-eyebrow" aria-hidden="true"><span class="win-eyebrow-text">★ WINNER TAKES ALL ★</span></div>
                    <div class="overlay-title">@_sessionOverMessage</div>
                    <div class="win-haul">
                        <div class="win-haul-label">RIDES OFF WITH</div>
                        <div class="win-amount">$@_haulShown.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</div>
                    </div>
                    @if (_game != null)
                    {
                        <div class="win-stats">
                            <div class="win-stat">
                                <span class="win-stat-num">@_game.HandNumber</span>
                                <span class="win-stat-label">@(_game.HandNumber == 1 ? "HAND" : "HANDS")</span>
                            </div>
                            <div class="win-stat">
                                <span class="win-stat-num">@(_game.Players.Count - 1)</span>
                                <span class="win-stat-label">@(_game.Players.Count == 2 ? "RIVAL BUSTED" : "RIVALS BUSTED")</span>
                            </div>
                            @if (_biggestPotWon > 0)
                            {
                                <div class="win-stat">
                                    <span class="win-stat-num">$@_biggestPotWon.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="win-stat-label">BIGGEST POT</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="overlay-title">@_sessionOverMessage</div>
                }
                <div class="overlay-actions">
                    @if (_isGuest)
                    {
                        <button class="act call big" @onclick="DismissGuestOverlay">KEEP WATCHING</button>
                        <button class="act allin big restart-btn" @onclick="LeaveTable">LEAVE TABLE</button>
                    }
                    else if (_humanLost || _humanWon)
                    {
                        @if (_humanWon)
                        {
                            <button type="button" class="act victory-shot" disabled="@_shotBusy"
                                    @onclick="TakeVictoryScreenshot" @onclick:stopPropagation="true">
                                Export Certificate
                            </button>
                            @if (!string.IsNullOrEmpty(_shotStatus))
                            {
                                <div class="victory-shot-status">@_shotStatus</div>
                            }
                        }
                        @if (_humanWon)
                        {
                            <button class="act call big restart-btn" @onclick="ContinueGame">SIT NEW TABLE</button>
                        }
                        else
                        {
                            <button class="act allin big restart-btn" @onclick="StartSession">RESTART</button>
                        }
                        <button class="act small" @onclick="OpenExportPanel">EXPORT STATS</button>
                    }
                    else
                    {
                        <button class="act call big" @onclick="OpenExportPanel">EXPORT STATS</button>
                        <button class="act call big" @onclick="StartSession">PLAY AGAIN</button>
                    }
                </div>
            </div>
        </div>
    }

    @if (_settingsOpen)
    {
        <div class="overlay" @onclick="CloseSettings">
            <div class="overlay-box settings-box" @onclick:stopPropagation="true">
                <div class="overlay-title">SETTINGS</div>

                <div class="settings-name">
                    <label class="settings-label" for="settings-name-input">YOUR NAME</label>
                    <div class="settings-name-controls">
                        <input id="settings-name-input" class="name-input settings-name-input" type="text" maxlength="16"
                               autocapitalize="words" autocomplete="nickname" autocorrect="off" spellcheck="false"
                               placeholder="Your name" @bind="_settingsNameDraft" @bind:event="oninput"
                               @onkeydown="OnSettingsNameKeyDown" />
                        <button class="act call settings-save" disabled="@(!CanSaveSettingsName)" @onclick="SaveSettingsName">SAVE</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_settingsNameNote))
                    {
                        <p class="settings-note">@_settingsNameNote</p>
