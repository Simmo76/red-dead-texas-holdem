                        <button class="chip-btn sound-combo-btn @(AnyChannelOn ? "active" : "")" @onclick="ToggleSoundMenu">
                            @SoundSummary<span class="sound-caret">@(_soundMenuOpen ? "\u25b4" : "\u25be")</span>
                        </button>
                    </div>
