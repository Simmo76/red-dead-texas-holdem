<button type="button"
        class="toolbar-btn @(PillMode ? "toolbar-pill" : "") @CssClass @(Active ? "active" : "")"
        @onclick="HandleClick"
        aria-label="@EffectiveAriaLabel"
        aria-pressed="@(Toggle ? Active : (bool?)null)"
        title="@(Title ?? EffectiveAriaLabel)"
        disabled="@Disabled">
    @if (PillMode)
    {
        <img class="toolbar-pill-img"
             src="@PillSrc"
             srcset="@PillSrc2x"
             alt=""
             aria-hidden="true"
             loading="eager"
             decoding="async" />
    }
    else if (!string.IsNullOrEmpty(IconSrc))
    {
        <span class="toolbar-btn-icon" aria-hidden="true">
            <img class="toolbar-icon-img toolbar-icon-fallback" src="@($"{IconSrc}.png")" alt="" width="24" height="24" />
            <img class="toolbar-icon-img toolbar-icon-vector" src="@($"{IconSrc}.svg")" alt="" width="24" height="24" />
        </span>
    }
    @if (!PillMode && ShowLabel && !string.IsNullOrEmpty(Label))
    {
        <span class="toolbar-btn-label">@Label</span>
    }
</button>

@code {
    [Parameter] public string? IconSrc { get; set; }
    [Parameter] public string? PillSrc { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Toggle { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public EventCallback OnClick { get; set; }

    private bool PillMode => !string.IsNullOrEmpty(PillSrc);

    private string? PillSrc2x => PillMode && PillSrc!.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
        ? PillSrc[..^4] + "@2x.png 2x"
        : null;

    private string EffectiveAriaLabel => AriaLabel ?? Label ?? Title ?? "Action";

    private async Task HandleClick()
    {
        if (Disabled) return;
        await OnClick.InvokeAsync();
    }
}