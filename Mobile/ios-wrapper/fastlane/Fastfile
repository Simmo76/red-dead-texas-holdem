# TestFlight lane for the Capacitor iOS wrapper.
#
# Runs on CI (GitHub Actions macOS runner) with these environment variables:
#   APPLE_TEAM_ID          Apple Developer Team ID (e.g. AB12CD34EF)
#   ASC_KEY_ID             App Store Connect API key ID
#   ASC_ISSUER_ID          App Store Connect API issuer ID
#   ASC_KEY_P8_BASE64      The .p8 API key file, base64-encoded
#   DIST_CERT_P12_BASE64   OPTIONAL: Apple Distribution certificate + private
#                          key (.p12), base64-encoded. When absent, a fresh
#                          certificate is minted via the API (no Mac needed).
#   DIST_CERT_PASSWORD     OPTIONAL: password of the .p12
#
# The App Store Connect app record for com.deadmanshand.app must already
# exist (creating it registers the bundle id; the provisioning profile is
# then created/fetched automatically here).

default_platform(:ios)

APP_IDENTIFIER = "com.deadmanshand.app"

platform :ios do
  desc "Build the wrapper and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    # Temporary keychain for the runner, then a distribution identity:
    # either an uploaded .p12 (DIST_CERT_P12_BASE64 secret), or — when that
    # secret is absent — a fresh Apple Distribution certificate minted
    # through the App Store Connect API, so no Mac is ever needed.
    #
    # Minting first revokes previously minted distribution certificates,
    # because their private keys lived only on earlier (discarded) CI
    # runners and Apple caps how many distribution certificates a team can
    # hold. Revoking a distribution certificate does NOT affect builds
    # already uploaded to TestFlight or released on the App Store. If you
    # ever create a distribution certificate of your own on a Mac, switch
    # to the .p12 secrets so the pipeline stops revoking.
    setup_ci
    keychain_path = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    if ENV["DIST_CERT_P12_BASE64"].to_s.strip.empty?
      key_path = File.expand_path("asc_api_key.p8")
      File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        filepath: key_path,
        in_house: false
      )
      # Only revoke the modern "Apple Distribution" (DISTRIBUTION) type this
      # pipeline mints. Legacy IOS_DISTRIBUTION certificates (e.g. created by
      # Expo/EAS for other projects) are left untouched.
      Spaceship::ConnectAPI::Certificate.all.each do |c|
        next unless c.certificate_type == "DISTRIBUTION"
        UI.important("Revoking previously minted distribution certificate #{c.id}")
        c.delete!
      end
      cert(
        api_key: api_key,
        generate_apple_certs: true,
        keychain_path: keychain_path,
        keychain_password: ""
      )
    else
      cert_path = File.expand_path("dist_cert.p12")
      File.binwrite(cert_path, Base64.decode64(ENV.fetch("DIST_CERT_P12_BASE64")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
    end

    # Fetch (or create) the App Store provisioning profile for the bundle id.
    # A freshly minted certificate invalidates old profiles, so force a new
    # profile whenever this run minted its certificate.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      force: ENV["DIST_CERT_P12_BASE64"].to_s.strip.empty?
    )

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["App"]
    )

    # Monotonic build number so every upload is accepted by App Store Connect.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
